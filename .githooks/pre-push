#!/usr/bin/env bash
set -euo pipefail

if [[ "${KYTH_SKIP_PRE_PUSH_VALIDATION:-0}" == "1" ]]; then
	echo "[pre-push] Validation bypassed with KYTH_SKIP_PRE_PUSH_VALIDATION=1."
	exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

# Full CI mirror locally before push: validate.sh (lint, actionlint, zizmor,
# shell analysis, syntax/secrets/systemd, full test suite once, plain) plus
# run-quality.sh with coverage (ruff/BLE001 + second coverage-instrumented
# suite run and json/xml/html generation + coverage floors). This mirrors the
# parallel CI jobs (validate + quality + gui-smoke) in one local gate — ~17s
# extra for coverage — so fsresize/plan_commit-style floor regressions are
# caught before push instead of after.
if [[ "${KYTH_ALLOW_HEAVY_PRE_PUSH:-0}" == "1" ]]; then
	echo "[pre-push] Running FULL local validation (heavy, opt-in via KYTH_ALLOW_HEAVY_PRE_PUSH=1)..." 
else
	echo "[pre-push] Running fast validation (lint/syntax/coverage-fast only) — full suite is CI-gated." 
	echo "[pre-push] To force heavy locally: KYTH_ALLOW_HEAVY_PRE_PUSH=1 git push" 
fi
# Deprioritized (not paused) relative to the interactive session: this box is
# a live desktop, not a dedicated CI runner, and the old validate+coverage-
# twice pipeline pegging every core (plus, uncapped, every byte of RAM)
# alongside a running compositor/browser/IDE made the desktop unresponsive
# enough to force a hard power-off. cgroup CPU/IO weight only bites under
# actual contention — idle, this still runs at full speed; it only yields
# once something else needs the cycles. MemoryHigh/MemoryMax cap this run's
# own cgroup so a memory spike (the full test suite's Hub-smoke construction/
# teardown is already flagged as OOM-prone — see
# test_kyth_welcome_hub_smoke.py) gets reclaimed or OOM-killed inside this
# scope instead of taking down sibling cgroups like the desktop session's.
# Same properties as lib/desktop-throttle.sh (validate.sh/run-quality.sh use
# that directly; this hook wraps several separate commands below instead of
# re-exec'ing itself, so it builds its own array rather than sourcing it).
scope=()
if command -v systemd-run >/dev/null 2>&1; then
	# Array, not a string handed to `bash -c`: systemd-run performs its own
	# ${VAR}-style substitution on the literal command line it's given
	# (before bash ever sees it), so a positional-parameter string like
	# '${1}/foo' gets mangled ("Invalid environment variable name... 1").
	# Every word below is fully expanded by *this* shell first, so
	# systemd-run only ever receives concrete paths — no $ or ${} tokens
	# reach it at all.
	scope=(systemd-run --user --scope --collect --quiet -p CPUWeight=10 -p IOWeight=10 -p MemoryHigh=35% -p MemoryMax=55% --)
fi
if [[ "${KYTH_ALLOW_HEAVY_PRE_PUSH:-0}" == "1" ]]; then
	"${scope[@]}" "${repo_root}/build_files/scripts/validate.sh" --full
	"${scope[@]}" "${repo_root}/build_files/scripts/run-quality.sh"
else
	"${scope[@]}" "${repo_root}/build_files/scripts/validate.sh" --fast
	"${scope[@]}" "${repo_root}/build_files/scripts/run-quality.sh" --fast
fi

# P1-3: also catch System Hub regressions the CI gui-smoke job checks. Run
# the same canonical module CI runs (tests/test_kyth_welcome_hub_smoke.py)
# instead of a hand-rolled reimplementation that had drifted from it (stale
# page count, no search/lifecycle coverage, hardcoded bare PySide6 import
# that hard-fails on this host where only PyQt6 is installed system-wide).
if [[ "${KYTH_ALLOW_HEAVY_PRE_PUSH:-0}" == "1" ]]; then
	echo "[pre-push] Running Hub headless smoke (tests.test_kyth_welcome_hub_smoke)..."
	if [[ -x "${repo_root}/.venv-gui/bin/python" ]]; then
		gui_python="${repo_root}/.venv-gui/bin/python"
	else
		gui_python="python3"
	fi
	if ! "${gui_python}" -c "import PySide6" >/dev/null 2>&1; then
		echo "[pre-push] PySide6 not importable via ${gui_python} — Hub smoke would silently skip, not pass." >&2
		echo "[pre-push] Fix: python3 -m venv .venv-gui && .venv-gui/bin/pip install PySide6==6.11.1" >&2
		exit 1
	fi
	PYTHONPATH="build_files/kyth-welcome:build_files/kyth_shared" QT_QPA_PLATFORM=offscreen \
		KYTH_FORCE_HEAVY_GUI_SMOKE=1 \
		"${scope[@]}" "${gui_python}" -W error -m unittest tests.test_kyth_welcome_hub_smoke
	echo "[pre-push] Hub smoke passed"
else
	echo "[pre-push] Hub smoke SKIPPED (fast mode) — CI gui-smoke job gates it. Force with KYTH_ALLOW_HEAVY_PRE_PUSH=1"
fi
