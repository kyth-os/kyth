#!/usr/bin/env bash
set -euo pipefail

if [[ "${KYTH_SKIP_PRE_PUSH_VALIDATION:-0}" == "1" ]]; then
	echo "[pre-push] Validation bypassed with KYTH_SKIP_PRE_PUSH_VALIDATION=1."
	exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"

# Fast local gate, not a full CI mirror: validate.sh (lint, actionlint,
# zizmor, a shellcheck pass, syntax/secrets/systemd checks, and the full test
# suite run once, plain) plus run-quality.sh --fast (ruff/BLE001 only — skips
# the coverage-instrumented second full suite run and json/xml/html
# generation, which is pure local-only duplication since CI runs validate.sh
# and run-quality.sh as separate parallel jobs on separate runners; coverage
# floors are still enforced there on every push). Codacy preflight and the
# full CI-mirror double run are `just ci-preflight` if you want them locally —
# this hook no longer runs them automatically.
echo "[pre-push] Running fast local validation (full CI gate runs in parallel on push)..."
# Deprioritized (not paused) relative to the interactive session: this box is
# a live desktop, not a dedicated CI runner, and the old validate+coverage-
# twice pipeline pegging every core alongside a running compositor/browser/
# IDE made the desktop unresponsive enough to force a hard power-off. cgroup
# CPU/IO weight only bites under actual contention — idle, this still runs
# at full speed; it only yields once something else needs the cycles.
scope=()
if command -v systemd-run >/dev/null 2>&1; then
	# Array, not a string handed to `bash -c`: systemd-run performs its own
	# ${VAR}-style substitution on the literal command line it's given
	# (before bash ever sees it), so a positional-parameter string like
	# '${1}/foo' gets mangled ("Invalid environment variable name... 1").
	# Every word below is fully expanded by *this* shell first, so
	# systemd-run only ever receives concrete paths — no $ or ${} tokens
	# reach it at all.
	scope=(systemd-run --user --scope --collect --quiet -p CPUWeight=20 -p IOWeight=10 --)
fi
"${scope[@]}" "${repo_root}/build_files/scripts/validate.sh"
"${scope[@]}" "${repo_root}/build_files/scripts/run-quality.sh" --fast

# P1-3: also catch System Hub F821/QSS regressions that ci-preflight's ruff doesn't cover alone
echo "[pre-push] Running Hub headless smoke (MainWindow 20/20)..."
PYTHONPATH=build_files/kyth-welcome:build_files/kyth_shared QT_QPA_PLATFORM=offscreen python3 -c "
from PySide6.QtWidgets import QApplication
import sys
app = QApplication.instance() or QApplication(sys.argv)
from kyth_welcome.windows import MainWindow
w = MainWindow()
ok = 0
for k in list(w._page_index_by_key.keys()):
    try:
        w._ensure_page(w._page_index_by_key[k])
        w._navigate_to(k)
        ok += 1
    except Exception as e:
        print(f'[pre-push] Hub smoke FAIL {k}: {e}')
        sys.exit(1)
print(f'[pre-push] Hub smoke {ok}/20 OK')
app.quit()
" 2>&1 | grep -E "pre-push.*Hub smoke"
echo "[pre-push] Hub smoke passed"
