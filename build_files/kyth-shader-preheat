#!/usr/bin/env bash
# ── KythOS Zero-Stutter Shader Cache Preheat Engine ──────────────────────────
# Configures optimal Vulkan/Mesa shader cache parameters and pre-compiles
# pipeline state objects (PSOs) to eliminate in-game shader compilation stutter.
set -euo pipefail

log() {
	echo "[kyth-shader-preheat] $1"
}

user_home="${HOME}"
cache_dir="${user_home}/.cache/mesa_shader_cache"
env_dir="${user_home}/.config/environment.d"

mkdir -p "${cache_dir}" "${env_dir}"

log "Configuring system-wide zero-stutter Vulkan & Mesa shader cache environment..."

cat >"${env_dir}/kyth-shader-cache.conf" <<'EOF'
MESA_SHADER_CACHE_DIR=${HOME}/.cache/mesa_shader_cache
MESA_SHADER_CACHE_MAX_SIZE=32G
RADV_PERF=gpl
VKD3D_CONFIG=dxr11,dxr
EOF

log "Wrote environment settings to ${env_dir}/kyth-shader-cache.conf"

# Export for current session
export MESA_SHADER_CACHE_DIR="${cache_dir}"
export MESA_SHADER_CACHE_MAX_SIZE="32G"
export RADV_PERF="gpl"

log "Scanning for fossilize shader pipeline databases to pre-warm..."

fossilize_bins=()
if command -v fossilize_replay >/dev/null 2>&1; then
	fossilize_bins+=(fossilize_replay)
fi

search_paths=(
	"${user_home}/.local/share/Steam"
	"${user_home}/.var/app/com.valvesoftware.Steam"
	"${user_home}/Games"
)

fo_files=$(find "${search_paths[@]}" -name '*.fo' -type f 2>/dev/null || true)

if [[ -n "${fo_files}" && ${#fossilize_bins[@]} -gt 0 ]]; then
	log "Found Fossilize pipeline databases. Replaying pipelines to preheat Vulkan shader cache..."
	echo "${fo_files}" | while read -r fo; do
		log "  Pre-compiling: ${fo}"
		fossilize_replay --fo "${fo}" >/dev/null 2>&1 || true
	done
else
	log "No pending Fossilize pipeline databases found or fossilize_replay tool inactive."
	log "Mesa Graphics Pipeline Library (GPL) shader pipelines are active for all games."
fi

cache_size=$(du -sh "${cache_dir}" 2>/dev/null | awk '{print $1}' || echo "0B")
log "Shader cache preheat complete. Current Mesa cache size: ${cache_size}"
