#!/usr/bin/env python3
"""kyth-exe-compat — Dolphin xdg-open interceptor for .exe (offline compat check)."""
import shutil
import sys
from pathlib import Path
from kyth_shared.exe_compat import bottles_available, check_exe

# Bottles ships as a Flatpak (com.usebottles.bottles) — a bare `bottles-cli`
# only exists for native installs, so suggest the form that is actually
# present instead of one that fails with "command not found".
BOTTLES_FLATPAK_HINT = (
    "flatpak run --command=bottles-cli com.usebottles.bottles run <exe>"
)
def main():
    exe=sys.argv[1] if len(sys.argv)>1 else ""
    if not exe:
        print("Usage: kyth-exe-compat <exe>"); return 1
    r=check_exe(exe)
    print(f"{r['status']} via {r['runner']}: {r['reason']}")
    # Suggest a runner that is actually installed — never promise Bottles
    # when it is missing.
    if r["runner"]=="Bottles" or bottles_available():
        if shutil.which("bottles-cli") or shutil.which("bottles"):
            print("Run with: bottles-cli run <exe>  or  Lutris")
        else:
            print(f"Run with: {BOTTLES_FLATPAK_HINT}  or  Lutris")
    else:
        print("Install Bottles or Lutris to run this, or try: wine <exe>")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
