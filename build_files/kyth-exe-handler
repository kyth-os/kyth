#!/usr/bin/env python3
"""kyth-exe-handler — intercept Windows and RPM installers with KythOS guidance.

Registered as the default MIME handler for common Windows executable,
installer, and RPM package MIME types. Valid Windows installers can be prepared
and opened in an isolated Bottles environment, while the dialog keeps native
alternatives and known compatibility limitations visible.
"""

import sys
from kyth_shared.desktop.exe_handler import run_exe_handler


def main() -> None:
    sys.exit(run_exe_handler(sys.argv))


if __name__ == "__main__":
    main()
