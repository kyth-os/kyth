#!/usr/bin/env python3
"""kyth-verify-lock — offline `rpm -qa` vs rpm-lock.json (drift → quarantine)."""
import json, sys
from pathlib import Path
from kyth_shared.commands import run
def main():
    lock=Path("build_files/rpm-lock.json")
    try:
        expected=set(json.loads(lock.read_text())["rpms"])
    except Exception as e:
        print(f"kyth-verify-lock: no lock {e}", file=sys.stderr); return 0
    try:
        r=run(["rpm","-qa","--queryformat","%{NAME}-%{VERSION}-%{RELEASE}\n"], capture_output=True, text=True, timeout=10)
        actual=set(r.stdout.splitlines()) if r.returncode==0 else set()
    except Exception:
        actual=set()
    drift=expected.symmetric_difference(actual)
    if drift:
        print(f"kyth-verify-lock: drift {len(drift)}: {sorted(list(drift))[:5]}")
        return 2
    print("kyth-verify-lock: ok")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
