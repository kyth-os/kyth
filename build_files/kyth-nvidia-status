#!/usr/bin/env python3
"""Summarize NVIDIA readiness without changing the system."""
from __future__ import annotations

import re
import subprocess



from kyth_shared.diagnostics import DiagnosticReporter  # noqa: E402
from kyth_shared.system.gpu import (  # noqa: E402
    is_kernel_module_loaded,
    rpm_package_installed,
    run_lspci_nn,
)


def main() -> None:
    reporter = DiagnosticReporter("NVIDIA Status")
    reporter.print_header()

    if not reporter.have("lspci"):
        reporter.pass_check("NVIDIA hardware", "no NVIDIA GPU detected")
        print("\nResult: no NVIDIA-specific work needed.")
        return

    # Check for NVIDIA GPU
    nvidia_gpus = [line for line in run_lspci_nn() if "nvidia" in line.lower()]

    if not nvidia_gpus:
        reporter.pass_check("NVIDIA hardware", "no NVIDIA GPU detected")
        print("\nResult: no NVIDIA-specific work needed.")
        return

    gpu = nvidia_gpus[0].strip()
    reporter.pass_check("NVIDIA hardware", gpu)

    # Check akmod-nvidia package
    if rpm_package_installed("akmod-nvidia"):
        reporter.pass_check("akmod-nvidia", "installed")
    else:
        reporter.fail_check("akmod-nvidia", "missing from image")

    # Check modinfo
    modinfo_res = subprocess.run(["modinfo", "nvidia"], capture_output=True, check=False)
    if modinfo_res.returncode == 0:
        reporter.pass_check("Kernel module built", "modinfo nvidia works")
    else:
        reporter.warn_check("Kernel module built", "not built for current kernel yet")

    # Check if loaded
    if is_kernel_module_loaded("nvidia"):
        reporter.pass_check("Kernel module loaded", "nvidia loaded")
    else:
        reporter.warn_check("Kernel module loaded", "not loaded; reboot may be required after build")

    # Check hardware setup service
    if reporter.have("systemctl"):
        from kyth_shared.system.gpu import get_hardware_setup_service_status
        svc_state, svc_result = get_hardware_setup_service_status("kyth-hw-setup.service")
        combined = f"{svc_state}:{svc_result}"
        if svc_state in ("active", "activating"):
            reporter.warn_check("Hardware setup service", "building in background")
        elif combined in ("inactive:success", "failed:success"):
            reporter.pass_check("Hardware setup service", "completed")
        elif combined.startswith("failed:"):
            reporter.fail_check("Hardware setup service", "failed; run journalctl -u kyth-hw-setup")
        else:
            reporter.warn_check("Hardware setup service", f"{svc_state} {svc_result}")

    # Check nvidia-smi
    if reporter.have("nvidia-smi"):
        from kyth_shared.system.gpu import query_nvidia_smi
        smi = query_nvidia_smi()
        if smi:
            reporter.pass_check("nvidia-smi", smi)
        else:
            reporter.warn_check("nvidia-smi", "command failed or no GPU output")
    else:
        reporter.warn_check("nvidia-smi", "not available until proprietary driver is active")

    reporter.print_result("NVIDIA setup", "NVIDIA setup needs attention or a reboot.")


if __name__ == "__main__":
    main()
