#!/usr/bin/env bash
# kyth-isolate-game — podman seccomp + systemd scope isolation for games (offline, gaming.slice)
set -euo pipefail
app="${1:-}"
if [[ -z "$app" ]]; then echo "Usage: kyth-isolate-game <appid> -- <cmd>" >&2; exit 1; fi
shift
if [[ "${1:-}" == "--" ]]; then shift; fi
if [[ $# -eq 0 ]]; then echo "No command" >&2; exit 1; fi
# Run via systemd-run scope in gaming.slice with private tmp + seccomp filter
exec systemd-run --user --scope --slice=gaming.slice --property PrivateTmp=yes --property SystemCallFilter=@system-service -- "$@"
