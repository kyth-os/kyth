#!/usr/bin/env bash
# Make /boot writable and optionally promote a staged deployment.
#
# Kyth /boot is a read-only btrfs bind of the root subvol (plus autofs).
# `mount -o remount,rw` is EINVAL; `remount,bind,rw` works.
#
# Do not finalize from ostree-finalize-staged.service ExecStart: bootc still
# holds the sysroot write-lock, so finalize blocks until the 30–60 min upgrade
# timeout. ExecStart only prepares /boot. Finalize after `bootc upgrade`
# returns (kyth-safe-upgrade) and again on ExecStop as a shutdown fallback.
set -euo pipefail

_prepare_boot() {
	# bind,rw first: plain remount,rw is EINVAL on this layout.
	if ! mount -o remount,bind,rw /boot 2>/dev/null && ! mount -o remount,rw /boot 2>/dev/null; then
		echo "kyth-finalize-staged: could not remount /boot read-write" >&2
		return 1
	fi
	# ostree writes BLS through /sysroot/boot. If that path exists and is not
	# already a mount, bind the real /boot over it. Never remount /sysroot/boot
	# — it is often not a mount point ("mount point not mounted or bad option").
	if [[ -d /sysroot/boot ]] && ! findmnt -n /sysroot/boot >/dev/null 2>&1; then
		mount --bind /boot /sysroot/boot 2>/dev/null || true
	fi
	return 0
}

mode="${1:-}"
if [[ "${mode}" == "prepare-boot" ]]; then
	_prepare_boot
	exit $?
fi

if ! _prepare_boot; then
	echo "kyth-finalize-staged: trying finalize anyway" >&2
fi

/usr/bin/ostree admin finalize-staged
status=$?
if [[ "${mode}" == reboot && "${status}" -eq 0 ]]; then
	exec /usr/bin/systemctl reboot
fi
exit "${status}"
