#!/usr/bin/env bash
set -euo pipefail

NXM_URL="${1:-}"
if [[ -z "${NXM_URL}" ]]; then
    echo "Usage: kyth-nxm-handler nxm://..." >&2
    exit 1
fi

VORTEX_BOTTLE="${HOME}/.local/share/bottles/bottles/Vortex"
BOTTLES_FLATPAK_ID="com.usebottles.bottles"
# Bottles ships as a Flatpak: a bare `bottles-cli` only exists for native
# installs, so fall back to the flatpak run form (mirrors the native binary).
if [[ -d "${VORTEX_BOTTLE}" ]]; then
    if command -v bottles-cli >/dev/null 2>&1; then
        bottles-cli run -b Vortex -e "Vortex.exe" -- "${NXM_URL}"
        exit 0
    elif [[ -d "${HOME}/.local/share/flatpak/app/${BOTTLES_FLATPAK_ID}" || -d "/var/lib/flatpak/app/${BOTTLES_FLATPAK_ID}" ]]; then
        flatpak run --command=bottles-cli "${BOTTLES_FLATPAK_ID}" run -b Vortex -e "Vortex.exe" -- "${NXM_URL}"
        exit 0
    fi
fi

if command -v notify-send >/dev/null 2>&1; then
    notify-send "NXM Link" \
        "Install Vortex in Bottles to handle Nexus Mods download links automatically.\nLink: ${NXM_URL}" \
        --icon=application-x-addon
fi

echo "NXM link received: ${NXM_URL}"
echo "Install Vortex via Bottles to enable automatic mod downloads."
