[Unit]
Description=Keep KythOS /boot writable for ostree finalize
Documentation=file:///usr/share/doc/kyth/update-safety.md
DefaultDependencies=no
After=local-fs.target ostree-remount.service
Before=ostree-finalize-staged.service
RequiresMountsFor=/boot

[Service]
Type=oneshot
RemainAfterExit=yes
# remount,rw is EINVAL on the root-subvol bind; bind,rw is the working layout.
# '-' so a missing /boot mount cannot fail sysinit.
ExecStart=-/usr/libexec/kyth-finalize-staged prepare-boot
NoNewPrivileges=yes
ProtectSystem=strict
# /boot must stay writable (RequiresMountsFor above); allowlist it explicitly
# since ProtectSystem=strict would otherwise make it read-only.
ReadWritePaths=/boot

[Install]
WantedBy=sysinit.target
