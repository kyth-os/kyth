#!/bin/bash
# kyth-kwallet-pam-ensure — idempotent boot-time verification of the KWallet
# PAM bridge. The build-time script (26-kwallet-pam-bridge-...) wires
# pam_kwallet into the plasmalogin stack, but on bootc/ostree upgrades the
# /etc overlay can preserve a stale PAM file without the bridge. If the
# bridge is missing, the wallet never unlocks at login and the user gets
# prompted on every reboot. This runs on every boot; it does nothing when
# the bridge is already in place.
set -euo pipefail

# Resolve the module from the installed package; never hardcode it.
KWALLET_PAM_SO="$(rpm -ql pam-kwallet 2>/dev/null | grep -E '/pam_kwallet[^/]*\.so$' | sort -V | tail -n 1 || true)"
if [[ -z "${KWALLET_PAM_SO}" ]]; then
    # pam-kwallet not installed; nothing to wire.
    exit 0
fi
KWALLET_PAM_MODULE="$(basename "${KWALLET_PAM_SO}")"

for PAM_FILE in /etc/pam.d/plasmalogin /usr/lib/pam.d/plasmalogin; do
    [ -f "${PAM_FILE}" ] || continue

    # PAM's leading '-' only suppresses missing-module logging; these rules
    # still execute. Normalize stale overlays by keeping one KWallet auth/session
    # call and placing the relabel hook before the first active session call.
    tmp_file="$(mktemp)"
    if ! awk -v mod="${KWALLET_PAM_MODULE}" '
        function active(line, type) {
            return line ~ ("^[[:space:]]*-?" type "[[:space:]]+")
        }
        {
            if (index($0, "kyth-kwallet-relabel")) next
            if ((active($0, "auth") || active($0, "session")) && index($0, "pam_oo7")) {
                sub(/^[[:space:]]*/, "")
                print "# " $0 "  # kyth: KWallet is the single secrets provider"
                next
            }
            if (active($0, "auth") && index($0, mod)) {
                if (auth_seen++) next
            }
            if (active($0, "session") && index($0, mod) && index($0, "auto_start")) {
                if (session_seen++) next
                print "session  optional  pam_exec.so /usr/libexec/kyth-kwallet-relabel"
            }
            print
        }
        END {
            if (!auth_seen) print "auth     optional     " mod
            if (!session_seen) {
                print "session  optional  pam_exec.so /usr/libexec/kyth-kwallet-relabel"
                print "session  optional     " mod " auto_start"
            }
        }
    ' "${PAM_FILE}" >"${tmp_file}"; then
        rm -f -- "${tmp_file}"
        exit 1
    fi

    if ! cmp -s "${PAM_FILE}" "${tmp_file}"; then
        target_file="${PAM_FILE}"
        if [[ "${PAM_FILE}" == /usr/lib/pam.d/* ]]; then
            # /usr is immutable on bootc; repair a stale vendor stack via /etc.
            target_file="/etc/pam.d/${PAM_FILE##*/}"
            install -d -m 0755 /etc/pam.d
        fi
        target_tmp="$(mktemp "${target_file}.kyth.XXXXXX")"
        cp -- "${tmp_file}" "${target_tmp}"
        chmod --reference="${PAM_FILE}" "${target_tmp}"
        restorecon -F "${target_tmp}" >/dev/null 2>&1 || true
        mv -f -- "${target_tmp}" "${target_file}"
    fi
    rm -f -- "${tmp_file}"
    # Only the first existing file is the live one.
    break
done

exit 0
