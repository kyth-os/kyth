[Unit]
Description=Kyth AI performance daemon (SCX + sysctl + GPU, 30s TTL)
After=graphical-session.target
Wants=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/kyth-ai-perfd
Restart=on-failure
RestartSec=10
# User service — native Rust policy loop; privileged writes remain best-effort
# under the unit sandbox and are retried on the next TTL-bound cycle.
# Long-running background daemon alongside the desktop session — deprioritized
# so a bug/leak here degrades itself, not the interactive session it's meant
# to be tuning for (matches kyth-guardian.service's pattern).
Nice=10
IOSchedulingClass=idle
CPUQuota=15%
MemoryHigh=384M
MemoryMax=512M
PrivateTmp=yes
PrivateUsers=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
CacheDirectory=kyth
CacheDirectoryMode=0700

[Install]
WantedBy=graphical-session.target
