#!/usr/bin/env python3
"""kyth-apply-role-preset wrapper."""
import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.desktop.plasma import apply_role_preset  # noqa: E402


def main() -> None:
    profile = sys.argv[1] if len(sys.argv) > 1 else "everyday"
    if profile not in ("everyday", "gaming", "work", "both"):
        print("Usage: kyth-apply-role-preset [everyday|gaming]", file=sys.stderr)
        sys.exit(64)
    sys.exit(apply_role_preset(profile))


if __name__ == "__main__":
    main()
