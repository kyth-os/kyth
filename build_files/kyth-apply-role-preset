#!/usr/bin/env python3
"""kyth-apply-role-preset wrapper."""
import sys



from kyth_shared.desktop.plasma import apply_role_preset as _apply_layout  # noqa: E402
from kyth_shared.preset import apply_preset as _apply_preset  # noqa: E402


def main() -> None:
    profile = sys.argv[1] if len(sys.argv) > 1 else "everyday"
    # Support legacy aliases
    if profile in ("work", "both"):
        profile = "everyday"
    if profile not in ("everyday", "gaming", "dev", "creator"):
        print("Usage: kyth-apply-role-preset [everyday|gaming|dev|creator]", file=sys.stderr)
        sys.exit(64)
    # Layout (kickoff favorites) — idempotent, always safe
    layout_rc = _apply_layout(profile if profile in ("everyday", "gaming") else "everyday")
    # Declarative home — flatpaks/distroboxes/vscode via preset.toml (idempotent)
    try:
        _apply_preset(profile)
    except SystemExit:
        raise
    except Exception as exc:
        print(f"preset apply warning: {exc}", file=sys.stderr)
    sys.exit(layout_rc)


if __name__ == "__main__":
    main()
