#!/usr/bin/env python3
"""kyth-session-snapshot — Collect environment diagnostics, configurations, and write a session snapshot file."""
from __future__ import annotations

import sys
from pathlib import Path



from kyth_shared.session import generate_session_snapshot  # noqa: E402


def main() -> None:
    out_dir = Path(sys.argv[1]) if len(sys.argv) > 1 else None
    snapshot_path = generate_session_snapshot(out_dir)
    print(snapshot_path)


if __name__ == "__main__":
    main()
