#!/usr/bin/env python3
"""
kyth-update-watcher — intelligent bootc update scheduler for KythOS.

Runs as a system service (root), invoked periodically by a systemd timer.
Checks a set of safety conditions before staging a bootc upgrade so that
updates never interrupt gaming, never saturate a metered connection, and
never fire during user-configured quiet hours.

Config:  /etc/kyth/auto-update.toml
Status:  /var/lib/kyth/update-watcher-status.json  (read by System Hub)

Design: oneshot script — examine conditions, run or skip, write status, exit.
"""
from __future__ import annotations

import logging
import os
import pwd
import subprocess
import sys
import threading
import time
import tomllib
from datetime import datetime, time as dtime
from pathlib import Path



from kyth_shared.system.bootc import (  # noqa: E402
    fetch_bootc_status_data_uncached,
    image_digest_from_status,
    image_reference_from_status,
)
from kyth_shared.system.registry import (  # noqa: E402
    remote_digest_for_ref,
)
from kyth_shared.update_status import (  # noqa: E402
    UpdateSnapshot,
    read_update_snapshot,
    write_update_snapshot,
)
from kyth_shared.gaming import check_gaming_reason  # noqa: E402
from kyth_shared.daemon import BaseDaemon  # noqa: E402
from kyth_shared.runtime_output import count_fwupd_updates  # noqa: E402
from kyth_shared.boot_health import (  # noqa: E402
    DEFAULT_STATE_PATH as BOOT_HEALTH_PATH,
    image_ring,
    quarantine_reason,
    read_state as read_boot_health_state,
    record_staged,
    rollout_policy_reason,
    write_state as write_boot_health_state,
)

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

LOG = logging.getLogger("kyth-update-watcher")

STATUS_PATH = Path("/var/lib/kyth/update-watcher-status.json")
_STATUS_IDENTITY: dict[str, str] = {}

DEFAULT_CONFIG: dict = {
    "enabled":            True,
    "rollout_ring":       "follow-image",
    "quiet_hours_start":  "02:00",  # 24-h local time
    "quiet_hours_end":    "07:00",
    "skip_if_metered":    True,
    "skip_if_gaming":     True,
    "startup_grace_minutes": 20,
    "bootc_timeout":      1800,     # seconds; a full OCI pull can take a while
}

SKIP_REASONS = []





# ---------------------------------------------------------------------------
# Safety checks
# ---------------------------------------------------------------------------

def check_enabled(cfg: dict) -> str | None:
    if not cfg.get("enabled", True):
        return "auto-update disabled in config"
    return None


def check_quiet_hours(cfg: dict) -> str | None:
    start_str = cfg.get("quiet_hours_start", "02:00")
    end_str   = cfg.get("quiet_hours_end",   "07:00")
    try:
        h, m = map(int, start_str.split(":"))
        start = dtime(h, m)
        h, m = map(int, end_str.split(":"))
        end = dtime(h, m)
    except (ValueError, AttributeError):
        return None

    now = datetime.now().time().replace(second=0, microsecond=0)
    if start <= end:
        in_quiet = start <= now < end
    else:  # wraps midnight
        in_quiet = now >= start or now < end

    if in_quiet:
        return f"quiet hours ({start_str}–{end_str})"
    return None


def check_startup_grace(cfg: dict) -> str | None:
    try:
        grace_minutes = int(cfg.get("startup_grace_minutes", 20))
    except (TypeError, ValueError):
        return None
    if grace_minutes <= 0:
        return None

    try:
        uptime_seconds = float(Path("/proc/uptime").read_text().split()[0])
    except Exception:
        return None

    grace_seconds = grace_minutes * 60
    if uptime_seconds < grace_seconds:
        remaining = max(1, int((grace_seconds - uptime_seconds + 59) // 60))
        return f"startup grace period ({remaining} min remaining)"
    return None


def _active_uids() -> list[int]:
    """Return UIDs with active systemd user sessions."""
    try:
        r = subprocess.run(
            ["loginctl", "list-sessions", "--no-legend", "--no-pager"],
            capture_output=True, text=True, timeout=5,
        )
        uids: list[int] = []
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 3:
                try:
                    uids.append(int(parts[2]))
                except ValueError:
                    pass
        return list(set(uids))
    except Exception:
        return []


def check_gaming(cfg: dict) -> str | None:
    if not cfg.get("skip_if_gaming", True):
        return None
    return check_gaming_reason(check_all_uids=True)


def check_metered(cfg: dict) -> str | None:
    if not cfg.get("skip_if_metered", True):
        return None
    try:
        r = subprocess.run(
            ["busctl", "get-property",
             "org.freedesktop.NetworkManager",
             "/org/freedesktop/NetworkManager",
             "org.freedesktop.NetworkManager",
             "Metered"],
            capture_output=True, text=True, timeout=5,
        )
        # NetworkManager NMMetered:
        # 0 unknown, 1 yes, 2 no, 3 guessed yes, 4 guessed no.
        if r.returncode == 0:
            val = r.stdout.strip().split()[-1]
            if val in ("1", "3"):
                return "network connection is metered"
    except Exception:
        pass
    return None


# ---------------------------------------------------------------------------
# User notifications
# ---------------------------------------------------------------------------

def check_flatpak_updates() -> int:
    """Return count of pending system-wide Flatpak updates, 0 on error."""
    try:
        r = subprocess.run(
            ["flatpak", "remote-ls", "--updates", "--system", "--columns=application"],
            capture_output=True, text=True, timeout=60, check=False,
        )
        return len([ln for ln in r.stdout.splitlines() if ln.strip()])
    except Exception:
        return 0


def run_firmware_refresh(timeout: int = 60) -> tuple[bool, str]:
    """Refresh fwupd metadata. Returns (ok, output). Optional — failures are non-fatal."""
    try:
        r = subprocess.run(
            ["fwupdmgr", "refresh", "--force"],
            capture_output=True, text=True, timeout=timeout, check=False,
        )
        output = (r.stdout + r.stderr).strip()
        return r.returncode == 0, output
    except subprocess.TimeoutExpired:
        return False, f"fwupdmgr refresh timed out after {timeout}s"
    except FileNotFoundError:
        return False, "fwupdmgr not found"
    except Exception as exc:
        return False, str(exc)


def check_firmware_updates(timeout: int = 20) -> int:
    """Return count of pending fwupd device updates, 0 on error or none."""
    try:
        r = subprocess.run(
            ["fwupdmgr", "get-updates"],
            capture_output=True, text=True, timeout=timeout, check=False,
        )
        # fwupdmgr exit 2 or empty stdout means no updates
        if r.returncode == 2 or not r.stdout.strip():
            return 0
        if r.returncode != 0:
            return 0
        return count_fwupd_updates(r.stdout)
    except FileNotFoundError:
        return 0
    except Exception:
        return 0


def run_firmware_update(timeout: int = 600) -> tuple[bool, str]:
    """Stage available fwupd updates. Returns (ok, output)."""
    try:
        r = subprocess.run(
            ["fwupdmgr", "update", "--assume-yes", "--no-reboot-check"],
            capture_output=True, text=True, timeout=timeout, check=False,
        )
        output = (r.stdout + r.stderr).strip()
        return r.returncode == 0, output
    except subprocess.TimeoutExpired:
        return False, f"fwupdmgr update timed out after {timeout}s"
    except FileNotFoundError:
        return False, "fwupdmgr not found"
    except Exception as exc:
        return False, str(exc)


def _notify_updates(os_staged: bool, flatpak_count: int) -> None:
    """Send an actionable desktop notification to each logged-in user.

    Clicking the notification opens System Hub on the Updates page.
    """
    if os_staged and flatpak_count > 0:
        title = "KythOS update ready"
        noun = "update" if flatpak_count == 1 else "updates"
        body = f"New OS image staged · {flatpak_count} Flatpak {noun} pending. Click to open System Hub."
    elif os_staged:
        title = "KythOS update ready"
        body = "New OS image staged. Restart when you are ready to apply it. Click to open System Hub."
    else:
        title = "App updates available"
        noun = "update is" if flatpak_count == 1 else "updates are"
        body = f"{flatpak_count} Flatpak app {noun} available. Click to open System Hub."

    threads: list[threading.Thread] = []
    for uid in _active_uids():
        try:
            pw = pwd.getpwuid(uid)
        except KeyError:
            continue
        env = {
            "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{uid}/bus",
            "XDG_RUNTIME_DIR": f"/run/user/{uid}",
            "HOME": pw.pw_dir,
            "USER": pw.pw_name,
            "LOGNAME": pw.pw_name,
            "PATH": "/usr/bin:/bin",
        }

        def _drop_privs(uid: int = uid, gid: int = pw.pw_gid) -> None:
            os.setgroups([])
            os.setgid(gid)
            os.setuid(uid)

        def _notify_user(env: dict = env, drop: object = _drop_privs) -> None:
            try:
                r = subprocess.run(
                    [
                        "notify-send",
                        "--app-name=KythOS",
                        "--icon=software-update-available",
                        "--urgency=normal",
                        "--action=default=View Updates",
                        "--wait",
                        title,
                        body,
                    ],
                    env=env,
                    capture_output=True, text=True,
                    preexec_fn=drop,
                    timeout=65,
                )
                if r.stdout.strip() == "default":
                    subprocess.Popen(
                        ["kyth-welcome", "--page", "updates"],
                        env=env,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        preexec_fn=drop,
                    )
            except Exception as exc:
                LOG.debug("Could not notify uid: %s", exc)

        t = threading.Thread(target=_notify_user, daemon=True)
        t.start()
        threads.append(t)

    deadline = time.monotonic() + 70
    for t in threads:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        t.join(timeout=remaining)


# ---------------------------------------------------------------------------
# Update
# ---------------------------------------------------------------------------

def run_bootc_upgrade(timeout: int) -> tuple[bool, str]:
    try:
        r = subprocess.run(
            ["bootc", "upgrade"],
            capture_output=True, text=True,
            timeout=timeout, check=False,
        )
        output = (r.stdout + r.stderr).strip()
        return r.returncode == 0, output
    except subprocess.TimeoutExpired:
        return False, f"bootc upgrade timed out after {timeout}s"
    except FileNotFoundError:
        return False, "bootc not found"


def get_bootc_status() -> dict | None:
    """Return bootc status JSON, uncached (root timer path)."""
    try:
        return fetch_bootc_status_data_uncached()
    except Exception as exc:
        LOG.warning("Could not get bootc status: %s", exc)
        return None


def get_bootc_image_reference(status_data: dict) -> str | None:
    """Compat wrapper around shared bootc.image_reference_from_status."""
    return image_reference_from_status(status_data)


def get_remote_digest(ref: str) -> str | None:
    """Compat wrapper around shared registry.remote_digest_for_ref."""
    digest = remote_digest_for_ref(ref)
    if digest is None:
        LOG.warning("Could not check remote digest for %s", ref)
    return digest


# ---------------------------------------------------------------------------
# Status
# ---------------------------------------------------------------------------

def write_status(
    result: str,
    reason: str | None,
    output: str = "",
    ts: int | None = None,
    flatpak_updates: int = 0,
) -> None:
    try:
        write_update_snapshot(
            UpdateSnapshot(
                result=result,
                reason=reason,
                output=output[-2000:],
                ts=ts or int(time.time()),
                flatpak_updates=flatpak_updates,
                image_ref=_STATUS_IDENTITY.get("image_ref", ""),
                booted_digest=_STATUS_IDENTITY.get("booted_digest", ""),
                staged_digest=_STATUS_IDENTITY.get("staged_digest", ""),
                remote_digest=_STATUS_IDENTITY.get("remote_digest", ""),
            ),
            STATUS_PATH,
        )
    except OSError as exc:
        LOG.warning("Could not write status: %s", exc)


def read_last_status() -> dict:
    snapshot = read_update_snapshot(STATUS_PATH)
    return snapshot.to_dict() if snapshot else {}


class UpdateWatcherDaemon(BaseDaemon):
    def __init__(self) -> None:
        super().__init__(
            "kyth-update-watcher",
            config_filename="auto-update.toml",
            config_section="auto_update",
            default_config=DEFAULT_CONFIG,
            oneshot=True,
        )

    def on_start(self) -> None:
        if os.geteuid() != 0:
            self.logger.error("kyth-update-watcher must run as root")
            self._exit_code = 1
            self.running = False
            return

        _STATUS_IDENTITY.clear()

    def poll(self) -> None:
        if self._exit_code != 0:
            return

        checks = [
            check_enabled,
            check_startup_grace,
            check_quiet_hours,
            check_gaming,
            check_metered,
        ]

        for check in checks:
            reason = check(self.config)
            if reason:
                self.logger.info("Skipping update: %s", reason)
                write_status("skipped", reason)
                return

        self.logger.info("All checks passed — checking remote registry digest")
        start_ts = int(time.time())
        flatpak_count = check_flatpak_updates()
        self.logger.info("Flatpak updates pending: %d", flatpak_count)

        # ── Firmware updates (optional, ensures latest device firmware) ───────
        # Mirrors kyth-full-update's optional firmware steps but runs
        # automatically every watcher cycle. Failures are logged, not fatal —
        # bootc/flatpak work proceeds even if fwupd is absent or offline.
        firmware_updated = False
        firmware_output = ""
        try:
            ok, out = run_firmware_refresh()
            if not ok:
                self.logger.debug("fwupd refresh: %s", out[:300])
            else:
                self.logger.info("fwupd refresh succeeded")
            fw_count = check_firmware_updates()
            self.logger.info("Firmware updates pending: %d", fw_count)
            if fw_count > 0:
                self.logger.info("Staging %d firmware update(s) via fwupdmgr", fw_count)
                ok, out = run_firmware_update()
                firmware_output = out
                if ok:
                    self.logger.info("Firmware updates queued: %s", out[:500])
                    firmware_updated = True
                else:
                    self.logger.warning("fwupd update failed: %s", out[:500])
            else:
                self.logger.info("No firmware updates to stage")
        except Exception as exc:
            self.logger.debug("Firmware update probe failed: %s", exc)

        # Check digests before downloading (shared bootc + registry helpers)
        status_data = get_bootc_status()
        if status_data:
            try:
                from kyth_shared.system.probe import update_sections
                update_sections({"bootc-status-data": status_data}, system=True)
            except Exception as exc:
                self.logger.debug("Could not warm system probe cache: %s", exc)
        if status_data:
            ref = get_bootc_image_reference(status_data)
            if ref:
                booted_digest = image_digest_from_status(status_data, "booted")
                staged_digest = image_digest_from_status(status_data, "staged")
                _STATUS_IDENTITY.update(
                    image_ref=ref,
                    booted_digest=booted_digest or "",
                    staged_digest=staged_digest or "",
                )

                configured_ring = str(self.config.get("rollout_ring", "follow-image"))
                ring_reason = rollout_policy_reason(ref, configured_ring)
                if ring_reason:
                    self.logger.warning("Skipping update: %s", ring_reason)
                    write_status("skipped", ring_reason, firmware_output, start_ts, flatpak_count)
                    return

                self.logger.info("Booted digest: %s, Staged digest: %s", booted_digest, staged_digest)

                remote_digest = get_remote_digest(ref)
                if remote_digest:
                    _STATUS_IDENTITY["remote_digest"] = remote_digest
                    self.logger.info("Remote registry digest: %s", remote_digest)
                    quarantined = quarantine_reason(
                        read_boot_health_state(BOOT_HEALTH_PATH), remote_digest
                    )
                    if quarantined:
                        self.logger.warning("Skipping quarantined update: %s", quarantined)
                        write_status("quarantined", quarantined, firmware_output, start_ts, flatpak_count)
                        return
                    if staged_digest and remote_digest == staged_digest:
                        self.logger.info("System already has staged update matching latest remote digest. Skipping bootc upgrade.")
                        # Firmware still staged automatically — report as upgrade if firmware queued
                        combined = firmware_output if firmware_output else ""
                        if firmware_updated:
                            write_status("upgraded", None, combined or "Firmware updates queued — reboot to flash.", start_ts, flatpak_count)
                            _notify_updates(os_staged=True, flatpak_count=flatpak_count)
                        else:
                            write_status("no_change", "Update already staged and matches latest registry version", combined, start_ts, flatpak_count)
                            _notify_updates(os_staged=True, flatpak_count=flatpak_count)
                        return
                    elif not staged_digest and booted_digest and remote_digest == booted_digest:
                        self.logger.info("System is already up to date (booted digest matches remote). Skipping bootc upgrade.")
                        combined = firmware_output if firmware_output else "Already up to date"
                        if firmware_updated:
                            write_status("upgraded", None, combined, start_ts, flatpak_count)
                            _notify_updates(os_staged=True, flatpak_count=flatpak_count)
                        else:
                            write_status("no_change", None, combined, start_ts, flatpak_count)
                            if flatpak_count > 0:
                                _notify_updates(os_staged=False, flatpak_count=flatpak_count)
                        return

        self.logger.info("Proceeding to run bootc upgrade")
        ok, output = run_bootc_upgrade(self.config["bootc_timeout"])

        if ok:
            if "No update available" in output or "already up to date" in output.lower():
                self.logger.info("System already up to date")
                combined = "\n".join(x for x in [output, firmware_output] if x) or output
                if firmware_updated:
                    write_status("upgraded", None, combined, start_ts, flatpak_count)
                    _notify_updates(os_staged=True, flatpak_count=flatpak_count)
                else:
                    write_status("no_change", None, combined, start_ts, flatpak_count)
                    if flatpak_count > 0:
                        _notify_updates(os_staged=False, flatpak_count=flatpak_count)
            else:
                self.logger.info("Upgrade staged successfully")
                if _STATUS_IDENTITY.get("remote_digest"):
                    _STATUS_IDENTITY["staged_digest"] = _STATUS_IDENTITY["remote_digest"]
                    try:
                        health = read_boot_health_state(BOOT_HEALTH_PATH)
                        ring = image_ring(_STATUS_IDENTITY.get("image_ref", "")) or str(
                            self.config.get("rollout_ring", "follow-image")
                        )
                        write_boot_health_state(
                            record_staged(
                                health,
                                _STATUS_IDENTITY["remote_digest"],
                                rollout_ring=ring,
                            ),
                            BOOT_HEALTH_PATH,
                        )
                    except OSError as exc:
                        self.logger.warning("Could not record staged digest: %s", exc)
                combined = "\n".join(x for x in [output, firmware_output] if x) or output
                write_status("upgraded", None, combined, start_ts, flatpak_count)
                _notify_updates(os_staged=True, flatpak_count=flatpak_count)
                try:
                    from kyth_shared.system.probe import invalidate_after_bootc_change, refresh_cache
                    invalidate_after_bootc_change()
                    refresh_cache(system=True)
                except Exception as exc:
                    self.logger.debug("probe refresh after upgrade failed: %s", exc)
        else:
            self.logger.error("bootc upgrade failed: %s", output[:500])
            combined = "\n".join(x for x in [output, firmware_output] if x) or output
            write_status("error", output[:500], combined, start_ts, flatpak_count)
            self._exit_code = 1


def main() -> None:
    daemon = UpdateWatcherDaemon()
    sys.exit(daemon.run())


if __name__ == "__main__":
    main()
