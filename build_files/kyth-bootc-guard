#!/usr/bin/env bash
# KythOS passwordless bootc gateway.
#
# Only fixed release channels are exposed here. Arbitrary rebases deliberately
# continue to invoke bootc directly and therefore require normal authentication.
set -euo pipefail

[[ $# -eq 1 ]] || {
    echo "Usage: kyth-bootc-guard <status|status-json|switch-latest|switch-testing|switch-latest-cachy|switch-testing-cachy>" >&2
    exit 2
}

# Kyth /boot is a read-only btrfs bind of the root subvol. bootc 1.16+ takes a
# sysroot write-lock even for `status` and opens the sysroot-relative `boot`
# directory; that returns EPERM ("Status: opendir(boot): Operation not
# permitted") until the bind is remounted rw and, when present, /sysroot/boot
# is bound to the real /boot.
_prepare_boot() {
	if [[ -x /usr/libexec/kyth-finalize-staged ]]; then
		/usr/libexec/kyth-finalize-staged prepare-boot >/dev/null 2>&1 || return $?
		return 0
	fi
	mount -o remount,bind,rw /boot 2>/dev/null || mount -o remount,rw /boot 2>/dev/null || true
	if [[ -d /sysroot/boot ]] && ! findmnt -n /sysroot/boot >/dev/null 2>&1; then
		mount --bind /boot /sysroot/boot 2>/dev/null || true
	fi
	# Prove /boot is actually writable: a silent failed remount would
	# otherwise let `bootc switch` run against an unprepared /boot.
	if ! touch /boot/.kyth-prep-write 2>/dev/null; then
		echo "kyth-bootc-guard: /boot is not writable after prepare-boot; refusing to continue." >&2
		return 1
	fi
	rm -f /boot/.kyth-prep-write
	return 0
}

_bootc_status() {
	local extra=()
	if [[ "${1:-}" == json ]]; then
		extra+=(--json)
	fi
	_prepare_boot || true
	if /usr/bin/bootc status "${extra[@]}"; then
		return 0
	fi
	local rc=$?
	if [[ "${1:-}" == json ]]; then
		echo "kyth-bootc-guard: bootc status failed (often opendir(boot) EPERM on the /boot bind). Try: sudo kyth-finalize-staged prepare-boot" >&2
		return "${rc}"
	fi
	# Degraded human diagnostic only: this is rpm-ostree's schema, NOT
	# bootc's. Exit with bootc's code so no script can mistake it for a
	# successful bootc status.
	echo "kyth-bootc-guard: bootc status could not open /boot; showing rpm-ostree status." >&2
	/usr/bin/rpm-ostree status
	return "${rc}"
}

case "$1" in
    status)
        _bootc_status
        exit $?
        ;;
    status-json)
        _bootc_status json
        exit $?
        ;;
    switch-latest)
        ref="ghcr.io/kyth-os/kyth:latest"
        ;;
    switch-testing)
        ref="ghcr.io/kyth-os/kyth:testing"
        ;;
    switch-latest-cachy)
        ref="ghcr.io/kyth-os/kyth:latest-cachy"
        ;;
    switch-testing-cachy)
        ref="ghcr.io/kyth-os/kyth:testing-cachy"
        ;;
    *)
        echo "kyth-bootc-guard: unsupported operation: $1" >&2
        exit 2
        ;;
esac

_prepare_boot || {
	echo "kyth-bootc-guard: cannot prepare /boot for switch; aborting before touching deployments." >&2
	exit 1
}
/usr/bin/bootc switch "${ref}"
if [[ -x /usr/libexec/kyth-finalize-staged ]]; then
	exec /usr/libexec/kyth-finalize-staged
fi
mount -o remount,bind,rw /boot 2>/dev/null || true
exec /usr/bin/ostree admin finalize-staged
