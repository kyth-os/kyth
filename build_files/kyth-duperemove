#!/usr/bin/env python3
"""KythOS Deduplication Utility."""
from __future__ import annotations

import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.maintenance import dedupe_directory, find_dedupe_targets, supports_dedupe  # noqa: E402


def log(msg: str) -> None:
    print(f"kyth-duperemove: {msg}")


def main() -> None:
    targets = find_dedupe_targets()
    if not targets:
        log("no Steam compatdata/shadercache directories found")
        sys.exit(0)

    for target in targets:
        if not supports_dedupe(target):
            log(f"skipping unsupported filesystem for {target}")
            continue

        log(f"deduping {target}")
        dedupe_directory(target)


if __name__ == "__main__":
    main()
