#!/usr/bin/env python3
"""kyth-apply-input — apply input.toml → xorg.conf.d hwdb (offline)."""
from kyth_shared.input_preset import load_input
from pathlib import Path
def main():
    devs=load_input()
    dest=Path("/etc/X11/xorg.conf.d/50-kyth-input.conf")
    dest.parent.mkdir(parents=True, exist_ok=True)
    lines=['Section "InputClass"',' Identifier "kyth-input"',' MatchIsPointer "on"']
    for dev, e in devs.items():
        lines.append(f' # {dev} accel {e["accel_profile"]} speed {e["accel_speed"]}')
    lines.append('EndSection')
    tmp=dest.with_suffix(".tmp"); tmp.write_text("\n".join(lines)+"\n", encoding="utf-8"); tmp.replace(dest)
    try:
        import time; Path("/run/kyth-input-ttl").write_text(str(int(time.time())+30), encoding="utf-8")
    except Exception:
        pass
    print(f"kyth-apply-input: {len(devs)} devices → {dest}")
    return 0
if __name__=="__main__":
    import sys; sys.exit(main())
