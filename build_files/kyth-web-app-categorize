#!/usr/bin/env python3
"""Automatically categorize Web App launchers under ~/.local/share/applications."""
from __future__ import annotations

import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    here = Path(__file__).resolve().parent
    candidate = here / "kyth_shared"
    if (candidate / "kyth_shared").is_dir():
        path = str(candidate)
        if path not in sys.path:
            sys.path.insert(0, path)


_ensure_kyth_shared_path()
from kyth_shared.desktop.shortcut import categorize_web_apps  # noqa: E402


def main() -> None:
    categorize_web_apps()


if __name__ == "__main__":
    main()
