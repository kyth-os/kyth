[Unit]
Description=KythOS MangoHud frame-time telemetry collector
Documentation=https://github.com/mrtrick37/kyth
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/kyth-telem
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kyth-telem

KillSignal=SIGTERM
TimeoutStopSec=5

# Runs alongside whatever the user is doing, often a game — a frame-time
# collector must never compete with the thing it's measuring for cycles.
Nice=15
IOSchedulingClass=idle
CPUQuota=15%
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=graphical-session.target
