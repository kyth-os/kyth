#!/usr/bin/env python3
"""kyth-set-kickoff-icon — brand the Kickoff applet icon and quiet its new-apps highlight."""
from __future__ import annotations

import os
import re



from kyth_shared.desktop.plasma import kwriteconfig  # noqa: E402


def main() -> None:
    aprc = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")
    autostart = os.path.expanduser("~/.config/autostart/kyth-set-kickoff-icon.desktop")

    kwriteconfig("kickoffrc", "General", "highlightNewlyInstalledApps", "false", "bool")

    if os.path.exists(aprc):
        content = open(aprc).read()
        for m in re.finditer(
            r"^\[Containments\]\[(\d+)\]\[Applets\]\[(\d+)\]",
            content, re.MULTILINE
        ):
            cont, applet = m.group(1), m.group(2)
            body_start = m.end()
            nxt = re.search(r"^\[", content[body_start:], re.MULTILINE)
            body = content[body_start: body_start + nxt.start()] if nxt else content[body_start:]
            if "plugin=org.kde.plasma.kickoff" in body:
                groups = ["Containments", cont, "Applets", applet, "Configuration", "General"]
                kwriteconfig(aprc, groups, "icon", "kyth-kickoff")
                kwriteconfig(aprc, groups, "highlightNewlyInstalledApps", "false", "bool")

    try:
        os.unlink(autostart)
    except OSError:
        pass


if __name__ == "__main__":
    main()
