[Unit]
Description=Kyth RGB per-device (openrgb/liquidctl)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-apply-rgb
RemainAfterExit=yes
TimeoutStartSec=30
Nice=10
IOSchedulingClass=idle
MemoryMax=384M

MemoryMax=256M

[Install]
WantedBy=graphical-session.target
