[Unit]
Description=Kyth RGB per-device (openrgb/liquidctl)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-apply-rgb
RemainAfterExit=yes
TimeoutStartSec=30
# Sandboxing: user-context RGB control (openrgb/liquidctl). Needs USB device
# access; no network, no privilege escalation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=384M

[Install]
WantedBy=graphical-session.target
