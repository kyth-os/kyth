#!/usr/bin/env python3
"""kyth-save-sync — restic local repo for saves + rclone remote if network.toml dns!=off."""
import sys
from pathlib import Path
from kyth_shared.save_cloud import load_save_cloud
from kyth_shared.commands import run
def main():
    cfg=load_save_cloud()
    repo=Path(cfg["repo"])
    repo.mkdir(parents=True, exist_ok=True)
    # restic init if not exists
    if not (repo / "config").exists():
        run(["restic","init","--repo", str(repo)], capture_output=True, timeout=10)
    # backup compatdata saves best-effort
    for compat in Path.home().glob(".local/share/Steam/steamapps/compatdata/*/pfx/drive_c"):
        try:
            run(["restic","--repo", str(repo), "backup", str(compat)], capture_output=True, timeout=60)
        except Exception:
            pass
    # rclone remote only if network dns!=off and rclone config exists
    if cfg["remote"] and Path.home().joinpath(".config/rclone/rclone.conf").exists():
        run(["rclone","sync", str(repo), cfg["remote"]], capture_output=True, timeout=120)
    print(f"kyth-save-sync: repo {repo} remote {cfg['remote'] or 'none'}")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
