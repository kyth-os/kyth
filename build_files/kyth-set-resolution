#!/usr/bin/env python3
import os, re, subprocess, time

# kscreen-doctor is only useful once the session has a screen. Retry briefly
# instead of sleeping a fixed 3s (which used to stall System Hub launch).
result = None
for _ in range(8):
    result = subprocess.run(['kscreen-doctor', '-o'], capture_output=True, text=True)
    if result.returncode == 0 and result.stdout.strip():
        break
    time.sleep(0.25)

if result is not None and result.returncode == 0:
    current_output = None
    for line in result.stdout.splitlines():
        line = line.strip()
        m = re.match(r'^Output:\s+\d+\s+(\S+)', line)
        if m:
            current_output = m.group(1)
            continue
        if current_output and re.match(r'^Modes:', line):
            modes = re.findall(r'\d+:(\d+x\d+@[\d.]+)', line)
            if modes:
                subprocess.run([
                    'kscreen-doctor',
                    f'output.{current_output}.enable',
                    f'output.{current_output}.mode.{modes[0]}',
                ], check=False)
            current_output = None

autostart = os.path.expanduser('~/.config/autostart/kyth-set-resolution.desktop')
try:
    os.unlink(autostart)
except OSError:
    pass
