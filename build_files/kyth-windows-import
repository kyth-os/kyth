#!/bin/bash
# kyth-windows-import — read-only NTFS Windows library import (N18)
# Never writes to NTFS; mounts ro, copies Docs/Pictures to ~/WindowsImport.
set -euo pipefail
SRC="${1:-}"
if [[ -z "$SRC" ]]; then
  echo "Usage: kyth-windows-import <ntfs-partition>  # ro mount, dry-run first"
  exit 2
fi
MNT=$(mktemp -d /tmp/kyth-win-XXXX)
echo "Mounting $SRC read-only at $MNT (dry-run check)..."
if ! mount -o ro "$SRC" "$MNT" 2>/dev/null; then
  echo "Failed to mount $SRC ro — is ntfs-3g installed? Try: ntfs-3g -o ro $SRC $MNT"
  rmdir "$MNT" 2>/dev/null || true
  exit 1
fi
echo "Mounted. Contents: $(ls "$MNT" 2>/dev/null | head -n 5 | tr '\n' ' ')"
echo "Copying Users/*/Documents (read-only, no NTFS write)..."
mkdir -p "$HOME/WindowsImport"
for d in "$MNT"/Users/*/Documents "$MNT"/Users/*/Pictures; do
  [[ -d "$d" ]] || continue
  echo " + $d -> $HOME/WindowsImport/"
  cp -a --no-preserve=mode "$d" "$HOME/WindowsImport/" 2>/dev/null || true
done
umount "$MNT" 2>/dev/null || true
rmdir "$MNT" 2>/dev/null || true
echo "Done. Check ~/WindowsImport. No NTFS was written."
