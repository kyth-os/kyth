#!/usr/bin/env python3
"""Export Flatpak Steam game shortcuts and icons to system application menus."""
from __future__ import annotations

import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    here = Path(__file__).resolve().parent
    candidate = here / "kyth_shared"
    if (candidate / "kyth_shared").is_dir():
        path = str(candidate)
        if path not in sys.path:
            sys.path.insert(0, path)


_ensure_kyth_shared_path()
from kyth_shared.desktop.shortcut import export_steam_games  # noqa: E402


def main() -> None:
    exported, skipped = export_steam_games()
    print(f"Steam game launcher export complete: {exported} exported, {skipped} skipped.")


if __name__ == "__main__":
    main()
