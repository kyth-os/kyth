#!/usr/bin/env python3
"""
kyth-sched — automatic sched-ext profile switcher for KythOS.

Monitors GameMode and /proc for active gaming sessions, enabling Fedora's
packaged scx_rusty scheduler while gaming and restoring the kernel scheduler
for desktop use. Also integrates with kyth-performance-mode to wire EPP
and compositor tweaks into the same trigger.

Config: ~/.config/kyth/sched-profiles.toml  (user)
        /etc/kyth/sched-profiles.toml        (system fallback)

Status: $XDG_RUNTIME_DIR/kyth-sched-status.json  (read by System Hub)

Signals:
  SIGHUP  — reload config
  SIGUSR1 — force gaming profile (manual override)
  SIGUSR2 — force desktop profile (clear override)
"""
from __future__ import annotations

import json
import logging
import os
import signal
import subprocess
import sys
import time
import tomllib
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.gaming import check_gaming_reason  # noqa: E402
from kyth_shared.daemon import BaseDaemon  # noqa: E402

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

LOG = logging.getLogger("kyth-sched")

_UID = os.getuid()
_RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{_UID}"))
STATUS_FILE = _RUNTIME_DIR / "kyth-sched-status.json"

DEFAULT_CONFIG: dict = {
    "desktop_scheduler":  "default",
    "gaming_scheduler":   "scx_rusty",
    "poll_interval":      5,
    "integrate_perf_mode": True,   # also call kyth-performance-mode on switch
}







# ---------------------------------------------------------------------------
# Scheduler control
# ---------------------------------------------------------------------------

def _run(*cmd: str, timeout: int = 5) -> tuple[bool, str]:
    try:
        r = subprocess.run(
            list(cmd),
            capture_output=True, text=True,
            timeout=timeout, check=False,
        )
        return r.returncode == 0, r.stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False, ""


def current_scheduler() -> str:
    """Read active scheduler from scx_loader config or sysfs."""
    # Try sysfs first — most reliable
    state_path = Path("/sys/kernel/sched_ext/root/ops")
    if state_path.exists():
        try:
            return state_path.read_text().strip()
        except OSError:
            pass
    # Fall back to kyth-scx status output
    ok, out = _run("kyth-scx", "status")
    if ok:
        for line in out.splitlines():
            if line.startswith("Configured scheduler:"):
                sched = line.split(":", 1)[-1].strip()
                if sched:
                    return sched
    return "unknown"


def set_scheduler(name: str) -> bool:
    """Switch scheduler via kyth-scx (NOPASSWD sudo)."""
    action = ("stop",) if name == "default" else ("set", name)
    ok, out = _run("sudo", "-n", "/usr/bin/kyth-scx", *action)
    if ok:
        LOG.info("Scheduler → %s", name)
    else:
        LOG.warning("kyth-scx set %s failed — scx_loader may not be running", name)
    return ok


def available_schedulers() -> list[str]:
    ok, out = _run("kyth-scx", "list")
    if ok and out:
        return [l.strip() for l in out.splitlines() if l.strip()]
    # Fall back to scanning /usr/bin
    return sorted(
        p.name for p in Path("/usr/bin").glob("scx_*")
        if p.is_file() and p.name != "scx_loader"
    )


# ---------------------------------------------------------------------------
# Gaming detection
# ---------------------------------------------------------------------------

def is_gaming() -> bool:
    return check_gaming_reason(uid=_UID) is not None


# ---------------------------------------------------------------------------
# Performance mode integration
# ---------------------------------------------------------------------------

def perf_mode(mode: str) -> None:
    """Call kyth-performance-mode non-blocking; failures are non-fatal."""
    try:
        subprocess.Popen(
            ["/usr/bin/kyth-performance-mode", mode],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        pass


def enter_gaming_perf_mode() -> None:
    """Snapshot the user's current desktop/power state, then apply gaming mode."""
    try:
        subprocess.Popen(
            ["/usr/bin/kyth-performance-mode", "save"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).wait(timeout=5)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    perf_mode("gaming")


# ---------------------------------------------------------------------------
# Status reporting
# ---------------------------------------------------------------------------

def write_status(profile: str, scheduler: str, gaming: bool, override: bool) -> None:
    STATUS_FILE.parent.mkdir(parents=True, exist_ok=True)
    try:
        STATUS_FILE.write_text(json.dumps({
            "profile":      profile,
            "scheduler":    scheduler,
            "gaming_active": gaming,
            "manual_override": override,
            "ts":           int(time.time()),
        }))
    except OSError as exc:
        LOG.debug("Could not write status: %s", exc)


class SchedDaemon(BaseDaemon):
    def __init__(self) -> None:
        super().__init__(
            "kyth-sched",
            config_filename="sched-profiles.toml",
            config_section="scheduler",
            default_config=DEFAULT_CONFIG,
            poll_interval_key="poll_interval",
            default_poll_interval=5.0,
        )
        self.profile = "desktop"
        self.gaming_prev = False
        self.manual_override: str | None = None

    def setup_signals(self) -> None:
        super().setup_signals()

        def force_gaming(signum, frame):
            self.logger.info("Manual override → gaming (SIGUSR1)")
            self.manual_override = "gaming"
            self.wakeup()

        def force_desktop(signum, frame):
            self.logger.info("Manual override cleared (SIGUSR2)")
            self.manual_override = None
            self.wakeup()

        signal.signal(signal.SIGUSR1, force_gaming)
        signal.signal(signal.SIGUSR2, force_desktop)

    def on_start(self) -> None:
        set_scheduler(self.config["desktop_scheduler"])
        self.logger.info(
            "Started — desktop=%s  gaming=%s  poll=%ds",
            self.config["desktop_scheduler"],
            self.config["gaming_scheduler"],
            self.get_poll_interval(),
        )

    def poll(self) -> None:
        effective = self.manual_override or ("gaming" if is_gaming() else "desktop")
        gaming_now = (effective == "gaming")

        if gaming_now != self.gaming_prev:
            if gaming_now:
                set_scheduler(self.config["gaming_scheduler"])
                if self.config.get("integrate_perf_mode"):
                    enter_gaming_perf_mode()
                self.profile = "gaming"
                self.logger.info("→ gaming profile (%s)", self.config["gaming_scheduler"])
            else:
                set_scheduler(self.config["desktop_scheduler"])
                if self.config.get("integrate_perf_mode"):
                    perf_mode("restore")
                self.profile = "desktop"
                self.logger.info("→ desktop profile (%s)", self.config["desktop_scheduler"])
            self.gaming_prev = gaming_now

        write_status(
            self.profile,
            current_scheduler(),
            gaming_now,
            self.manual_override is not None,
        )


def main() -> None:
    daemon = SchedDaemon()
    sys.exit(daemon.run())


if __name__ == "__main__":
    main()
