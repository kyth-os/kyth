#!/usr/bin/env python3
"""Switch and manage KythOS performance presets and KDE composition parameters."""
from __future__ import annotations

import os
import re
import sys
from pathlib import Path



from kyth_shared.desktop.plasma import get_qdbus_command, kreadconfig, kwriteconfig  # noqa: E402
from kyth_shared.performance import (  # noqa: E402
    get_current_epp,
    get_power_profile,
    set_epp,
    set_power_profile,
)

# Resolve state file location
runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
if not runtime_dir:
    runtime_dir = f"/run/user/{os.getuid()}"
STATE_FILE = Path(runtime_dir) / "kyth-performance-mode.state"


def reconfigure_kwin() -> None:
    qdbus = get_qdbus_command()
    if qdbus:
        import subprocess
        try:
            subprocess.run(
                [qdbus, "org.kde.KWin", "/KWin", "reconfigure"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except Exception:
            pass


def save_state() -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    power_profile = get_power_profile()
    anim_factor = kreadconfig("kdeglobals", "KDE", "AnimationDurationFactor") or ""
    blur_enabled = kreadconfig("kwinrc", "Plugins", "blurEnabled") or ""
    epp = get_current_epp()

    with open(STATE_FILE, "w", encoding="utf-8") as f:
        f.write(f"POWER_PROFILE={power_profile}\n")
        f.write(f"ANIMATION_DURATION_FACTOR={anim_factor}\n")
        f.write(f"BLUR_ENABLED={blur_enabled}\n")
        f.write(f"EPP={epp}\n")


def read_state_key(key: str) -> str:
    if not STATE_FILE.is_file():
        return ""
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith(f"{key}="):
                    val = line.split("=", 1)[1].strip()
                    # Sanitize to allow only safe characters
                    if re.match(r"^[A-Za-z0-9_. -]*$", val):
                        return val
    except Exception:
        pass
    return ""


def restore_state() -> None:
    if not STATE_FILE.is_file():
        return

    power_profile = read_state_key("POWER_PROFILE")
    anim_factor = read_state_key("ANIMATION_DURATION_FACTOR")
    blur_enabled = read_state_key("BLUR_ENABLED")
    epp = read_state_key("EPP")

    if power_profile:
        set_power_profile(power_profile)
    if anim_factor:
        kwriteconfig("kdeglobals", "KDE", "AnimationDurationFactor", anim_factor)
    if blur_enabled:
        kwriteconfig("kwinrc", "Plugins", "blurEnabled", blur_enabled)
    if epp:
        set_epp(epp)

    reconfigure_kwin()
    try:
        STATE_FILE.unlink(missing_ok=True)
    except Exception:
        pass


def apply_mode(mode: str) -> None:
    if mode == "max":
        set_power_profile("performance")
        set_epp("performance")
        kwriteconfig("kdeglobals", "KDE", "AnimationDurationFactor", "0")
        kwriteconfig("kwinrc", "Plugins", "blurEnabled", "false")
    elif mode == "gaming":
        set_power_profile("performance")
        set_epp("performance")
        kwriteconfig("kdeglobals", "KDE", "AnimationDurationFactor", "0.5")
        kwriteconfig("kwinrc", "Plugins", "blurEnabled", "false")
    elif mode == "performance":
        set_power_profile("performance")
        set_epp("performance")
        kwriteconfig("kdeglobals", "KDE", "AnimationDurationFactor", "0.75")
        kwriteconfig("kwinrc", "Plugins", "blurEnabled", "false")
    elif mode == "balanced":
        set_power_profile("balanced")
        set_epp("balance_performance")
        kwriteconfig("kdeglobals", "KDE", "AnimationDurationFactor", "1")
        kwriteconfig("kwinrc", "Plugins", "blurEnabled", "true")
    elif mode == "powersave":
        set_power_profile("power-saver")
        set_epp("power")
        kwriteconfig("kdeglobals", "KDE", "AnimationDurationFactor", "1.25")
        kwriteconfig("kwinrc", "Plugins", "blurEnabled", "true")
    else:
        print(f"Unknown mode: {mode}", file=sys.stderr)
        print("Usage: kyth-performance-mode [save|restore|status|max|gaming|performance|balanced|powersave]", file=sys.stderr)
        sys.exit(1)

    reconfigure_kwin()


def status_mode() -> None:
    power_profile = get_power_profile()
    epp = get_current_epp()
    anim_factor = kreadconfig("kdeglobals", "KDE", "AnimationDurationFactor") or "default"
    blur_enabled = kreadconfig("kwinrc", "Plugins", "blurEnabled") or "default"

    print(f"Power profile: {power_profile}")
    print(f"CPU EPP: {epp}")
    print(f"KDE animation factor: {anim_factor}")
    print(f"KWin blur enabled: {blur_enabled}")


def main() -> None:
    cmd = "status"
    if len(sys.argv) > 1:
        cmd = sys.argv[1]

    if cmd == "save":
        save_state()
    elif cmd == "restore":
        restore_state()
    elif cmd == "status":
        status_mode()
    elif cmd in ("max", "gaming", "performance", "balanced", "powersave"):
        apply_mode(cmd)
    else:
        print(f"Unknown option: {cmd}", file=sys.stderr)
        print("Usage: kyth-performance-mode [save|restore|status|max|gaming|performance|balanced|powersave]", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
