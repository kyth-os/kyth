[Unit]
Description=Apply VS Code and Brave KWallet defaults
# /root lives on the immutable ostree / — ProtectSystem=strict cannot make
# it writable, so the marker touch fails EROFS when this user unit runs
# as root (lingering or a root graphical session). Desktop users have
# $HOME on /var/home.
ConditionUser=!root
ConditionPathExists=!%S/kyth/browser-wallet-defaults-v2

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-vscode-wallet
ExecStartPost=/usr/bin/touch %S/kyth/browser-wallet-defaults-v2
StateDirectory=kyth
StateDirectoryMode=0700
# Runs once ever (marker-gated), often right at first login — deprioritized
# so it never competes with the desktop session for cycles.
Nice=15
IOSchedulingClass=idle
MemoryMax=384M
PrivateTmp=yes
PrivateUsers=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
UMask=0077
[Install]
WantedBy=default.target
