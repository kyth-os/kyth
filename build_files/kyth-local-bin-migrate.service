[Unit]
Description=KythOS migration for old /usr/local helper paths
After=local-fs.target
ConditionPathExists=!/var/lib/kyth/migrations/local-bin-v1.done

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-local-bin-migrate
RemainAfterExit=yes
# Runs once ever (marker-gated), at boot — deprioritized so it never
# competes with early login/session startup for cycles.
Nice=15
IOSchedulingClass=idle
MemoryMax=384M
PrivateTmp=yes
# PrivateUsers remaps root and cannot rewrite /var/home/*/…autostart.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Marker is /var/lib/kyth/migrations (StateDirectory, always writable).
# The migration only rewrites root-owned helper shims, so /usr/local and
# /var/home stay read-only under ProtectSystem=strict / ProtectHome.
StateDirectory=kyth/migrations
StateDirectoryMode=0700
ReadWritePaths=-/root
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
