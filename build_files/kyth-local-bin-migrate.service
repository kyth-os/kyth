[Unit]
Description=KythOS migration for old /usr/local helper paths
After=local-fs.target
ConditionPathExists=!/var/lib/kyth/migrations/local-bin-v1.done

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-local-bin-migrate
# Runs once ever (marker-gated), at boot — deprioritized so it never
# competes with early login/session startup for cycles.
Nice=15
IOSchedulingClass=idle
MemoryMax=384M
PrivateTmp=yes
PrivateUsers=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
UMask=0077
[Install]
WantedBy=multi-user.target
