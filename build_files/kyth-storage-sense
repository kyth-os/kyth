#!/usr/bin/env python3
"""KythOS Storage Sense - automatically prune trash, unused flatpaks, and journals."""
from __future__ import annotations

import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.maintenance import cleanup_flatpaks, prune_trash, vacuum_user_journals  # noqa: E402


def main() -> None:
    # Prune trash older than 30 days
    prune_trash(days=30)
    # Remove unused flatpaks
    cleanup_flatpaks()
    # Vacuum user journalctl files
    vacuum_user_journals(days=30)


if __name__ == "__main__":
    main()
