#!/usr/bin/env python3
"""kyth-rclone-update — Install/update the latest rclone release with SHA256 verification."""
from __future__ import annotations

import os
import shutil
import sys
import tempfile
from pathlib import Path



from kyth_shared.system.updater import (  # noqa: E402
    download_file,
    extract_archive,
    fetch_github_latest_release,
    validate_version,
    verify_checksum_file,
)
from kyth_shared.commands import run_text


def main() -> None:
    # Resolve the latest release tag live unless explicitly overridden
    rclone_ver = os.environ.get("RCLONE_VERSION", "")
    if not rclone_ver:
        print("Fetching latest rclone release metadata...")
        try:
            release = fetch_github_latest_release("rclone/rclone")
            rclone_ver = release.get("tag_name", "")
        except Exception as e:
            print(f"ERROR: Could not determine latest rclone release tag: {e}", file=sys.stderr)
            sys.exit(1)

    if not rclone_ver:
        print("ERROR: Could not determine latest rclone release tag", file=sys.stderr)
        sys.exit(1)

    # Validate the version tag looks like a semver (vX.Y.Z)
    try:
        validate_version(rclone_ver, r"v[0-9]+\.[0-9]+\.[0-9]+", "rclone")
    except ValueError:
        print(f"ERROR: Unexpected rclone version format: {rclone_ver}", file=sys.stderr)
        sys.exit(1)

    target_ver = rclone_ver.lstrip("v")
    rclone_bin = Path("/usr/local/bin/rclone")

    if rclone_bin.is_file():
        try:
            res = run_text([str(rclone_bin), "--version"])
            if res is None:
                raise OSError("rclone could not be executed")
            first_line = res.stdout.splitlines()[0]
            parts = first_line.split()
            if len(parts) >= 2 and parts[0] == "rclone" and parts[1].startswith("v"):
                installed_ver = parts[1].lstrip("v")
                if installed_ver == target_ver:
                    print(f"rclone already current: v{installed_ver}")
                    sys.exit(0)
        except Exception:
            pass

    basename = f"rclone-{rclone_ver}-linux-amd64"
    zip_name = f"{basename}.zip"
    base_url = f"https://downloads.rclone.org/{rclone_ver}"

    with tempfile.TemporaryDirectory() as tmpdir:
        temp_path = Path(tmpdir)
        zip_dest = temp_path / zip_name
        sums_dest = temp_path / "SHA256SUMS"

        try:
            print(f"rclone: downloading {zip_name}...")
            download_file(f"{base_url}/{zip_name}", zip_dest)
            print("rclone: downloading SHA256SUMS...")
            download_file(f"{base_url}/SHA256SUMS", sums_dest)
        except Exception as e:
            print(f"ERROR: Failed to download rclone assets: {e}", file=sys.stderr)
            sys.exit(1)

        try:
            print("Verifying checksum...")
            verify_checksum_file(sums_dest, temp_path, "sha256")
        except Exception as e:
            print(f"ERROR: Checksum verification failed: {e}", file=sys.stderr)
            sys.exit(1)

        try:
            print("Extracting archive...")
            extract_archive(zip_dest, temp_path)
        except Exception as e:
            print(f"ERROR: Extraction failed: {e}", file=sys.stderr)
            sys.exit(1)

        extracted_bin = temp_path / basename / "rclone"
        if not extracted_bin.is_file():
            # Fallback if ZIP top-level directory naming is slightly different
            extracted_bin = temp_path / "rclone"

        try:
            rclone_bin.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(extracted_bin, rclone_bin)
            rclone_bin.chmod(0o755)
        except Exception as e:
            print(f"ERROR: Failed to install rclone binary to {rclone_bin}: {e}", file=sys.stderr)
            sys.exit(1)

    # Print version of installed binary
    try:
        res = run_text([str(rclone_bin), "--version"])
        if res is None:
            raise OSError("rclone could not be executed")
        version_output = res.stdout.splitlines()[0]
        print(f"rclone installed: {version_output}")
    except Exception as e:
        print(f"rclone installed, but version check failed: {e}")


if __name__ == "__main__":
    main()
