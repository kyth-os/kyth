#!/usr/bin/env python3
"""Compatibility entry point for the shared KythOS VPN application.

VPN used to ship as a second, standalone Qt application. That duplicated the
openconnect state machine and the complete WebEngine SAML implementation, and
the two copies repeatedly drifted into different crash fixes. Keep the public
``kyth-vpn-connect`` command, but route it to the one supported VPN UI.
"""

from __future__ import annotations

def main() -> None:
    from kyth_welcome.vpn_app import main as vpn_main

    vpn_main()


if __name__ == "__main__":
    main()
