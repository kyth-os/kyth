    def _load_saved_config(self) -> None:
        cfg = _load_config()
        if "vpn" not in cfg:
            return
        v = cfg["vpn"]
        self._gateway.setText(v.get("gateway", ""))
        proto = v.get("protocol", "gp")
        idx = self._protocol.findText(proto)
        if idx >= 0:
            self._protocol.setCurrentIndex(idx)
        os_val = v.get("os", "win")
        idx = self._os_emul.findText(os_val)
        if idx >= 0:
            self._os_emul.setCurrentIndex(idx)
        self._username.setText(v.get("username", ""))

    def _on_connect(self) -> None:
        if self._worker and self._worker.isRunning():
            self._show_window()
            return
        gateway = self._gateway.text().strip()
        if not gateway:
            self._log.append("[Error: Gateway is required]")
            self._show_window()
            return

        protocol = self._protocol.currentText()
        os_emul = self._os_emul.currentText()
        username = self._username.text().strip()
        password = self._password.text()

        _save_config(gateway, protocol, os_emul, username)

        self._log.clear()
        self._hid_after_connect = False
        self._gp_interface = "portal"
        self._pending_gateway_saml = False
        self._gateway_saml_attempted = False
        self._set_status("connecting")
        self._connect_btn.setEnabled(False)
        self._disconnect_btn.setEnabled(True)
        # Lock config fields while connected
        for w in (self._gateway, self._protocol, self._os_emul, self._username, self._password):
            w.setEnabled(False)

        cmd = [
            "sudo", "-E", "-A",
            "/usr/bin/openconnect",
            "--protocol", protocol,
            "--os", os_emul,
            "--script", "/usr/libexec/kyth-vpnc-script",
        ]
        if username:
            cmd += ["--user", username]
        if password:
            cmd += ["--passwd-on-stdin"]
        cmd.append(gateway)

        self._start_worker(cmd, password)

    def _on_disconnect(self) -> None:
        if self._worker:
            self._worker.stop()
        else:
            self._set_status("disconnected")

    def _on_line(self, line: str) -> None:
        self._log.append(_redact_vpn_log_line(line))
        sb = self._log.verticalScrollBar()
        sb.setValue(sb.maximum())
        if _vpn_line_is_connected(line):
            self._set_status("connected")
            return
        m = _GP_PRELOGIN_IFACE_RE.search(line)
        if m:
            self._gp_interface = "portal" if m.group(1) == "global-protect" else "gateway"
            return
        if (
            "fgets (stdin)" in line
            and self._gp_interface == "gateway"
            and not self._saml_in_progress
            and not self._gateway_saml_attempted
        ):
            # Portal accepted the SAML cookie, but the gateway then demanded
            # its own prelogin-cookie (the portal cookie is interface-bound and
            # the portal returned no portal-userauthcookie to carry over).
            # openconnect prompted for it on an exhausted stdin and died — redo
            # SAML directly against the gateway once this process exits.
            self._pending_gateway_saml = True
            return
        if "Unexpected 512 result from server" in line:
            self._log.append(
                "[Hint: the GlobalProtect server rejected the SAML token — "
                "usually a portal/gateway mismatch or a username that doesn't "
                "match the SAML account]"
            )
            return
        m = _SAML_URL_RE.search(line)
        if m:
            self._on_saml_required(m.group(1))

    def _on_saml_required(self, saml_url: str) -> None:
        if _WEBENGINE_AVAILABLE:
            self._log.append("[SAML] Opening embedded authentication browser…")
            self._saml_in_progress = True
            dlg = SamlBrowserDialog(saml_url, self)
            dlg.cookie_ready.connect(self._on_saml_cookie)
            dlg.exec()
            res = dlg.result()
            dlg.deleteLater()
            self._saml_in_progress = False
            if res != QDialog.DialogCode.Accepted:
                self._log.append("[SAML] Authentication cancelled.")
                self._set_status("disconnected")
                self._connect_btn.setEnabled(True)
                self._disconnect_btn.setEnabled(False)
                for w in (self._gateway, self._protocol, self._os_emul, self._username, self._password):
                    w.setEnabled(True)
        else:
            import webbrowser
            from PyQt6.QtWidgets import QInputDialog
            self._log.append("[SAML] Opening authentication URL in your browser...")
            webbrowser.open(saml_url)
            self._log.append("[SAML] After login, open browser dev tools, find the correct cookie (e.g., prelogin-cookie, preloginuserauthcookie, portal-userauthcookie), and paste it below.")
            cookie, ok = QInputDialog.getText(self, "Paste VPN Cookie", "Paste the cookie (name=value):")
            if ok and cookie.strip():
                self._on_saml_cookie(cookie.strip())
            else:
                self._log.append("[SAML] No cookie provided. Cannot continue.")
                self._set_status("disconnected")
                self._connect_btn.setEnabled(True)
                self._disconnect_btn.setEnabled(False)
                for w in (self._gateway, self._protocol, self._os_emul, self._username, self._password):
                    w.setEnabled(True)

    def _on_saml_cookie(self, cookie: str) -> None:
        self._log.append("[SAML authentication complete — reconnecting…]")
        if self._worker:
            self._worker.stop()
            if not self._worker.wait(10000):
                self._log.append("[Error: timed out waiting for the first openconnect process to exit]")
                return
        self._set_status("connecting")
        self._connect_btn.setEnabled(False)
        self._disconnect_btn.setEnabled(True)
        for w in (self._gateway, self._protocol, self._os_emul, self._username, self._password):
            w.setEnabled(False)
        protocol = self._protocol.currentText()
        os_emul = self._os_emul.currentText()
        username = self._username.text().strip()
        gateway = self._gateway.text().strip()
        field, value, saml_username = _parse_gp_saml_cookie(cookie)
        cmd = [
            "sudo", "-E", "-A", "/usr/bin/openconnect",
            "--protocol", protocol,
            "--os", os_emul,
            "--script", "/usr/libexec/kyth-vpnc-script",
        ]
        worker_stdin = ""
        if protocol == "gp" and field and value:
            cmd += ["--passwd-on-stdin", "--usergroup", f"{self._gp_interface}:{field}"]
            worker_stdin = value
            print(f"[SAML dbg] reconnecting via {self._gp_interface} with {field} and username={'yes' if (username or saml_username) else 'no'}")
        else:
            cmd += ["--cookie", cookie]
        # The GP prelogin-cookie is bound to the SAML identity — the server
        # 512s if --user doesn't match it exactly, so it wins over the form.
        username = saml_username or username
        if username:
            cmd += ["--user", username]
        cmd.append(gateway)
        self._start_worker(cmd, worker_stdin)

    def _start_gateway_probe(self) -> None:
        """Re-run the openconnect SAML probe against the GP gateway interface.

        Used when the portal leg succeeded but the gateway demanded its own
        prelogin-cookie, which only a gateway-issued SAML login can provide.
        The probe prints the gateway's SAML URL, the embedded browser replays
        the (now session-cached) IdP login, and the reconnect then uses
        gateway:<field>.
        """
        gateway = self._gateway.text().strip()
        username = self._username.text().strip()
        self._gp_interface = "gateway"
        self._set_status("connecting")
        cmd = [
            "sudo", "-E", "-A", "/usr/bin/openconnect",
            "--protocol", self._protocol.currentText(),
            "--os", self._os_emul.currentText(),
            "--script", "/usr/libexec/kyth-vpnc-script",
            "--usergroup", "gateway",
        ]
        if username:
            cmd += ["--user", username]
        cmd.append(gateway)
        self._start_worker(cmd)

    def _start_worker(self, cmd: list[str], stdin_text: str = "") -> None:
        worker = _VpnWorker(cmd, stdin_text)
        self._worker = worker
        worker.line.connect(self._on_line)
        worker.done.connect(lambda code, w=worker: self._on_done(w, code))
        worker.start()

    def _on_done(self, worker: _VpnWorker, code: int) -> None:
        if worker is not self._worker:
            worker.deleteLater()
            return
        self._log.append(f"\n[openconnect exited: code {code}]")
        self._worker = None
        worker.deleteLater()
        if self._saml_in_progress:
            # First openconnect probe exits naturally after outputting the SAML
            # URL — the SAML dialog is still open, so don't reset the UI yet.
            return
        if self._pending_gateway_saml:
            self._pending_gateway_saml = False
            self._gateway_saml_attempted = True
            self._log.append(
                "[GP] Gateway requires its own SAML sign-in — restarting "
                "authentication against the gateway interface…"
            )
            self._gateway_probe_timer.start(500)
            return
        self._set_status("disconnected")
        self._connect_btn.setEnabled(True)
        self._disconnect_btn.setEnabled(False)
        for w in (self._gateway, self._protocol, self._os_emul, self._username, self._password):
            w.setEnabled(True)
        if self._pending_reconnect:
            self._pending_reconnect = False
            self._reconnect_timer.start(500)
        else:
            self._show_window()

    def _set_status(self, state: str, hide_on_connected: bool = True) -> None:
        self._status_state = state
        if state == "connected":
            self._status.setText("● Connected")
            self._status.setStyleSheet("color: #4caf50; font-weight: bold;")
            if hide_on_connected and not self._hid_after_connect:
                self._hid_after_connect = True
                self.hide()
                self._tray.showMessage(
                    "VPN connected",
                    "VPN Connect is running in the system tray.",
                    QSystemTrayIcon.MessageIcon.Information,
                    3500,
                )
        elif state == "connecting":
            self._status.setText("● Connecting…")
            self._status.setStyleSheet("color: #ff9800; font-weight: bold;")
        else:
            self._status.setText("● Disconnected")
            self._status.setStyleSheet("color: palette(mid); font-weight: bold;")
            self._hid_after_connect = False
        self._update_tray_actions()

    def _update_tray_actions(self) -> None:
        connected = self._status_state == "connected"
        connecting = self._status_state == "connecting"
        disconnected = self._status_state == "disconnected"

        if connected:
            status_text = "VPN: connected"
            tooltip = "VPN connected"
        elif connecting:
            status_text = "VPN: connecting"
            tooltip = "VPN connecting"
        else:
            status_text = "VPN: disconnected"
            tooltip = "VPN disconnected"

        self._tray_status_action.setText(status_text)
        self._tray.setToolTip(tooltip)
        self._tray_connect_action.setEnabled(disconnected)
        self._tray_disconnect_action.setEnabled(connected or connecting)
        self._tray_refresh_action.setEnabled(True)

    def closeEvent(self, event) -> None:  # type: ignore[override]
        if self._worker and self._worker.isRunning():
            self.hide()
            event.ignore()
            self._tray.showMessage(
                "VPN Connect is still running",
                "Use the tray menu to reopen or disconnect.",
                QSystemTrayIcon.MessageIcon.Information,
                3000,
            )
            return
        self._tray.hide()
        event.accept()
        QApplication.quit()


def main() -> None:
    app = QApplication(sys.argv)
    app.aboutToQuit.connect(_shutdown_threads)
    app.setApplicationName("kyth-vpn-connect")
    app.setDesktopFileName("kyth-vpn-connect")
    app.setWindowIcon(QIcon.fromTheme(_APP_ICON_NAME))
    app.setQuitOnLastWindowClosed(False)

    # Single instance check
    from PyQt6.QtNetwork import QLocalServer, QLocalSocket
    socket_name = f"kyth-vpn-connect-{os.getuid()}"
    socket = QLocalSocket()
    socket.connectToServer(socket_name)
    if socket.waitForConnected(500):
        socket.write(b"show")
        socket.waitForBytesWritten(500)
        return

    server = QLocalServer()
    server.removeServer(socket_name)
    if not server.listen(socket_name):
        print(f"Warning: Could not start single-instance listener: {server.errorString()}")

    win = MainWindow()

    def handle_new_connection():
        conn = server.nextPendingConnection()
        if conn and conn.waitForReadyRead(500):
            msg = bytes(conn.readAll()).decode("utf-8", errors="replace")
            if msg == "show":
                win.show()
                win.raise_()
                win.activateWindow()
        if conn:
            conn.close()

    server.newConnection.connect(handle_new_connection)
    app._instance_server = server  # type: ignore[attr-defined]

    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
