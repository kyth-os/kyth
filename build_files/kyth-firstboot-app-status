#!/usr/bin/env python3
"""User-session notifier for default app setup progress."""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    here = Path(__file__).resolve().parent
    candidate = here / "kyth_shared"
    if (candidate / "kyth_shared").is_dir():
        path = str(candidate)
        if path not in sys.path:
            sys.path.insert(0, path)


_ensure_kyth_shared_path()
from kyth_shared.session import check_firstboot_app_status  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(description="KythOS Firstboot App Status Notifier")
    parser.add_argument("--force", action="store_true", help="Force status evaluation")
    args = parser.parse_args()

    # Get env delay and notify configs
    try:
        delay = int(os.environ.get("KYTH_APP_STATUS_DELAY", "20"))
    except ValueError:
        delay = 20

    notify_ready = os.environ.get("KYTH_APP_STATUS_NOTIFY_READY", "0") == "1"

    ret = check_firstboot_app_status(force=args.force, delay=delay, notify_ready=notify_ready)
    sys.exit(ret)


if __name__ == "__main__":
    main()
