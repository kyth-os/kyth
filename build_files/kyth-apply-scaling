#!/usr/bin/env python3
"""kyth-apply-scaling — apply scaling.toml via kscreen-doctor."""
from __future__ import annotations

import sys

from kyth_shared.scaling import apply_scaling


def main() -> int:
    notes = apply_scaling()
    print(f"kyth-apply-scaling: {'; '.join(notes) if notes else 'nothing to apply'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
