#!/bin/bash
set -euo pipefail

# Check for live ISO environment
if grep -qw 'kyth.live=1' /proc/cmdline 2>/dev/null; then
    echo "Proton-CachyOS update disabled in live ISO environment."
    exit 0
fi

# ── kyth-proton-cachyos-update ────────────────────────────────────────────────
# Downloads the latest Proton-CachyOS to /var/lib/kyth/proton-cachyos/, where
# Steam picks it up via STEAM_EXTRA_COMPAT_TOOLS_PATHS. Keeps the two most
# recent versions so there is always a fallback if a new release breaks
# something.
#
# The build-time Proton-CachyOS in /usr/share/steam/compatibilitytools.d/ is
# separate and provides a working version without network access (e.g. fresh
# installs).

INSTALL_DIR="/var/lib/kyth/proton-cachyos"
PROTON_CACHYOS_REPO_API="https://api.github.com/repos/CachyOS/proton-cachyos/releases"
TMPDIR_PC=$(mktemp -d)
trap 'rm -rf "${TMPDIR_PC}"' EXIT

release_json="${TMPDIR_PC}/release.json"
if ! curl -fsSL "${PROTON_CACHYOS_REPO_API}/latest" -o "${release_json}"; then
    echo "Failed to fetch Proton-CachyOS release info" >&2
    exit 1
fi

PROTON_CACHYOS_VER=$(grep '"tag_name"' "${release_json}" | head -n1 | cut -d'"' -f4)
if [[ -z "${PROTON_CACHYOS_VER}" ]]; then
    echo "Failed to parse Proton-CachyOS version tag from release JSON" >&2
    exit 1
fi
if [[ ! "${PROTON_CACHYOS_VER}" =~ ^cachyos-[0-9]+\.[0-9]+-[0-9]{8}-slr$ ]]; then
    echo "Unexpected Proton-CachyOS version format: ${PROTON_CACHYOS_VER}" >&2
    exit 1
fi

# The extracted top-level directory is named after the tarball, not the tag
# (e.g. tag "cachyos-11.0-20260602-slr" extracts to
# "proton-cachyos-11.0-20260602-slr-x86_64/"), so derive it from the asset URL.
PROTON_CACHYOS_TARBALL_URL=$(
    grep -o 'https://[^"]*x86_64\.tar\.xz' "${release_json}" | head -n1
)
PROTON_CACHYOS_SHA512_URL=$(
    grep -o 'https://[^"]*x86_64\.sha512sum' "${release_json}" | head -n1
)

if [[ -z "${PROTON_CACHYOS_TARBALL_URL}" || -z "${PROTON_CACHYOS_SHA512_URL}" ]]; then
    echo "Failed to locate Proton-CachyOS release assets" >&2
    exit 1
fi

PROTON_CACHYOS_TARBALL=$(basename "${PROTON_CACHYOS_TARBALL_URL}")
PROTON_CACHYOS_SHA512=$(basename "${PROTON_CACHYOS_SHA512_URL}")
INSTALL_PATH="${INSTALL_DIR}/${PROTON_CACHYOS_TARBALL%.tar.xz}"

if [[ -d "${INSTALL_PATH}" ]]; then
    echo "Proton-CachyOS ${PROTON_CACHYOS_VER} is already up to date."
    exit 0
fi

echo "Updating to Proton-CachyOS ${PROTON_CACHYOS_VER}..."

mkdir -p "${INSTALL_DIR}"
curl -fsSL "${PROTON_CACHYOS_TARBALL_URL}" -o "${TMPDIR_PC}/${PROTON_CACHYOS_TARBALL}"
curl -fsSL "${PROTON_CACHYOS_SHA512_URL}" -o "${TMPDIR_PC}/${PROTON_CACHYOS_SHA512}"

(
    cd "${TMPDIR_PC}"
    sha512sum -c "${PROTON_CACHYOS_SHA512}"
)

tar -xJf "${TMPDIR_PC}/${PROTON_CACHYOS_TARBALL}" -C "${INSTALL_DIR}/"
echo "Proton-CachyOS ${PROTON_CACHYOS_VER} installed to ${INSTALL_DIR}/"

# Keep only the 2 most recent versions (current + one rollback)
mapfile -t old_versions < <(ls -dt "${INSTALL_DIR}"/proton-cachyos-* 2>/dev/null | tail -n +3)
for old in "${old_versions[@]}"; do
    echo "Removing old version: $(basename "${old}")"
    rm -rf "${old}"
done
