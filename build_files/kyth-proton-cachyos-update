#!/usr/bin/env python3
"""kyth-proton-cachyos-update — Download and manage Proton-CachyOS releases."""
from __future__ import annotations

import sys
import tempfile
from pathlib import Path



from kyth_shared.system.updater import (  # noqa: E402
    download_file,
    extract_archive,
    fetch_github_latest_release,
    find_release_asset,
    prune_installations,
    release_assets,
    validate_version,
    verify_checksum_file,
)


def main() -> None:
    # Check for live ISO environment
    try:
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8")
        if any(arg in cmdline.split() for arg in ("kyth.live", "kyth.live=1")):
            print("Proton-CachyOS update disabled in live ISO environment.")
            sys.exit(0)
    except Exception:
        pass

    install_dir = Path("/var/lib/kyth/proton-cachyos")

    print("Fetching latest Proton-CachyOS release metadata...")
    try:
        release = fetch_github_latest_release("CachyOS/proton-cachyos")
    except Exception as e:
        print(f"Failed to fetch Proton-CachyOS release info: {e}", file=sys.stderr)
        sys.exit(1)

    ver = release.get("tag_name", "")
    if not ver:
        print("Failed to parse Proton-CachyOS version tag from release JSON", file=sys.stderr)
        sys.exit(1)

    try:
        validate_version(ver, r"cachyos-[0-9]+\.[0-9]+-[0-9]{8}-slr", "Proton-CachyOS")
    except ValueError:
        print(f"Unexpected Proton-CachyOS version format: {ver}", file=sys.stderr)
        sys.exit(1)

    assets = release_assets(release)
    tarball = find_release_asset(assets, lambda name: name.endswith("x86_64.tar.xz"))
    checksum = find_release_asset(assets, lambda name: name.endswith("x86_64.sha512sum"))

    if not tarball or not checksum:
        print("Failed to locate Proton-CachyOS release assets", file=sys.stderr)
        sys.exit(1)

    tarball_url, tarball_name = tarball.url, tarball.name
    sha512_url, sha512_name = checksum.url, checksum.name

    # Derive target install path from tarball filename
    folder_name = tarball_name
    if folder_name.endswith(".tar.xz"):
        folder_name = folder_name[:-7]
    elif folder_name.endswith(".xz"):
        folder_name = folder_name[:-3]

    target_path = install_dir / folder_name
    if target_path.is_dir():
        print(f"Proton-CachyOS {ver} is already up to date.")
        sys.exit(0)

    print(f"Updating to Proton-CachyOS {ver}...")

    with tempfile.TemporaryDirectory() as tmpdir:
        temp_path = Path(tmpdir)
        tarball_dest = temp_path / tarball_name
        sha512_dest = temp_path / sha512_name

        try:
            print(f"Downloading {tarball_name}...")
            download_file(tarball_url, tarball_dest)
            print(f"Downloading {sha512_name}...")
            download_file(sha512_url, sha512_dest)
        except Exception as e:
            print(f"Failed to download assets: {e}", file=sys.stderr)
            sys.exit(1)

        try:
            print("Verifying checksum...")
            verify_checksum_file(sha512_dest, tarball_dest, "sha512")
        except Exception as e:
            print(f"Checksum verification failed: {e}", file=sys.stderr)
            sys.exit(1)

        try:
            print(f"Extracting to {install_dir}...")
            extract_archive(tarball_dest, install_dir)
        except Exception as e:
            print(f"Extraction failed: {e}", file=sys.stderr)
            sys.exit(1)

    print(f"Proton-CachyOS {ver} installed to {install_dir}/")

    # Prune old versions (keep only current + one rollback)
    try:
        for old in prune_installations(install_dir, "proton-cachyos-*", keep=2):
            print(f"Removing old version: {old.name}")
    except Exception as e:
        print(f"Failed to prune old versions: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
