#!/usr/bin/env python3
"""kyth-installer — KythOS graphical installer entry point.

The application lives in the kyth_installer package, installed at
/usr/lib/kyth-installer on the OS image. A source checkout keeps the
package next to this script, which takes precedence for development.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _candidate in (_here, "/usr/lib/kyth-installer"):
    if os.path.isdir(os.path.join(_candidate, "kyth_installer")):
        if _candidate not in sys.path:
            sys.path.insert(0, _candidate)
        break

# kyth_shared lives next to the kyth-installer source tree, or at
# /usr/kyth_shared in the installed container image.
_shared_dir = os.path.join(os.path.dirname(_here), "kyth_shared")
if not os.path.isdir(os.path.join(_shared_dir, "kyth_shared")):
    _shared_dir = "/usr/kyth_shared"
if os.path.isdir(os.path.join(_shared_dir, "kyth_shared")) and _shared_dir not in sys.path:
    sys.path.insert(0, _shared_dir)

from kyth_installer.app import main

if __name__ == "__main__":
    main()
