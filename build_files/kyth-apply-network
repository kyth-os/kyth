#!/usr/bin/env python3
"""kyth-apply-network — apply network.toml (DoT + firewalld) offline."""
import sys
from kyth_shared.network_preset import apply_network_preset, load_network_preset
def main():
    cfg=load_network_preset()
    written=apply_network_preset(cfg)
    print(f"kyth-apply-network: wrote {written[0]} doh={cfg['doh']} dns={cfg['dns']}")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
