#!/usr/bin/env python3
"""kyth-game-launch — single transactional game launcher (supersedes game-performance + kyth-game-boost startscript)."""
from __future__ import annotations
import os, shutil, sys, subprocess
from pathlib import Path

def log(m): print(f"[kyth-game-launch] {m}")

def main():
    args = sys.argv[1:]
    # parse --no-gamemode, -p profile, -- wrapper
    use_gamemode = True
    profile = "gaming"
    cmd_start = 0
    i=0
    while i < len(args):
        if args[i] in ("--no-gamemode",):
            use_gamemode=False; i+=1
        elif args[i] in ("-p","--profile") and i+1 < len(args):
            profile=args[i+1]; i+=2
        elif args[i]=="--":
            cmd_start=i+1; break
        elif args[i].startswith("-"):
            i+=1
        else:
            cmd_start=i; break
    cmd = args[cmd_start:] if cmd_start < len(args) else []
    if not cmd:
        # status mode when no cmd: show arbiter
        try:
            from kyth_shared.sched_arbiter import _desired_state; import json; print(json.dumps(_desired_state(), indent=2))
        except Exception: pass
        print("Usage: kyth-game-launch [--no-gamemode] [-p gaming] -- <cmd>")
        return 0 if not args else 1
    # mark gaming hint for readahead
    try:
        Path("/run/kyth").mkdir(parents=True, exist_ok=True)
        Path("/run/kyth/gaming-hint").write_text("1")
        if shutil.which("kyth-readahead-hint"):
            subprocess.run(["kyth-readahead-hint","apply"], check=False, timeout=2)
    except Exception: pass
    # ensure arbiter
    try:
        from kyth_shared.sched_arbiter import generate_arbiter; generate_arbiter()
    except Exception: pass
    # power profile via arbiter/gaming master already, just ensure performance
    # wrap with gamemoderun if requested
    run_cmd = cmd
    if use_gamemode and shutil.which("gamemoderun"):
        run_cmd = ["gamemoderun"] + run_cmd
    # prefer slice
    if shutil.which("systemd-run"):
        try:
            use_user = os.geteuid()!=0 and Path("/run/systemd/system").exists()
            base = ["systemd-run","--user","--scope","--slice=gaming.slice"] if use_user else ["systemd-run","--scope","--slice=gaming.slice"]
            os.execvp(base[0], base+["--"]+run_cmd)
        except Exception: pass
    try:
        os.execvp(run_cmd[0], run_cmd)
    except Exception as e:
        print(f"exec failed: {e}", file=sys.stderr); 
        # cleanup hint
        try: Path("/run/kyth/gaming-hint").unlink(missing_ok=True)
        except Exception: pass
        return 127
    return 0

if __name__=="__main__":
    sys.exit(main())
