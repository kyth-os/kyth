[Unit]
Description=Kyth storage maintenance (gated scrub+balance+duperemove)
ConditionACPower=true
After=local-fs.target

[Service]
Type=oneshot
StateDirectory=kyth/duperemove
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ExecCondition=/usr/libexec/kyth-storage-gate
ExecStart=/usr/bin/kyth-btrfs-maint
ExecStart=/usr/bin/kyth-duperemove
Nice=19
IOSchedulingClass=idle

MemoryMax=512M

[Install]
WantedBy=multi-user.target
