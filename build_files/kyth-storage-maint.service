[Unit]
Description=Kyth storage maintenance (gated scrub+balance+duperemove)
ConditionACPower=true
After=local-fs.target

[Service]
Type=oneshot
StateDirectory=kyth/duperemove
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ExecCondition=/usr/libexec/kyth-storage-gate
ExecStart=/usr/bin/kyth-btrfs-maint
ExecStart=/usr/bin/kyth-duperemove
Nice=19
IOSchedulingClass=idle
MemoryHigh=384M
MemoryMax=768M
TimeoutStartSec=3600

# Timer-activated only. WantedBy=multi-user.target would run a 1h scrub
# on every boot when someone enables the service instead of the timer.
