#!/usr/bin/env python3
"""kyth-refresh-taskbar-pins wrapper."""
import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    here = Path(__file__).resolve().parent
    candidate = here / "kyth_shared"
    if (candidate / "kyth_shared").is_dir():
        path = str(candidate)
        if path not in sys.path:
            sys.path.insert(0, path)


_ensure_kyth_shared_path()
from kyth_shared.desktop.plasma import refresh_taskbar_pins  # noqa: E402


def main() -> None:
    sys.exit(refresh_taskbar_pins())


if __name__ == "__main__":
    main()
