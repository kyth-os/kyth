[Unit]
Description=Add Flathub remote for Flatpak
Documentation=https://github.com/mrtrick37/kyth
After=network-online.target
# Requires= (not just Wants=) so systemd does not start this service when
# there is no network — Wants= is advisory and allows the unit to start even
# if network-online never becomes active (e.g. offline boot).
Requires=network-online.target
# Flatpak remotes live in /var — only configurable at runtime, not build time.
# This service is idempotent: --if-not-exists means it exits immediately if
# Flathub is already configured (e.g. after the first successful run).

[Service]
# oneshot (not simple) so kyth-default-flatpaks.service, ordered After= this
# unit, waits for the Flathub remote to actually exist. With Type=simple,
# "started" means "exec'd", and both units raced DNS at boot and failed.
Type=oneshot
RemainAfterExit=yes
# Retry inside ExecStart: DNS can lag network-online at first boot, and
# Restart= is not allowed on oneshot units with RemainAfterExit=yes.
ExecStart=/bin/sh -c 'for i in $(seq 1 18); do flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo && exit 0; sleep 10; done; exit 1'
TimeoutStartSec=300
# Mostly sleeping in the retry loop above, but can span minutes at boot —
# deprioritized so it never competes with early login for cycles.
Nice=15
IOSchedulingClass=idle
MemoryMax=384M
PrivateTmp=yes
PrivateUsers=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
[Install]
WantedBy=multi-user.target
