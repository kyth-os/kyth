#!/usr/bin/env python3
"""kyth-apply-rgb — apply rgb.toml via openrgb/liquidctl (offline)."""
from kyth_shared.rgb_preset import load_rgb
from kyth_shared.commands import run
def main():
    devs=load_rgb()
    for dev, e in devs.items():
        # best-effort: openrgb --device X --mode Y --brightness N
        try:
            run(["openrgb","--device", dev, "--mode", e["effect"], "--brightness", str(e["brightness"])], capture_output=True, timeout=5)
        except Exception:
            pass
        try:
            run(["liquidctl","--match", dev, "set", "led", "color", e["color"]], capture_output=True, timeout=5)
        except Exception:
            pass
    print(f"kyth-apply-rgb: {len(devs)} devices")
    return 0
if __name__=="__main__":
    import sys; sys.exit(main())
