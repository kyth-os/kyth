#!/bin/bash
# kyth-launch-installer — narrow native installer session launcher.
#
# This script is only a desktop-session orchestrator. The Rust daemon owns the
# authenticated API and all installation operations; the unprivileged Rust
# shell owns the UI. No Python package, browser fallback, arbitrary command,
# or user-supplied launcher argument is accepted here.

set -euo pipefail

if [ "$#" -ne 0 ]; then
	exit 64
fi

if [ "$(id -u)" -ne 0 ]; then
	if /usr/bin/sudo -n -- /usr/bin/kyth-launch-installer; then
		exit 0
	fi
	msg="KythOS installer could not obtain its native root session."
	command -v kdialog >/dev/null 2>&1 && kdialog --error "${msg}" || true
	command -v zenity >/dev/null 2>&1 && zenity --error --text "${msg}" || true
	exit 1
fi

LAUNCH_DIR="/run/kyth-installer"
SOCKET_PATH="${LAUNCH_DIR}/api.sock"
TOKEN_FILE="${LAUNCH_DIR}/session-token"
LAUNCH_LOG="${LAUNCH_DIR}/launcher.log"

session_user="${SUDO_USER:-}"
if [ -z "${session_user}" ] || [ "${session_user}" = root ]; then
	if [ -n "${PKEXEC_UID:-}" ]; then
		session_user="$(/usr/bin/getent passwd "${PKEXEC_UID}" | /usr/bin/cut -d: -f1)"
	fi
fi
if [ -z "${session_user}" ] || [ "${session_user}" = root ] || ! /usr/bin/id -u "${session_user}" >/dev/null 2>&1; then
	exit 1
fi

session_uid="$(/usr/bin/id -u "${session_user}")"
session_gid="$(/usr/bin/id -g "${session_user}")"
session_home="$(/usr/bin/getent passwd "${session_user}" | /usr/bin/cut -d: -f6)"
CLIENT_TOKEN_DIR="${LAUNCH_DIR}/client-${session_uid}"
CLIENT_TOKEN_FILE="${CLIENT_TOKEN_DIR}/tokens.json"
CLIENT_TOKEN_TMP="${CLIENT_TOKEN_FILE}.$$"
if [ -z "${session_home}" ] || [ "${session_uid}" -eq 0 ]; then
	exit 1
fi

# The image/source values are root-owned build artifacts. The native daemon
# reads them from its EnvironmentFile; the UI does not get to override them.
# shellcheck source=/dev/null
if [ -f /etc/kyth-installer.env ]; then
	. /etc/kyth-installer.env
fi
KYTH_SOURCE_IMAGE="${KYTH_SOURCE_IMAGE:-ghcr.io/kyth-os/kyth:latest}"
KYTH_TARGET_IMAGE="${KYTH_TARGET_IMAGE:-${KYTH_SOURCE_IMAGE}}"
KYTH_SOURCE_DIGEST="${KYTH_SOURCE_DIGEST:-}"

umask 077
/usr/bin/install -d -m 0750 -o root -g liveuser "${LAUNCH_DIR}"
# Serialize installer sessions: rotating the token for a second shell would
# invalidate the first shell's authentication and restarting the daemon could
# interrupt its install. The lock is held through the child shell lifetime.
exec 9>/run/lock/kyth-installer.lock
if ! /usr/bin/flock -n 9; then
	msg="The KythOS installer is already running. Return to the open installer window."
	command -v kdialog >/dev/null 2>&1 && kdialog --error "${msg}" || true
	command -v zenity >/dev/null 2>&1 && zenity --error --text "${msg}" || true
	exit 1
fi
# The session token below is 0600 owned by the session user; the live-session
# UID remains the trust boundary while the installer is running.
session_token="$(/usr/bin/openssl rand -hex 32)"
token_tmp="${TOKEN_FILE}.$$"
printf '%s' "${session_token}" > "${token_tmp}"
/usr/bin/chmod 0600 "${token_tmp}"
/usr/bin/mv -fT -- "${token_tmp}" "${TOKEN_FILE}"
/usr/bin/install -d -m 0700 -o "${session_user}" -g "${session_gid}" "${CLIENT_TOKEN_DIR}"
/usr/bin/printf '{"bootstrap_token":"","session_token":"%s"}\n' "${session_token}" > "${CLIENT_TOKEN_TMP}"
/usr/bin/chown "${session_user}:${session_gid}" "${CLIENT_TOKEN_TMP}"
/usr/bin/chmod 0600 "${CLIENT_TOKEN_TMP}"
/usr/bin/mv -fT -- "${CLIENT_TOKEN_TMP}" "${CLIENT_TOKEN_FILE}"

cleanup() {
	/usr/bin/systemctl stop kyth-installerd.service >/dev/null 2>&1 || true
	/usr/bin/rm -f -- "${TOKEN_FILE}" "${token_tmp}" "${CLIENT_TOKEN_FILE}" "${CLIENT_TOKEN_TMP}"
	/usr/bin/rmdir -- "${CLIENT_TOKEN_DIR}" 2>/dev/null || true
	unset session_token
}
trap cleanup EXIT HUP INT TERM

{
	echo ""
	echo "=== $(/usr/bin/date -Is) ==="
	echo "native launcher uid=$(id -u) session_user=${session_user}"
} >> "${LAUNCH_LOG}" 2>&1

# Always reload the daemon after writing this launch's token. `systemctl start`
# is a no-op for an already-active daemon, which would keep an old token and
# answer the new shell's first request with 403 Forbidden.
/usr/bin/systemctl restart kyth-installerd.service >> "${LAUNCH_LOG}" 2>&1
/usr/bin/systemctl is-active --quiet kyth-installerd.service

/usr/sbin/runuser -u "${session_user}" -- /usr/bin/env \
	HOME="${session_home}" \
	USER="${session_user}" \
	LOGNAME="${session_user}" \
	DISPLAY="${DISPLAY:-}" \
	WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
	XAUTHORITY="${XAUTHORITY:-}" \
	XDG_RUNTIME_DIR="/run/user/${session_uid}" \
	DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/${session_uid}/bus}" \
	XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}" \
	LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-}" \
	GALLIUM_DRIVER="${GALLIUM_DRIVER:-}" \
	MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-}" \
	QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-}" \
	KYTH_SOURCE_IMAGE="${KYTH_SOURCE_IMAGE}" \
	KYTH_TARGET_IMAGE="${KYTH_TARGET_IMAGE}" \
	KYTH_SOURCE_DIGEST="${KYTH_SOURCE_DIGEST}" \
	KYTH_INSTALLER_SOCKET="${SOCKET_PATH}" \
	/usr/bin/kyth-installer-shell --socket-path "${SOCKET_PATH}" --tokens-file "${CLIENT_TOKEN_FILE}" >> "${LAUNCH_LOG}" 2>&1
