[Unit]
Description=KythOS unattended VM acceptance guest
After=network-online.target
Wants=network-online.target
# QEMU fw_cfg acceptance flag; the guest binary also checks this itself.
ConditionPathExists=/sys/firmware/qemu_fw_cfg/by_name/kyth/acceptance/raw

[Service]
Type=oneshot
# The guest executable owns the fw_cfg enablement check. Keeping it out of an
# ExecCondition avoids a boot-order race where systemd evaluates the condition
# before QEMU exposes the acceptance flag and permanently skips this oneshot.
ExecStart=/usr/libexec/kyth-vm-acceptance-guest run
TimeoutStartSec=1800
MemoryMax=4G
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
