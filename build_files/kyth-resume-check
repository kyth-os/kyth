#!/usr/bin/env python3
"""Read-only suspend/resume confidence check."""
from __future__ import annotations

from pathlib import Path

from kyth_shared.diagnostics import DiagnosticReporter  # noqa: E402
from kyth_shared.commands import DEFAULT_RUNNER  # noqa: E402
from kyth_shared.runtime_diagnostics import (  # noqa: E402
    check_gpu_detected,
    check_loginctl,
    check_services as check_systemd_services,
    check_vulkan,
)


def check_network(reporter: DiagnosticReporter) -> None:
    if reporter.have("nmcli"):
        state = DEFAULT_RUNNER.stdout(["nmcli", "-t", "-f", "STATE", "general"])
        if state.startswith("connected"):
            reporter.pass_check("Network", state)
        else:
            reporter.warn_check("Network", state or "unknown")
    else:
        reporter.warn_check("Network", "nmcli unavailable")


def check_services(reporter: DiagnosticReporter) -> None:
    check_systemd_services(
        reporter,
        (
            ("pipewire.service", True),
            ("wireplumber.service", True),
            ("bluetooth.service", False),
        ),
    )


def check_bluetooth_adapter(reporter: DiagnosticReporter) -> None:
    bt_dir = Path("/sys/class/bluetooth")
    if bt_dir.is_dir() and list(bt_dir.glob("hci*")):
        reporter.pass_check("Bluetooth adapter", "controller present")
    else:
        reporter.warn_check("Bluetooth adapter", "no hci controller visible")


def check_displays(reporter: DiagnosticReporter) -> None:
    if reporter.have("kscreen-doctor"):
        output = DEFAULT_RUNNER.stdout(["kscreen-doctor", "-o"])
        # Count lines containing ' connected'
        connected_count = sum(1 for line in output.splitlines() if " connected" in line)
        if connected_count > 0:
            reporter.pass_check("Displays", f"{connected_count} connected output(s)")
        else:
            reporter.warn_check("Displays", "no connected output reported")
    else:
        reporter.warn_check("Displays", "kscreen-doctor unavailable")


def check_journal_errors(reporter: DiagnosticReporter) -> None:
    if reporter.have("journalctl"):
        res = DEFAULT_RUNNER.text(
            ["journalctl", "-b", "--since", "-10 minutes", "-p", "err", "--no-pager"],
        )
        if res is not None and res.returncode == 0:
            keywords = ("amdgpu", "nvidia", "i915", "xe", "bluetooth", "networkmanager", "pipewire", "wireplumber", "kwin")
            err_lines = [
                line for line in res.stdout.splitlines()
                if any(kw in line.lower() for kw in keywords)
            ]
            if not err_lines:
                reporter.pass_check("Recent critical logs", "no matching errors in last 10 minutes")
            else:
                reporter.warn_check("Recent critical logs", f"{len(err_lines)} matching error(s) in last 10 minutes")
        else:
            reporter.warn_check("Recent critical logs", "journalctl query failed")
    else:
        reporter.warn_check("Recent critical logs", "journalctl unavailable")


def main() -> None:
    reporter = DiagnosticReporter("Resume Check")
    reporter.print_header()

    check_loginctl(reporter)
    check_network(reporter)
    check_services(reporter)
    check_bluetooth_adapter(reporter)
    check_gpu_detected(reporter)
    check_vulkan(reporter, warning="failed after resume")
    check_displays(reporter)
    check_journal_errors(reporter)

    reporter.print_result("resume readiness")


if __name__ == "__main__":
    main()
