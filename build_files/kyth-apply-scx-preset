#!/usr/bin/env python3
"""kyth-apply-scx-preset — apply scx.toml explicit per-game (offline)."""
from kyth_shared.scx_preset import load_scx_preset
from pathlib import Path
def main():
    presets=load_scx_preset()
    if not presets:
        print("kyth-apply-scx-preset: no games"); return 0
    # For now apply first explicit (gaming.slice already handles per-app, this writes loader for manual)
    # Write generic loader for demonstrative (explicit wins)
    dest=Path("/etc/scx/scx_loader.conf")
    dest.parent.mkdir(parents=True, exist_ok=True)
    # pick most recent game scx if any
    scx=list(presets.values())[0]
    if scx!="none":
        dest.write_text(f"SCX_SCHEDULER={scx}\n# per-game explicit\n", encoding="utf-8")
    print(f"kyth-apply-scx-preset: {len(presets)} games → {scx}")
    return 0
if __name__=="__main__":
    import sys; sys.exit(main())
