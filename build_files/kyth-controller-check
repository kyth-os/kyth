#!/usr/bin/env python3
"""Read-only controller readiness check for KythOS gaming validation."""
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.diagnostics import DiagnosticReporter  # noqa: E402


def find_controllers() -> list[str]:
    controllers = []
    dev_input = Path("/dev/input")
    if not dev_input.is_dir():
        return controllers

    for path in sorted(dev_input.glob("event*")):
        res = subprocess.run(
            ["udevadm", "info", "--query=property", "--name", str(path)],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            continue
        props = res.stdout

        name = None
        for prop in ("ID_MODEL_FROM_DATABASE", "ID_MODEL", "NAME"):
            m = re.search(rf"^{prop}=(.*)$", props, re.MULTILINE)
            if m:
                name = m.group(1).strip()
                # strip surrounding quotes if any
                if name.startswith('"') and name.endswith('"'):
                    name = name[1:-1]
                break

        check_str = f"{name or ''} {props}".lower()
        keywords = ("joystick", "gamepad", "xbox", "dualsense", "dualshock", "playstation", "controller")
        if any(kw in check_str for kw in keywords):
            controllers.append(f"{path} {name or 'controller'}")

    return controllers


def main() -> None:
    reporter = DiagnosticReporter("Controller Check")
    reporter.print_header()

    if Path("/dev/input").is_dir():
        reporter.pass_check("Input subsystem", "/dev/input present")
    else:
        reporter.fail_check("Input subsystem", "/dev/input missing")

    controllers = []
    if reporter.have("udevadm"):
        controllers = find_controllers()

    if controllers:
        reporter.pass_check("Controller detected", controllers[0])
        for extra in controllers[1:]:
            print(f"      {extra}")
    else:
        reporter.warn_check("Controller detected", "none found; plug in or pair a controller and rerun")

    if reporter.have("bluetoothctl"):
        bt_res = subprocess.run(["bluetoothctl", "devices"], capture_output=True, text=True, check=False)
        bt_devices = bt_res.stdout
        matches = [
            line for line in bt_devices.splitlines()
            if any(kw in line.lower() for kw in ("xbox", "dualsense", "dualshock", "wireless controller", "8bitdo", "controller"))
        ]
        if matches:
            reporter.pass_check("Bluetooth controller", matches[0].strip())
        else:
            reporter.warn_check("Bluetooth controller", "no paired controller-like Bluetooth device found")
    else:
        reporter.warn_check("Bluetooth controller", "bluetoothctl unavailable")

    if reporter.have("steam-devices"):
        reporter.pass_check("Steam devices rules", "steam-devices command present")
    else:
        rpm_res = subprocess.run(["rpm", "-q", "steam-devices"], capture_output=True, check=False)
        if rpm_res.returncode == 0:
            reporter.pass_check("Steam devices rules", "steam-devices package installed")
        else:
            reporter.warn_check("Steam devices rules", "steam-devices package not detected")

    if Path("/dev/uinput").exists():
        reporter.pass_check("uinput", "/dev/uinput present")
    else:
        reporter.warn_check("uinput", "/dev/uinput missing; some remappers may not work")

    if reporter.have("flatpak"):
        fp_res = subprocess.run(["flatpak", "info", "com.valvesoftware.Steam"], capture_output=True, check=False)
        if fp_res.returncode == 0:
            reporter.pass_check("Steam", "installed")
        else:
            reporter.warn_check("Steam", "not installed")
    else:
        reporter.warn_check("Steam", "flatpak command not found")

    reporter.print_result("controller readiness")


if __name__ == "__main__":
    main()
