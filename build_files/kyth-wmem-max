#!/usr/bin/env bash
# kyth-wmem-max — 16777216 gaming
set -euo pipefail
need_root(){ [[ $EUID -eq 0 ]] || exec sudo -A /usr/bin/kyth-wmem-max "$@"; }
case "${1:-status}" in
    status) python3 -c "from kyth_shared.wmem_max import load_wmem_max, wmem_max_status; c=load_wmem_max(); print(f\"profile={c['profile']} active={wmem_max_status()}\")" ;;
    gaming) need_root "$@"; python3 -c "from kyth_shared.wmem_max import load_wmem_max,save_wmem_max,generate_wmem_max; c=load_wmem_max(); c['profile']='gaming'; save_wmem_max(c); generate_wmem_max(c)"; sysctl --system >/dev/null 2>&1 || true; echo "wmem max gaming 16777216" ;;
    balanced) need_root "$@"; python3 -c "from kyth_shared.wmem_max import load_wmem_max,save_wmem_max,generate_wmem_max; c=load_wmem_max(); c['profile']='balanced'; save_wmem_max(c); generate_wmem_max(c)"; echo "wmem max balanced" ;;
    apply) need_root "$@"; python3 -c "from kyth_shared.wmem_max import load_wmem_max,generate_wmem_max; generate_wmem_max(load_wmem_max())" ;;
    *) echo "Usage: kyth-wmem-max [status|gaming|balanced|apply]" >&2; exit 1 ;;
esac
