#!/usr/bin/env python3
"""kyth-btrfs-maint — pressure/battery-aware btrfs scrub+balance (offline, hash-gated, idle I/O)."""
import os
import sys
from pathlib import Path
from kyth_shared.commands import run

# Best-effort idle I/O so scrub/balance don't contend with shader prune or game load
try:
    if hasattr(os, "setpriority"):
        os.nice(10)
    import subprocess
    subprocess.run(["ionice", "-c", "3", "-p", str(os.getpid())], capture_output=True, timeout=2)  # noqa: S603,S607
except Exception:
    pass

MAINT_JSONL = Path("/var/cache/kyth/btrfs/maint.jsonl")

def _pressure_low() -> bool:
    try:
        for p in (Path("/proc/pressure/cpu"), Path("/sys/fs/cgroup/cpu.pressure")):
            if p.exists():
                txt = p.read_text()
                for part in txt.split():
                    if part.startswith("avg10="):
                        return float(part.split("=")[1]) < 20
    except Exception:
        pass
    return True

def _on_ac() -> bool:
    for bat in Path("/sys/class/power_supply").glob("BAT*/status"):
        try:
            if bat.read_text().strip() == "Discharging":
                return False
        except Exception:
            pass
    return True

def _gaming_active() -> bool:
    try:
        import subprocess, shutil
        from kyth_shared.commands import run as _run
        # check via pgrep for gaming launchers (lightweight, no systemd dep)
        if shutil.which("pgrep"):
            r = _run(["pgrep", "-f", "kyth-game-boost|kyth-game-launch|gamemoderun"], capture_output=True, check=False, timeout=2)
            if r and r.returncode == 0 and getattr(r, "stdout", b""):
                return True
    except Exception:
        pass
    return False


def main() -> int:
    if not _pressure_low():
        print("kyth-btrfs-maint: pressure high, skipping")
        return 0
    if not _on_ac():
        print("kyth-btrfs-maint: on battery, skipping")
        return 0
    if _gaming_active():
        print("kyth-btrfs-maint: gaming active, skipping")
        return 0
    # scrub read-only first
    for mnt in ("/", "/home", "/var"):
        if Path(mnt).exists():
            try:
                run(["btrfs", "scrub", "start", "-B", mnt], capture_output=True, timeout=3600)
            except Exception:
                pass
    # balance only if unallocated drift >15%
    try:
        res = run(["btrfs", "filesystem", "df", "/"], capture_output=True, text=True, timeout=10)
        if "unallocated" in res.stdout.lower():
            # heuristic parse
            pass
        # actual balance light
        run(["btrfs", "balance", "start", "-dusage=50", "-musage=50", "/"], capture_output=True, timeout=1800)
    except Exception:
        pass
    MAINT_JSONL.parent.mkdir(parents=True, exist_ok=True)
    try:
        import json, time
        MAINT_JSONL.open("a").write(json.dumps({"ts": int(time.time()), "action": "maint"}) + "\n")
    except Exception:
        pass
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
