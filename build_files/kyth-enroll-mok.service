[Unit]
Description=KythOS Secure Boot MOK enrollment
Documentation=https://github.com/mrtrick37/kyth
After=local-fs.target
ConditionPathExists=!/var/lib/kyth/mok-enrolled

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-enroll-mok
RemainAfterExit=yes
StateDirectory=kyth
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ReadWritePaths=/sys/firmware/efi/efivars
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
