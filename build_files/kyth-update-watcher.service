[Unit]
Description=KythOS intelligent update watcher (oneshot)
Documentation=https://github.com/kyth-os/kyth
After=network-online.target
Wants=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-update-watcher
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kyth-update-watcher
# Runs as root; bootc upgrade requires it
User=root
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_ADMIN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CacheDirectory=kyth
CacheDirectoryMode=0700

# Give the upgrade plenty of time (large container layers on slow connections)
TimeoutStartSec=2400
# Keep automatic staging from competing with the foreground desktop.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=512M
MemoryMax=768M
