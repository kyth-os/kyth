#!/usr/bin/env python3
"""kyth-apply-tailscale — tailscale up per tailscale.toml (offline)."""
from kyth_shared.tailscale_preset import load_tailscale
from kyth_shared.commands import run
def main():
    cfg=load_tailscale()
    if not cfg["tailnet"]:
        print("kyth-apply-tailscale: no tailnet, skipping"); return 0
    args=["tailscale","up"]
    if cfg["exit_node"]:
        args+=["--exit-node", cfg["exit_node"]]
    if cfg["accept_routes"]:
        args+=["--accept-routes"]
    try:
        run(args, capture_output=True, timeout=10)
    except Exception:
        pass
    print(f"kyth-apply-tailscale: tailnet {cfg['tailnet']}")
    return 0
if __name__=="__main__":
    import sys; sys.exit(main())
