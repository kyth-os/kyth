#!/usr/bin/env python3
"""kyth-configure-session — keep SDDM on Plasma Wayland across upgrades.

Older images wrote DisplayServer=x11 into /etc/sddm.conf.d/11-kyth-session.conf
for VMs or nomodeset, and SDDM may still remember LastSession=plasmax11 in
/var/lib/sddm/state.conf or ~/.dmrc. Those locally modified files survive
bootc updates unless this ExecStartPre overwrites them. Software-compose
rescue (including nomodeset) is handled by kyth-sddm-compositor.

Fail-open: a write error logs a warning and returns 0 so ExecStartPre cannot
block the greeter. ``10-kyth.conf`` still provides the Wayland default.
"""
from __future__ import annotations

import sys
from pathlib import Path

from kyth_shared.wayland_compose import (
    SDDM_STATE_FILE,
    migrate_home_dmrcs,
    migrate_sddm_last_session,
    sddm_session_conf,
)


def configure_session(sddm_dir: Path | None = None, cmdline: str | None = None) -> int:
    directory = Path(sddm_dir) if sddm_dir is not None else Path("/etc/sddm.conf.d")
    try:
        directory.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        print(f"Warning: could not create {directory}: {exc}", file=sys.stderr)
        return 0
    conf_file = directory / "11-kyth-session.conf"
    try:
        conf_file.write_text(sddm_session_conf(cmdline), encoding="utf-8")
    except OSError as exc:
        print(f"Warning: could not write {conf_file}: {exc}", file=sys.stderr)
        return 0
    return 0


def configure_host_session(
    sddm_dir: Path | None = None,
    cmdline: str | None = None,
    *,
    state_file: Path | None = None,
    homes: Path | None = None,
) -> int:
    """Wayland drop-in plus leftover LastSession / ~/.dmrc X11 values.

    Fail-open: migration errors are warnings. Login must not be blocked.
    """
    configure_session(sddm_dir, cmdline)
    try:
        migrate_sddm_last_session(state_file or SDDM_STATE_FILE)
    except OSError as exc:
        print(f"Warning: could not migrate SDDM last session: {exc}", file=sys.stderr)
    try:
        migrate_home_dmrcs(homes or Path("/home"))
    except OSError as exc:
        print(f"Warning: could not migrate user session files: {exc}", file=sys.stderr)
    return 0


def main() -> None:
    sys.exit(configure_host_session())


if __name__ == "__main__":
    main()
