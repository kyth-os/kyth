#!/usr/bin/env python3
"""kyth-setup-devcontainer — create distrobox from devcontainers.toml (offline)."""
import sys
from kyth_shared.devcontainers import load_devcontainers
from kyth_shared.commands import run
def main():
    boxes=load_devcontainers()
    if not boxes:
        print("kyth-setup-devcontainer: no containers in devcontainers.toml"); return 0
    for name, e in boxes.items():
        img=e["image"]
        print(f"kyth-setup-devcontainer: {name} → {img}")
        # best-effort: distrobox create --image
        run(["distrobox","create","--name", name, "--image", img, "--yes"], capture_output=True, timeout=120)
    return 0
if __name__=="__main__":
    raise SystemExit(main())
