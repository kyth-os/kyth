[Unit]
Description=KythOS User Comfort Polish Setup
Documentation=https://github.com/kyth-os/kyth
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-user-polish
RemainAfterExit=yes
# Sandboxing: user-context first-login polish. Needs $HOME writes; ProtectHome
# is intentionally not applied.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=384M
TimeoutStartSec=60

[Install]
WantedBy=graphical-session.target
