[Unit]
Description=KythOS user probe cache refresh (oneshot)
Documentation=https://github.com/mrtrick37/kyth
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-probe
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kyth-probe
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=384M
MemoryMax=512M
TimeoutStartSec=120
PrivateTmp=yes
# NoNewPrivileges deliberately absent: runs per-user (graphical-session.target) and its
# bootc collector shells out to `sudo -n kyth-bootc-guard status-json`
# (probe.py::_collect_bootc via kyth_shared/system/bootc_query.py). NNP
# blocks the kernel from honoring sudo's setuid bit at exec for this
# non-root caller outright — "unable to open /etc/sudoers: Invalid
# argument" — leaving the per-user bootc status cache permanently empty.
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
CacheDirectory=kyth
CacheDirectoryMode=0700

[Install]
WantedBy=graphical-session.target
