#!/usr/bin/env python3
"""kyth-apply-vrr — apply vrr.toml (VRR + Night Color) to KWin."""
from __future__ import annotations

import sys

from kyth_shared.vrr import apply_vrr


def main() -> int:
    notes = apply_vrr()
    print(f"kyth-apply-vrr: {'; '.join(notes) if notes else 'nothing to apply'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
