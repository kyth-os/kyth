#!/usr/bin/env bash
# kyth-distrobox-cache — distrobox-cache.toml
set -euo pipefail
need_root(){ [[ $EUID -eq 0 ]] || exec sudo -A /usr/bin/kyth-distrobox-cache "$@"; }
case "${1:-status}" in
    status) python3 -c 'from kyth_shared.distrobox_cache import load_distrobox_cache,distrobox_cache_status; c=load_distrobox_cache(); print(f"enabled={c[\"enabled\"]} size={c[\"size\"]} active={distrobox_cache_status()}")' ;;
    on) need_root "$@"; python3 -c 'from kyth_shared.distrobox_cache import load_distrobox_cache,save_distrobox_cache,generate_distrobox_cache; c=load_distrobox_cache(); c["enabled"]=True; save_distrobox_cache(c); generate_distrobox_cache(c)'; systemctl enable --now kyth-distrobox-cache.service 2>/dev/null || true; echo "distrobox cache on" ;;
    off) need_root "$@"; python3 -c 'from kyth_shared.distrobox_cache import load_distrobox_cache,save_distrobox_cache,generate_distrobox_cache; c=load_distrobox_cache(); c["enabled"]=False; save_distrobox_cache(c); generate_distrobox_cache(c)'; systemctl disable --now kyth-distrobox-cache.service 2>/dev/null || true; echo "distrobox cache off" ;;
    apply) need_root "$@"; python3 -c 'from kyth_shared.distrobox_cache import load_distrobox_cache,generate_distrobox_cache; generate_distrobox_cache(load_distrobox_cache())' ;;
    *) echo "Usage: kyth-distrobox-cache [status|on|off|apply]" >&2; exit 1 ;;
esac
