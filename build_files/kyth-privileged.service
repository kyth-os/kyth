[Unit]
Description=Kyth allowlisted privileged action service
Documentation=https://github.com/kyth-os/kyth
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/kyth-privileged
User=root
Group=wheel
RuntimeDirectory=kyth
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
CapabilityBoundingSet=
ReadWritePaths=/run/kyth
ReadWritePaths=/var/log/kyth
TimeoutStartSec=10

[Install]
WantedBy=multi-user.target
