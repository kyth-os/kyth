[Unit]
Description=Kyth allowlisted privileged action service
Documentation=https://github.com/kyth-os/kyth
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/kyth-privileged
User=root
Group=wheel
RuntimeDirectory=kyth
RuntimeDirectoryMode=0750
LogsDirectory=kyth
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
# ProtectSystem=strict makes the whole tree read-only and the AF_UNIX-only
# filter blocks network access. The flatpak_update operation runs
# `flatpak update --system -y` as root, which (unlike the unprivileged CLI)
# does not delegate to flatpak-system-helper: without a writable
# /var/lib/flatpak and inet families it silently exits 0 having updated
# nothing, so the Hub reports success while system updates stay pending.
ReadWritePaths=/run/kyth -/var/lib/flatpak
TimeoutStartSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
