#!/usr/bin/env python3
"""Read-only creator and OBS media stack readiness check."""
from __future__ import annotations

import subprocess
from kyth_shared.commands import DEFAULT_RUNNER
from kyth_shared.diagnostics import DiagnosticReporter


def main() -> None:
    reporter = DiagnosticReporter("Creator Check")
    reporter.print_header()

    # Audio & Video Stack
    if reporter.have("pipewire"):
        res = DEFAULT_RUNNER.stdout(["pipewire", "--version"])
        reporter.pass_check("PipeWire", res.splitlines()[0] if res else "present")
    else:
        reporter.warn_check("PipeWire", "not detected")

    if reporter.have("wireplumber"):
        res = DEFAULT_RUNNER.stdout(["wireplumber", "--version"])
        reporter.pass_check("WirePlumber", res.splitlines()[0] if res else "present")
    else:
        reporter.warn_check("WirePlumber", "not detected")

    # OBS VKCapture
    rpm_res = subprocess.run(["rpm", "-q", "libobs_vkcapture"], capture_output=True, check=False)
    if rpm_res.returncode == 0:
        reporter.pass_check("OBS Vulkan Capture", "libobs_vkcapture installed")
    else:
        reporter.warn_check("OBS Vulkan Capture", "libobs_vkcapture not detected")

    # OBS Studio Flatpak
    if reporter.have("flatpak"):
        fp_res = subprocess.run(["flatpak", "info", "com.obsproject.Studio"], capture_output=True, check=False)
        if fp_res.returncode == 0:
            reporter.pass_check("OBS Studio Flatpak", "installed")
        else:
            reporter.warn_check("OBS Studio Flatpak", "not installed")
    else:
        reporter.warn_check("OBS Studio Flatpak", "flatpak command missing")

    # VA-API Codecs
    if reporter.have("vainfo"):
        va_res = subprocess.run(["vainfo"], capture_output=True, check=False)
        if va_res.returncode == 0:
            reporter.pass_check("VA-API Hardware Video", "hardware encoding/decoding available")
        else:
            reporter.warn_check("VA-API Hardware Video", "vainfo failed or software fallback active")
    else:
        reporter.warn_check("VA-API Hardware Video", "vainfo command missing")

    reporter.print_result("creator readiness")


if __name__ == "__main__":
    main()

