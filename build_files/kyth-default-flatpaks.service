[Unit]
Description=Install default Flatpak applications (Steam first boot; rest on-demand from Hub)
Documentation=https://github.com/kyth-os/kyth
# Wants= (not After=): this unit skips offline via the binary's own soft-fail
# below, so it must not block on network-online.target — without wait-online
# that target is instant anyway (see item 8), and with it this unit would
# stall boot on metered/slow links for one app.
Wants=network-online.target kyth-flathub-setup.service
After=kyth-flathub-setup.service
# P5: WantedBy=graphical.target, NOT multi-user.target. A multi-GB Steam
# pull (TimeoutStartSec=3600) on a oneshot unit ordered Before=
# multi-user.target held up the boot milestone; the install now happens in
# the background while the user logs in. kyth-flathub-setup.service stays
# on multi-user.target (it is quick and bounded), and After= above still
# orders this unit behind it.
# Sentinel is VERSIONED — bump the filename (v2 → v3, etc.) any time the app
# list changes. The old sentinel survives OS upgrades (it lives in /var which
# bootc never touches), so without versioning existing users never see new apps.
# Current version: v14 (Steam-only first boot; Lutris/Heroic/VLC/Brave/
# LibreOffice moved to on-demand Hub installs).
ConditionPathExists=!/var/lib/kyth/default-flatpaks-v14-done
# A gigabyte Steam pull on battery is a dead laptop: run on AC only. Skipped
# boots retry on the next AC boot (sentinel stays unset).
ConditionACPower=true

[Service]
Type=oneshot
# P5: the old pre-start flathub-setup check ran the same idempotent command
# kyth-flathub-setup.service (After= above) had just run — a redundant
# invocation that re-ran the DNS retry loop on offline boots. The binary
# below already fails soft (exit 0, sentinel unset, "will retry next boot")
# when Flathub is absent, so the extra condition bought nothing.
# --system  : install for all users (consistent with kyth-flathub-setup.service)
# --or-update: idempotent — updates if already present, installs if not
# First boot is Steam-only; the rest (Lutris, Heroic, VLC, Brave,
# LibreOffice) are one-click installs from the KythOS System Hub.
# Stamp only on full success. A flaky first-online pull must exit 0
# (no --failed entry) and leave the sentinel unset so the next boot retries.
# Legacy contract: will retry next boot when the remote is absent.
ExecStart=/usr/bin/kyth-runtime default-flatpaks
RemainAfterExit=yes
Nice=10
IOSchedulingClass=idle
MemoryMax=1G
TimeoutStartSec=3600
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
# P5: off the boot-critical path — see the WantedBy comment in [Unit].
WantedBy=graphical.target
