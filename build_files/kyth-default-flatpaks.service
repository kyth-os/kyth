[Unit]
Description=Install default Flatpak applications (GPU Screen Recorder, GOverlay, Vesktop, MissionCenter, VLC)
Documentation=https://github.com/mrtrick37/kyth
After=network-online.target kyth-flathub-setup.service
# Requires= (not just Wants=) so this service is skipped on offline boots
# rather than starting, failing, and leaving the sentinel file unwritten.
Requires=network-online.target kyth-flathub-setup.service
# Sentinel is VERSIONED — bump the filename (v2 → v3, etc.) any time the app
# list changes. The old sentinel survives OS upgrades (it lives in /var which
# bootc never touches), so without versioning existing users never see new apps.
