#!/usr/bin/env python3
"""kyth-health-check — Perform subsystem diagnostic probes."""
from __future__ import annotations

import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.diagnostics import DiagnosticReporter, run_health_checks  # noqa: E402


def main() -> None:
    reporter = DiagnosticReporter("Subsystem Health")
    reporter.print_header()
    run_health_checks(reporter)
    reporter.print_result(
        "Subsystem health",
        custom_warn_msg="System is running with some warning fallback configurations.",
    )


if __name__ == "__main__":
    main()
