#!/usr/bin/env bash
# Guest half of the unattended ISO -> install -> update -> rollback test.
# It is inert unless QEMU exposes opt/com.kyth/acceptance through fw_cfg.

set -euo pipefail

FW_CFG_ROOT=/sys/firmware/qemu_fw_cfg/by_name/opt/com.kyth
ENABLE_FILE="${FW_CFG_ROOT}/acceptance/raw"
UPDATE_FILE="${FW_CFG_ROOT}/update-ref/raw"
STATE_DIR=/var/lib/kyth/vm-acceptance
STATE_FILE="${STATE_DIR}/state"
SERIAL_DEVICE=/dev/ttyS0
LOG_FILE=/var/log/kyth-vm-acceptance.log
TARGET_BY_ID=/dev/disk/by-id/virtio-KYTH_ACCEPT

enabled() {
	[[ -r "${ENABLE_FILE}" ]] || return 1
	[[ "$(tr -d '\0\r\n' <"${ENABLE_FILE}")" == 1 ]]
}

emit() {
	local phase="$1"
	local detail="${2:-}"
	local line="KYTH_ACCEPTANCE:${phase}:${detail}"
	printf '%s\n' "${line}" | tee -a "${LOG_FILE}"
	if [[ -w "${SERIAL_DEVICE}" ]]; then
		printf '%s\n' "${line}" >"${SERIAL_DEVICE}"
	fi
}

fail() {
	local line="${1:-unknown failure}"
	emit FAILED "${line//$'\n'/ }"
	systemctl poweroff --no-block || true
	exit 1
}

wait_for_desktop() {
	local mode="$1"
	for _attempt in $(seq 1 90); do
		if [[ "${mode}" == live ]]; then
			pgrep -x plasmashell >/dev/null 2>&1 && return 0
		elif systemctl is-active --quiet display-manager.service; then
			return 0
		fi
		sleep 2
	done
	return 1
}

read_update_ref() {
	[[ -r "${UPDATE_FILE}" ]] || return 0
	tr -d '\0\r\n' <"${UPDATE_FILE}"
}

booted_digest() {
	bootc status --format json | python3 -c '
import json, sys
data = json.load(sys.stdin).get("status", {}).get("booted", {})
image = data.get("image", {})
print(image.get("imageDigest") or image.get("image", {}).get("imageDigest") or "")
'
}

deployment_count() {
	ostree admin status --json 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
deployments = data.get("deployments", data if isinstance(data, list) else [])
print(len(deployments))
' || printf '0\n'
}

run_smoke_check() {
	local phase="$1"
	local result=0
	/usr/bin/kyth-smoke-check --verbose >>"${LOG_FILE}" 2>&1 || result=$?
	cat "${LOG_FILE}" >"${SERIAL_DEVICE}" 2>/dev/null || true
	if (( result == 2 || result > 2 )); then
		fail "${phase} smoke check reported failed invariants (exit ${result})"
	fi
	emit "${phase}_SMOKE_OK" "warnings-allowed=${result}"
}

install_from_live_iso() {
	wait_for_desktop live || fail "live Plasma desktop did not become ready"
	emit LIVE_READY "plasmashell-active"
	run_smoke_check LIVE

	for _attempt in $(seq 1 60); do
		[[ -b "${TARGET_BY_ID}" ]] && break
		sleep 1
	done
	[[ -b "${TARGET_BY_ID}" ]] || fail "dedicated acceptance disk not found"

	local target source_ref target_ref update_ref
	target="$(readlink -f "${TARGET_BY_ID}")"
	[[ -b "${target}" ]] || fail "acceptance disk symlink did not resolve to a block device"
	# The ISO contains the exact OCI image under test; installation must not
	# silently drift to whatever a registry tag happens to reference.
	source_ref=oci:/usr/share/kyth/image:latest
	target_ref=ghcr.io/mrtrick37/kyth:testing
	if [[ -r /etc/kyth-installer.env ]]; then
		# shellcheck disable=SC1091
		source /etc/kyth-installer.env
		target_ref="${KYTH_TARGET_IMAGE:-${target_ref}}"
	fi
	[[ -d /usr/share/kyth/image ]] || fail "bundled OCI image is missing from live media"

	emit INSTALL_STARTED "${target}"
	bootc install to-disk \
		--source-imgref "${source_ref}" \
		--target-imgref "${target_ref}" \
		--filesystem btrfs \
		--wipe \
		--skip-fetch-check \
		"${target}" >>"${LOG_FILE}" 2>&1 || fail "bootc install to-disk failed"

	update_ref="$(read_update_ref)"
	if [[ -n "${update_ref}" ]] && ! [[ "${update_ref}" =~ ^[A-Za-z0-9._/@:+-]+$ ]]; then
		fail "update image reference contains unsupported characters"
	fi
	emit INSTALL_COMPLETE "${target_ref}"
	systemctl reboot --no-block
}

run_installed_lifecycle() {
	mkdir -p "${STATE_DIR}"
	local state update_ref initial_digest current_digest count
	state="$(cat "${STATE_FILE}" 2>/dev/null || printf fresh)"
	update_ref="$(read_update_ref)"
	wait_for_desktop installed || fail "installed display manager did not become ready"

	case "${state}" in
		fresh)
			emit INSTALLED_READY "display-manager-active"
			run_smoke_check INSTALLED
			initial_digest="$(booted_digest)"
			[[ -n "${initial_digest}" ]] || fail "could not read initial booted digest"
			printf '%s\n' "${initial_digest}" >"${STATE_DIR}/initial-digest"
			if [[ -z "${update_ref}" ]]; then
				emit COMPLETE "install-only"
				systemctl poweroff --no-block
				return
			fi
			printf 'update-staged\n' >"${STATE_FILE}"
			emit UPDATE_STARTED "${update_ref}"
			bootc switch "${update_ref}" >>"${LOG_FILE}" 2>&1 \
				|| fail "bootc switch failed"
			emit UPDATE_STAGED "${update_ref}"
			systemctl reboot --no-block
			;;
		update-staged)
			initial_digest="$(cat "${STATE_DIR}/initial-digest")"
			current_digest="$(booted_digest)"
			[[ -n "${current_digest}" && "${current_digest}" != "${initial_digest}" ]] \
				|| fail "updated deployment did not boot a different digest"
			count="$(deployment_count)"
			(( count >= 2 )) || fail "updated system does not expose a rollback deployment"
			emit UPDATE_BOOTED "${current_digest}"
			run_smoke_check UPDATE
			printf 'rollback-staged\n' >"${STATE_FILE}"
			bootc rollback >>"${LOG_FILE}" 2>&1 || fail "bootc rollback failed"
			emit ROLLBACK_STAGED "${initial_digest}"
			systemctl reboot --no-block
			;;
		rollback-staged)
			initial_digest="$(cat "${STATE_DIR}/initial-digest")"
			current_digest="$(booted_digest)"
			[[ -n "${current_digest}" && "${current_digest}" == "${initial_digest}" ]] \
				|| fail "rollback did not restore the initial deployment digest"
			emit ROLLBACK_BOOTED "${current_digest}"
			run_smoke_check ROLLBACK
			emit COMPLETE "update-and-rollback"
			rm -f "${STATE_FILE}"
			systemctl poweroff --no-block
			;;
		*) fail "unknown acceptance state: ${state}" ;;
	esac
}

case "${1:-}" in
	enabled) enabled ;;
	run)
		enabled || exit 0
		trap 'fail "guest command failed at line ${LINENO}"' ERR
		if [[ -r /etc/kyth-installer.env ]]; then
			install_from_live_iso
		else
			run_installed_lifecycle
		fi
		;;
	*) echo "Usage: $0 {enabled|run}" >&2; exit 64 ;;
esac
