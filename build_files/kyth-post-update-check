#!/usr/bin/env python3
"""Read-only confidence check shown once per booted deployment after login."""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

from kyth_shared.diagnostics import DiagnosticReporter  # noqa: E402
from kyth_shared.runtime_diagnostics import (  # noqa: E402
    check_deployment_rollback,
    check_gpu_modules,
    check_services,
    check_vulkan,
    deployment_id,
    is_live_image,
)
from kyth_shared.session import already_run, mark_run  # noqa: E402


def main() -> None:
    if is_live_image():
        sys.exit(0)

    parser = argparse.ArgumentParser(description="KythOS Post-Update Check")
    parser.add_argument("--force", action="store_true", help="Force execution")
    parser.add_argument("--no-notify", action="store_true", help="Do not trigger desktop notifications")
    args = parser.parse_args()

    # Onboarding wizard check
    welcome_done = Path("~/.config/kyth-welcome-done").expanduser()
    if not args.force and not welcome_done.exists():
        sys.exit(0)

    reporter = DiagnosticReporter("Post-Update Check")

    # Resolve deployment ID & stamp
    dep = deployment_id(reporter)
    sanitized_dep = re.sub(r"[^A-Za-z0-9_.-]", "_", dep)
    stamp_name = f"post-update-check-{sanitized_dep}"

    if not args.force and already_run(stamp_name):
        sys.exit(0)

    failures: list[str] = []
    warnings: list[str] = []

    # 1. Deployment tool check
    deployment_failures, deployment_warnings = check_deployment_rollback(reporter)
    failures.extend(deployment_failures)
    warnings.extend(deployment_warnings)

    # 2. GPU modules
    check_gpu_modules(reporter)

    # 3. Vulkan
    before_warnings = reporter.warnings
    check_vulkan(reporter, warning="failed after update")
    if reporter.warnings > before_warnings:
        warnings.append("Vulkan check failed after update.")

    # 4. Flatpak
    if not reporter.have("flatpak"):
        failures.append("Flatpak is missing.")

    # 5. PipeWire & WirePlumber
    service_results_before = len(reporter.results)
    check_services(reporter, (("pipewire.service", True), ("wireplumber.service", True)))
    for level, name, _message in reporter.results[service_results_before:]:
        if level == "WARN":
            warnings.append(f"{name} is not active in this login session.")

    # Format output/notify based on failures and warnings
    app_name = "KythOS Post-Update Check"
    if failures:
        title = f"{app_name}: needs attention"
        body = " ".join((failures + warnings)[:5])
        print(title)
        for f in failures:
            print(f"FAIL  {f}")
        for w in warnings:
            print(f"WARN  {w}")
        if not args.no_notify:
            reporter.notify(title, body or "Run ujust smoke-check for details.")
        sys.exit(2)

    if warnings:
        title = f"{app_name}: review recommended"
        body = " ".join(warnings[:5])
        print(title)
        for w in warnings:
            print(f"WARN  {w}")
        if not args.no_notify:
            reporter.notify(title, body or "Run ujust smoke-check for details.")
        mark_run(stamp_name)
        sys.exit(1)

    # All pass
    print(f"{app_name}: ready")
    print("PASS  Update looks healthy. Rollback is available, gaming services are present, and core desktop audio is active.")
    if args.force and not args.no_notify:
        reporter.notify(
            f"{app_name}: ready",
            "Update looks healthy. Rollback is available, gaming services are present, and core desktop audio is active.",
        )
    mark_run(stamp_name)
    sys.exit(0)


if __name__ == "__main__":
    main()
