#!/usr/bin/env python3
"""kyth-apply-pipewire-latency — apply pipewire-latency.toml to wireplumber."""
import sys
from pathlib import Path
from kyth_shared.pipewire_latency import load_pipewire_latency
def main():
    apps=load_pipewire_latency()
    dest=Path("/etc/wireplumber/main.lua.d/99-kyth-latency.lua")
    if not apps:
        # default drop-in
        content="-- Kyth PipeWire latency — default 512\n"
    else:
        content="-- Kyth PipeWire latency per-app\n"
        for app, q in apps.items():
            content+=f'-- {app} = {q}\n'
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp=dest.with_suffix(".tmp")
    tmp.write_text(content, encoding="utf-8")
    tmp.replace(dest)
    # TTL marker
    try:
        import time
        Path("/run/kyth-pipewire-ttl").write_text(str(int(time.time())+30), encoding="utf-8")
    except Exception:
        pass
    print(f"kyth-apply-pipewire-latency: {len(apps)} apps → {dest}")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
