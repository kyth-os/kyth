#!/usr/bin/env python3
"""kyth-apply-pipewire-latency — apply pipewire-latency.toml to PipeWire drop-ins."""
from __future__ import annotations

import sys

from kyth_shared.pipewire_latency import apply_pipewire_latency, load_pipewire_latency


def main() -> int:
    apps = load_pipewire_latency()
    notes = apply_pipewire_latency(apps)
    print(f"kyth-apply-pipewire-latency: {'; '.join(notes) if notes else 'nothing to apply'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
