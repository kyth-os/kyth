#!/usr/bin/env bash
# kyth-readahead-run — readahead then exec
set -euo pipefail
path=""
args=()
for a in "$@"; do
    if [[ "$a" == "--" ]]; then break; fi
    if [[ -z "$path" && "$a" != "--"* ]]; then path="$a"; fi
done
if [[ -n "$path" && -d "$path" ]]; then
    /usr/bin/kyth-readahead "$path" 2>/dev/null || true
fi
# find -- separator and exec remainder
found=0
for i in "$@"; do
    if [[ $found -eq 1 ]]; then args+=("$i"); fi
    if [[ "$i" == "--" ]]; then found=1; fi
done
if ((${#args[@]})); then exec "${args[@]}"; fi
if [[ -n "$path" && ! -d "$path" ]]; then exec "$path" "${@:2}"; fi
