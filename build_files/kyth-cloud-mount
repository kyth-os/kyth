#!/usr/bin/env python3
"""kyth-cloud-mount — rclone mount per cloud.toml (offline, user)."""
import sys
from pathlib import Path
from kyth_shared.cloud_preset import load_cloud
from kyth_shared.commands import run
def main():
    drives=load_cloud()
    for name, e in drives.items():
        remote=e["remote"]
        if not remote:
            continue
        mnt=Path.home() / f"Cloud/{name}"
        mnt.mkdir(parents=True, exist_ok=True)
        # systemd --user rclone@.service handles real mount; here best-effort
        run(["systemctl","--user","start", f"rclone@{name}.service"], capture_output=True, timeout=5)
        print(f"kyth-cloud-mount: {name} → {remote} → {mnt}")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
