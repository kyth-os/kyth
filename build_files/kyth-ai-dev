#!/usr/bin/env bash
set -euo pipefail

box="${KYTH_AI_DEV_BOX:-kyth-ai-dev}"
image="${KYTH_AI_DEV_IMAGE:-registry.fedoraproject.org/fedora-toolbox:44}"
model_dir="${KYTH_AI_MODEL_DIR:-${HOME}/.local/share/kyth-ai/models}"

usage() {
	cat <<EOF
Usage: kyth-ai-dev <setup|status|enter|remove|start|stop|pull-model> [model-name]

Creates and manages the KythOS AI & Developer Distrobox container.
Houses IDEs (VS Code, Google Antigravity), developer runtimes (Node.js, Headroom, Helix, Zellij), Azure CLI, GitHub CLI, Claude Code, Codex CLI, and local AI models.

Commands:
  setup              Create and configure container with automatic GPU hardware acceleration
  status             Show environment and runtime component health
  enter              Open interactive shell inside container
  start              Launch Ollama local AI server in container background
  stop               Terminate background Ollama AI server
  pull-model [name]  Download AI model into container (default: qwen2.5-coder)
  remove             Delete container (retains downloaded AI models in ${model_dir})
EOF
}

have_box() {
	distrobox list --no-color 2>/dev/null | awk '{print $3}' | grep -qx "${box}"
}

need_distrobox() {
	if ! command -v distrobox >/dev/null 2>&1; then
		echo "ERROR: distrobox is not installed." >&2
		exit 1
	fi
}

enter_box() {
	distrobox enter "${box}" -- "$@"
}

status() {
	need_distrobox
	echo "KythOS AI developer environment"
	echo "Box: ${box}"
	echo "Image: ${image}"
	echo "Models: ${model_dir}"
	echo

	if have_box; then
		echo "Box: present"
	else
		echo "Box: missing"
		echo "Run: ujust ai-dev-setup or kyth-ai-dev setup"
		return 0
	fi

	if enter_box bash -lc 'command -v code >/dev/null 2>&1'; then
		echo "VS Code: installed"
	else
		echo "VS Code: not installed"
	fi

	if enter_box bash -lc 'command -v antigravity >/dev/null 2>&1'; then
		echo "Google Antigravity IDE: installed"
	else
		echo "Google Antigravity IDE: not installed"
	fi

	if enter_box bash -lc 'command -v node >/dev/null 2>&1'; then
		echo "Node.js: installed ($(enter_box node --version 2>/dev/null || echo unknown))"
	else
		echo "Node.js: not installed"
	fi

	if enter_box bash -lc 'command -v headroom >/dev/null 2>&1'; then
		echo "Headroom CLI: installed"
	else
		echo "Headroom CLI: not installed"
	fi

	if enter_box bash -lc 'command -v hx >/dev/null 2>&1'; then
		echo "Helix Editor: installed"
	else
		echo "Helix Editor: not installed"
	fi

	if enter_box bash -lc 'command -v zellij >/dev/null 2>&1'; then
		echo "Zellij Multiplexer: installed"
	else
		echo "Zellij Multiplexer: not installed"
	fi

	if enter_box bash -lc 'command -v gh >/dev/null 2>&1'; then
		echo "GitHub CLI: installed"
	else
		echo "GitHub CLI: not installed"
	fi

	if enter_box bash -lc 'command -v claude >/dev/null 2>&1'; then
		echo "Claude Code: installed"
	else
		echo "Claude Code: not installed"
	fi

	if enter_box bash -lc 'command -v codex >/dev/null 2>&1'; then
		echo "Codex CLI: installed"
	else
		echo "Codex CLI: not installed"
	fi

	if enter_box bash -lc 'command -v ollama >/dev/null 2>&1'; then
		echo "Ollama: installed"
	else
		echo "Ollama: not installed"
	fi

	if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
		echo "GPU Acceleration: NVIDIA CUDA detected"
	elif [[ -c /dev/kfd ]]; then
		echo "GPU Acceleration: AMD ROCm / HIP detected (/dev/kfd)"
	elif [[ -c /dev/dri/renderD128 ]]; then
		echo "GPU Acceleration: Vulkan / VA-API device detected"
	else
		echo "GPU Acceleration: CPU inference fallback"
	fi
}

setup() {
	need_distrobox
	mkdir -p "${model_dir}"

	if ! have_box; then
		echo "Creating ${box} from ${image}..."
		create_args=(--yes --name "${box}" --image "${image}" --volume "${model_dir}:${model_dir}:rw")

		# Hardware-accelerated GPU passthrough selection
		if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
			echo "→ NVIDIA GPU detected: enabling CUDA container passthrough (--nvidia)..."
			create_args+=(--nvidia)
		elif [[ -c /dev/kfd ]]; then
			echo "→ AMD ROCm detected: mapping /dev/kfd and /dev/dri..."
			create_args+=(--additional-flags "--device=/dev/kfd --device=/dev/dri --group-add=video --group-add=render")
		elif [[ -c /dev/dri/renderD128 ]]; then
			echo "→ Direct Rendering device detected: mapping /dev/dri..."
			create_args+=(--additional-flags "--device=/dev/dri --group-add=video --group-add=render")
		fi

		distrobox create "${create_args[@]}"
	else
		echo "${box} already exists."
	fi

	echo "Installing developer & AI tools in ${box}..."
	enter_box bash -lc '
        set -euo pipefail

        # Configure Microsoft & Google RPM repos inside container
        sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc || true
        printf "[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc\n" | sudo tee /etc/yum.repos.d/vscode.repo >/dev/null
        printf "[azure-cli]\nname=Azure CLI\nbaseurl=https://packages.microsoft.com/yumrepos/azure-cli\nenabled=1\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc\n" | sudo tee /etc/yum.repos.d/azure-cli.repo >/dev/null
        printf "[antigravity-rpm]\nname=Antigravity RPM Repository\nbaseurl=https://us-central1-yum.pkg.dev/projects/antigravity-auto-updater-dev/antigravity-rpm\nenabled=1\ngpgcheck=0\nrepo_gpgcheck=0\n" | sudo tee /etc/yum.repos.d/antigravity.repo >/dev/null

        # mimalloc: the host sets LD_PRELOAD=/usr/lib64/libmimalloc.so.2
        # session-wide (sysconfig/46-mimalloc-preload.sh), which distrobox
        # carries into every command run in this container. Without the
        # library present here too, every single process launched in the
        # box printed "ld.so: ... cannot be preloaded ... ignored" — installing
        # it resolves the preload for real instead of just silencing the spam.
        packages=(
            git git-lfs curl wget jq yq make cmake gcc gcc-c++
            python3 python3-pip python3-virtualenv python3-devel
            nodejs npm rust cargo golang
            podman skopeo podman-compose
            vulkan-tools clinfo
            ollama llama.cpp
            helix zellij shellcheck shfmt
            ripgrep fd-find fzf
            code antigravity azure-cli gh
            mimalloc
        )

        if command -v dnf5 >/dev/null 2>&1; then
            sudo dnf5 install -y --skip-unavailable "${packages[@]}"
            sudo dnf5 install -y --skip-unavailable pipx uv || true
        elif command -v dnf >/dev/null 2>&1; then
            sudo dnf install -y --skip-unavailable "${packages[@]}"
            sudo dnf install -y --skip-unavailable pipx uv || true
        else
            echo "ERROR: unsupported container package manager." >&2
            exit 1
        fi

        # Install Claude Code and Codex CLI (npm globals, need Node.js above)
        sudo npm install -g @anthropic-ai/claude-code @openai/codex || true

        # Install headroom in container
        python3 -m pip install --user --upgrade pipx uv headroom 2>/dev/null || \
            python3 -m pip install --user --upgrade --break-system-packages pipx uv headroom || true

        if command -v pipx >/dev/null 2>&1; then
            pipx ensurepath || true
        fi

        # Export desktop applications and command line wrappers to host
        echo "Exporting applications and CLI wrappers to host..."
        distrobox-export --app code || true
        distrobox-export --app antigravity || true
        distrobox-export --bin /usr/bin/code --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/antigravity --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/az --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/node --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/npm --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/npx --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/hx --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/zellij --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/shellcheck --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/shfmt --export-path ~/.local/bin || true
        distrobox-export --bin /usr/bin/gh --export-path ~/.local/bin || true
        if command -v claude >/dev/null 2>&1; then
            distrobox-export --bin "$(command -v claude)" --export-path ~/.local/bin || true
        fi
        if command -v codex >/dev/null 2>&1; then
            distrobox-export --bin "$(command -v codex)" --export-path ~/.local/bin || true
        fi
        if command -v headroom >/dev/null 2>&1; then
            distrobox-export --bin "$(command -v headroom)" --export-path ~/.local/bin || true
        elif [[ -x "${HOME}/.local/bin/headroom" ]]; then
            distrobox-export --bin "${HOME}/.local/bin/headroom" --export-path ~/.local/bin || true
        fi
    '

	echo
	echo "Developer & AI environment (${box}) is ready."
	echo "Exported to host: VS Code, Antigravity, Node.js, Azure CLI, GitHub CLI, Claude Code, Codex CLI, Helix, Zellij, ShellCheck, shfmt, Headroom."
	echo "Enter environment manually with: distrobox enter ${box}"
}

start() {
	need_distrobox
	if ! have_box; then
		echo "ERROR: ${box} does not exist. Run: ujust ai-dev-setup or kyth-ai-dev setup" >&2
		exit 1
	fi
	enter_box bash -lc 'command -v ollama >/dev/null 2>&1 || { echo "ERROR: ollama is not installed. Run: ujust ai-dev-setup" >&2; exit 1; }; OLLAMA_MODELS="'"${model_dir}"'" nohup ollama serve >/tmp/kyth-ollama.log 2>&1 &'
	echo "Started Ollama inside ${box} (Models in ${model_dir})."
}

stop() {
	need_distrobox
	if have_box; then
		enter_box bash -lc 'pkill -x ollama 2>/dev/null || true'
	fi
	echo "Stopped Ollama in ${box}."
}

pull_model() {
	need_distrobox
	if ! have_box; then
		echo "ERROR: ${box} does not exist. Run: ujust ai-dev-setup or kyth-ai-dev setup" >&2
		exit 1
	fi
	local model="${1:-qwen2.5-coder}"
	if ! enter_box bash -lc 'pgrep -x ollama >/dev/null 2>&1'; then
		echo "Starting background Ollama server before pulling model..."
		start
		sleep 2
	fi
	echo "Pulling AI model '${model}' into ${box} (${model_dir})..."
	enter_box bash -lc "OLLAMA_MODELS='${model_dir}' ollama pull '${model}'"
}

remove() {
	need_distrobox
	distrobox rm --force "${box}"
	echo "Removed ${box}."
	echo "Models were left in: ${model_dir}"
}

case "${1:-}" in
setup) setup ;;
status) status ;;
enter)
	need_distrobox
	exec distrobox enter "${box}"
	;;
pull-model) pull_model "${2:-}" ;;
remove) remove ;;
start) start ;;
stop) stop ;;
-h | --help | help | "") usage ;;
*)
	usage >&2
	exit 2
	;;
esac
