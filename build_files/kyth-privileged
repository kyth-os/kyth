#!/usr/bin/env python3
"""Root-owned, allowlisted action boundary for the Kyth Hub.

The protocol is one JSON request per line and one JSON response per line.
There is deliberately no command/argv field: every operation below maps to a
fixed executable and fixed argument shape. Socket permissions and peer
credentials both require a local root or wheel member.
"""
import grp
import json
import os
import re
import socket
import socketserver
import struct
import subprocess
import time

SOCKET = "/run/kyth/privileged.sock"
AUDIT_LOG = "/var/log/kyth/privileged.log"
APP_ID = re.compile(r"^[A-Za-z0-9]+(?:[.-][A-Za-z0-9_]+)+$")
DEVICE = re.compile(r"^/dev/(sd[a-z][0-9]*|nvme[0-9]+n[0-9]+p?[0-9]*|vd[a-z][0-9]*|mmcblk[0-9]+p?[0-9]*)$")
FLAVOR = {"fedora", "cachy"}
SHARE_NAME = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SHARE_HOST = re.compile(r"^[A-Za-z0-9._:-]{1,253}$")
SHARE_MOUNT_PATH = re.compile(r"^[A-Za-z0-9._/ -]+$")
SHARE_MOUNT_PREFIXES = ("/mnt/", "/media/", "/run/media/", "/home/")


def peer_credentials(sock):
    raw = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
    return struct.unpack("3i", raw)


def peer_allowed(sock):
    pid, uid, gid = peer_credentials(sock)
    if uid == 0:
        return pid, uid, gid
    wheel_gid = grp.getgrnam("wheel").gr_gid
    groups = set()
    try:
        with open(f"/proc/{pid}/status", encoding="ascii") as stream:
            for line in stream:
                if line.startswith("Groups:"):
                    groups = {int(value) for value in line.split()[1:]}
                    break
    except (OSError, ValueError):
        pass
    if gid != wheel_gid and wheel_gid not in groups:
        raise PermissionError("caller is not root or a wheel member")
    return pid, uid, gid


def _audit(uid, operation, ok, detail):
    try:
        os.makedirs(os.path.dirname(AUDIT_LOG), mode=0o750, exist_ok=True)
        with open(AUDIT_LOG, "a", encoding="utf-8") as stream:
            safe = str(detail).replace("\n", " ").replace("\r", " ")[:400]
            stream.write(f"{int(time.time())} uid={uid} operation={operation} ok={int(ok)} detail={safe}\n")
    except OSError:
        print("kyth-privileged: could not write audit log", flush=True)


def _share_text(value, field, *, allow_empty=False, limit=4096):
    if not isinstance(value, str):
        raise ValueError(f"{field} must be text")
    if not allow_empty and not value:
        raise ValueError(f"{field} is required")
    if len(value) > limit or any(ord(char) < 32 or ord(char) == 127 for char in value):
        raise ValueError(f"invalid {field}")
    return value


def _share_mount_point(value):
    mount_point = os.path.normpath(_share_text(value, "mount_point"))
    if not SHARE_MOUNT_PATH.fullmatch(mount_point) or "//" in mount_point or "/../" in f"/{mount_point}/":
        raise ValueError("invalid mount_point")
    if not any(mount_point.startswith(prefix) for prefix in SHARE_MOUNT_PREFIXES):
        raise ValueError("mount_point is outside an approved prefix")
    return mount_point


def _network_share_payload(request, operation, caller_uid, caller_gid):
    payload = request.get("payload")
    if not isinstance(payload, dict):
        raise ValueError("network share payload must be an object")
    if len(json.dumps(payload, separators=(",", ":"))) > 64 * 1024:
        raise ValueError("network share payload is too large")
    name = _share_text(payload.get("name"), "name", limit=64)
    if not SHARE_NAME.fullmatch(name):
        raise ValueError("invalid share name")
    mount_point = _share_mount_point(payload.get("mount_point"))
    if operation == "network_share_remove":
        return {"name": name, "mount_point": mount_point}

    server = _share_text(payload.get("server"), "server", limit=253)
    if not SHARE_HOST.fullmatch(server):
        raise ValueError("invalid share server")
    share_path = _share_text(payload.get("share_path"), "share_path").lstrip("/")
    if not share_path or share_path.startswith(".") or "//" in share_path or "%" in share_path or ".." in share_path.split("/"):
        raise ValueError("invalid share_path")
    username = _share_text(payload.get("username"), "username", limit=256)
    password = _share_text(payload.get("password", ""), "password", allow_empty=True, limit=4096)
    domain = _share_text(payload.get("domain", ""), "domain", allow_empty=True, limit=256)
    auto_mount = payload.get("auto_mount") is True
    mount_now = payload.get("mount_now") is True
    return {
        "name": name, "server": server, "share_path": share_path,
        "mount_point": mount_point, "username": username, "password": password,
        "domain": domain, "auto_mount": auto_mount, "mount_now": mount_now,
        # Peer credentials are authoritative; never trust uid/gid supplied by
        # a client over the socket.
        "uid": caller_uid, "gid": caller_gid,
    }


def validate_request(request, caller_uid=0, caller_gid=0):
    if not isinstance(request, dict):
        raise ValueError("request must be an object")
    operation = request.get("operation")
    if operation == "flatpak_uninstall":
        app_id = str(request.get("app_id", ""))
        if not APP_ID.fullmatch(app_id):
            raise ValueError("invalid Flatpak application id")
        return operation, ["/usr/bin/flatpak", "uninstall", "--system", "-y", app_id], None
    if operation == "firmware_update":
        return operation, ["/usr/bin/fwupdmgr", "update"], None
    if operation == "nvidia_install":
        return operation, ["/usr/bin/ujust", "install-nvidia-driver"], None
    if operation == "kernel_switch":
        flavor = str(request.get("flavor", ""))
        if flavor not in FLAVOR:
            raise ValueError("kernel flavor must be fedora or cachy")
        return operation, ["/usr/bin/ujust", "switch-kernel", flavor], None
    if operation == "windows_verify":
        return operation, ["/usr/bin/kyth-windows-verify"], None
    if operation == "secureboot_enroll":
        return operation, ["/usr/bin/ujust", "enroll-secureboot"], None
    if operation == "bitlocker_unlock":
        device = str(request.get("device", ""))
        key = str(request.get("key", ""))
        if not DEVICE.fullmatch(device):
            raise ValueError("invalid block device")
        if not 8 <= len(key) <= 128 or "\n" in key or "\r" in key:
            raise ValueError("invalid BitLocker key")
        return operation, ["/usr/bin/udisksctl", "unlock", "-b", device, "--key-file", "/dev/stdin"], key
    if operation in {"network_share_add", "network_share_remove"}:
        payload = _network_share_payload(request, operation, caller_uid, caller_gid)
        action = "add" if operation == "network_share_add" else "remove"
        return operation, ["/usr/libexec/kyth-network-share", action], json.dumps(payload, separators=(",", ":"))
    raise ValueError("operation is not allowlisted")


def run_operation(request, caller_uid=0, caller_gid=0):
    operation, argv, stdin = validate_request(request, caller_uid, caller_gid)
    result = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=900, check=False)
    detail = (result.stdout or result.stderr or "Operation complete.").strip()[:400]
    if result.returncode:
        raise RuntimeError(detail or f"operation exited with {result.returncode}")
    return operation, detail or "Operation complete."


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        try:
            _pid, uid, gid = peer_allowed(self.connection)
        except (OSError, PermissionError) as exc:
            self.wfile.write((json.dumps({"ok": False, "detail": str(exc)}) + "\n").encode())
            self.wfile.flush()
            return
        for raw in self.rfile:
            operation = "invalid"
            try:
                request = json.loads(raw)
                operation = str(request.get("operation", "invalid")) if isinstance(request, dict) else "invalid"
                operation, detail = run_operation(request, uid, gid)
                response = {"ok": True, "detail": detail}
                _audit(uid, operation, True, detail)
            except (ValueError, RuntimeError, OSError, subprocess.TimeoutExpired) as exc:
                detail = str(exc)
                response = {"ok": False, "detail": detail[:400]}
                _audit(uid, operation, False, detail)
            self.wfile.write((json.dumps(response) + "\n").encode())
            self.wfile.flush()


class Server(socketserver.ThreadingUnixStreamServer):
    allow_reuse_address = True
    daemon_threads = True


def main():
    os.makedirs(os.path.dirname(SOCKET), mode=0o750, exist_ok=True)
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    server = Server(SOCKET, Handler)
    os.chown(SOCKET, 0, grp.getgrnam("wheel").gr_gid)
    os.chmod(SOCKET, 0o660)
    server.serve_forever()


if __name__ == "__main__":
    main()
