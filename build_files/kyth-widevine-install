#!/usr/bin/env python3
"""kyth-widevine-install — install Widevine CDM for Flatpak browsers via kyth_shared."""
from __future__ import annotations

import argparse
import sys
from kyth_shared.thirdparty import install_widevine_cdm


def main() -> None:
    parser = argparse.ArgumentParser(description="Install Widevine CDM for Flatpak browsers.")
    parser.parse_args()
    sys.exit(install_widevine_cdm())


if __name__ == "__main__":
    main()
