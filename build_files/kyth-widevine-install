#!/usr/bin/env python3
"""kyth-widevine-install — install Widevine CDM for Flatpak browsers in Python."""
from __future__ import annotations

import argparse
import os
import shutil
import sys
import tempfile
import urllib.request
import zipfile
from pathlib import Path

VERSION_URL = "https://dl.google.com/widevine-cdm/versions.txt"
CDM_BASE = "https://dl.google.com/widevine-cdm"


def fetch_widevine_version() -> str | None:
    try:
        req = urllib.request.Request(VERSION_URL, headers={"User-Agent": "KythOS"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            line = resp.readline().decode("utf-8", errors="replace").strip()
            return line if line else None
    except Exception:
        return None


def download_file(url: str, dest: Path) -> bool:
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "KythOS"})
        with urllib.request.urlopen(req, timeout=60) as resp, open(dest, "wb") as out:
            shutil.copyfileobj(resp, out)
        return True
    except Exception:
        return False


def install_widevine() -> int:
    print("==> Fetching Widevine CDM version...")
    version = fetch_widevine_version()
    if not version:
        print(f"Error: Could not fetch Widevine version list from {VERSION_URL}", file=sys.stderr)
        return 1

    print(f"  Version: {version}")

    with tempfile.TemporaryDirectory() as tmp_dir:
        tmp_path = Path(tmp_dir)
        zip_path = tmp_path / "widevine.zip"

        print(f"\n==> Downloading {version}...")
        download_url = f"{CDM_BASE}/{version}-linux-x64.zip"
        if not download_file(download_url, zip_path):
            print("Error: Download failed", file=sys.stderr)
            return 1

        print("\n==> Extracting...")
        cdm_dir = tmp_path / "cdm"
        try:
            with zipfile.ZipFile(zip_path, "r") as zip_ref:
                zip_ref.extractall(cdm_dir)
        except Exception as exc:
            print(f"Error: Failed to extract zip: {exc}", file=sys.stderr)
            return 1

        lib_file = cdm_dir / "libwidevinecdm.so"
        manifest_file = cdm_dir / "manifest.json"
        if not lib_file.is_file() or not manifest_file.is_file():
            print("Error: Required Widevine files missing in extracted archive", file=sys.stderr)
            return 1

        print("\n==> Installing...")
        installed = 0
        home = Path.home()

        # Firefox Flatpak
        ff_app = "org.mozilla.firefox"
        ff_var = home / ".var" / "app" / ff_app
        if ff_var.is_dir():
            ff_cdm = ff_var / "config" / "google-chrome" / "WidevineCdm" / version
            ff_lib_dir = ff_cdm / "_platform_specific" / "linux_x64"
            ff_lib_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(manifest_file, ff_cdm / "manifest.json")
            shutil.copy2(lib_file, ff_lib_dir / "libwidevinecdm.so")
            print(f"✓ Firefox ({ff_app})")
            installed += 1
        else:
            print(f"  (skip) Firefox Flatpak container not found ({ff_app})")

        # Chromium Flatpak
        cr_app = "org.chromium.Chromium"
        cr_var = home / ".var" / "app" / cr_app
        if cr_var.is_dir():
            cr_cdm = cr_var / "config" / "chromium" / "WidevineCdm" / version
            cr_lib_dir = cr_cdm / "_platform_specific" / "linux_x64"
            cr_lib_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(manifest_file, cr_cdm / "manifest.json")
            shutil.copy2(lib_file, cr_lib_dir / "libwidevinecdm.so")
            print(f"✓ Chromium ({cr_app})")
            installed += 1
        else:
            print(f"  (skip) Chromium Flatpak container not found ({cr_app})")

        print()
        if installed > 0:
            print(f"Widevine {version} installed for {installed} browser(s).")
            print("Restart your browser(s) to activate DRM playback.")
            return 0

        print("No supported Flatpak browser data directories found.")
        print("Install Firefox or Chromium from Discover, run once, then try again.")
        return 1


def main() -> None:
    parser = argparse.ArgumentParser(description="Install Widevine CDM for Flatpak browsers.")
    parser.parse_args()
    sys.exit(install_widevine())


if __name__ == "__main__":
    main()
