#!/usr/bin/env python3
"""kyth-batteryd — charge threshold daemon (offline, 30s)."""
import time
from pathlib import Path
from kyth_shared.battery import load_battery, append_ledger, read_battery_health
from kyth_shared.commands import run
def apply_threshold(stop):
    for p in Path("/sys/class/power_supply").glob("BAT*/charge_control_end_threshold"):
        try:
            p.write_text(str(stop), encoding="utf-8")
        except Exception:
            pass
def main():
    while True:
        cfg=load_battery()
        apply_threshold(cfg["charge_stop"])
        if cfg["health_check"]:
            append_ledger({"health": read_battery_health(), "cfg": cfg})
        time.sleep(30)
if __name__=="__main__":
    main()
