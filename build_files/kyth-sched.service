[Unit]
Description=KythOS automatic sched-ext profile switcher
Documentation=https://github.com/mrtrick37/kyth
After=graphical-session.target scx_loader.service
Wants=scx_loader.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/kyth-sched
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kyth-sched

# Kill nicely; daemon handles SIGTERM by stopping its loop
KillSignal=SIGTERM
TimeoutStopSec=5

# Control-plane daemon (decides *which* scheduler profile applies) — not the
# scheduler itself (scx_loader/scx_*, kept unconstrained), so it's safe to
# deprioritize like any other background monitor.
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryHigh=384M
MemoryMax=512M
PrivateTmp=yes
PrivateUsers=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
CacheDirectory=kyth
CacheDirectoryMode=0700

[Install]
WantedBy=graphical-session.target
