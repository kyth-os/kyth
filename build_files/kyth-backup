#!/usr/bin/env python3
"""kyth-backup — restic + btrfs send for /home (offline)."""
import sys
from pathlib import Path
from kyth_shared.backup_preset import load_backup
from kyth_shared.commands import run
def on_battery():
    for p in Path("/sys/class/power_supply").glob("BAT*/status"):
        try:
            if p.read_text().strip()=="Discharging":
                return True
        except Exception:
            pass
    return False
def main():
    cfg=load_backup()
    if cfg["on_battery"]==False and on_battery():
        print("kyth-backup: on battery, skipping btrfs send")
    repo=Path(cfg["repo"])
    repo.mkdir(parents=True, exist_ok=True)
    if not (repo/"config").exists():
        run(["restic","init","--repo", str(repo)], capture_output=True, timeout=10)
    run(["restic","--repo", str(repo), "backup", str(Path.home())], capture_output=True, timeout=120)
    if cfg["btrfs_send"] and not on_battery():
        # btrfs send best-effort to USB if present
        for usb in Path("/run/media").glob("*/*"):
            if usb.is_dir():
                try:
                    run(["btrfs","send", "-p", "/home", str(usb)], capture_output=True, timeout=300)
                except Exception:
                    pass
                break
    if cfg["remote"] and Path.home().joinpath(".config/rclone/rclone.conf").exists():
        run(["rclone","sync", str(repo), cfg["remote"]], capture_output=True, timeout=120)
    print(f"kyth-backup: repo {repo}")
    return 0
if __name__=="__main__":
    raise SystemExit(main())
