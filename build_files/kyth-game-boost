#!/usr/bin/env python3
"""KythOS Adaptive Game & Performance Governor."""
from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.performance import (  # noqa: E402
    flush_page_caches,
    get_amd_ccd0_cpus,
    get_cpu_topology,
    get_intel_pcores,
    has_3d_vcache,
    set_transparent_hugepages,
    switch_sched_ext_profile,
)


def log(msg: str) -> None:
    print(f"[kyth-game-boost] {msg}")


def parse_cpu_list(cpu_str: str) -> set[int]:
    """Parse comma-separated or hyphenated CPU string into set of ints (e.g. '0-7,16-23')."""
    cpus = set()
    for part in cpu_str.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            try:
                start, end = part.split("-", 1)
                cpus.update(range(int(start), int(end) + 1))
            except ValueError:
                pass
        else:
            try:
                cpus.add(int(part))
            except ValueError:
                pass
    return cpus


def status_only() -> None:
    log("KythOS Performance Governor Status")
    log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    vendor, model = get_cpu_topology()
    log(f"CPU Vendor / Model: {vendor} ({model})")

    if vendor == "AuthenticAMD":
        if has_3d_vcache():
            log("AMD 3D V-Cache Detected: Cache CCD affinity optimization active")
        elif Path("/sys/devices/system/cpu/cpu0/topology").is_dir():
            num_nodes = len(list(Path("/sys/devices/system/node").glob("node*"))) or 1
            log(f"AMD Multi-CCD Topology: {num_nodes} NUMA node(s) / CCD(s)")
    elif vendor == "GenuineIntel":
        log("Intel Processor Topology: Hybrid P/E core auto-scheduling supported")

    if shutil.which("scx_rusty"):
        log("Sched-Ext (scx_rusty): Fedora-packaged gaming scheduler available")
    elif shutil.which("systemctl"):
        import subprocess
        res = subprocess.run(["systemctl", "is-active", "--quiet", "scx_loader.service"], check=False)
        if res.returncode == 0:
            log("Sched-Ext (scx_loader): Service active")
        else:
            log("Sched-Ext (scx): Default kernel scheduler fallback")
    else:
        log("Sched-Ext (scx): Default kernel scheduler fallback")

    print()
    log("To use in Steam: Set launch options to: kyth-game-boost %command%")


def main() -> None:
    args = sys.argv[1:]
    if not args:
        status_only()
        sys.exit(0)

    # 1. CPU Core Affinity Optimization
    affinity_cpus = None
    vendor, _ = get_cpu_topology()

    if vendor == "AuthenticAMD":
        # If AMD 3D V-Cache, attempt to isolate CCD0
        if has_3d_vcache():
            ccd0 = get_amd_ccd0_cpus()
            if ccd0:
                log(f"Pinning game to 3D V-Cache CCD0 (CPUs: {ccd0})")
                affinity_cpus = ccd0
    elif vendor == "GenuineIntel":
        pcores = get_intel_pcores()
        if pcores:
            log(f"Pinning game to Intel Performance Cores (CPUs: {pcores})")
            affinity_cpus = pcores

    # Apply affinity to current process if supported
    if affinity_cpus and hasattr(os, "sched_setaffinity"):
        try:
            cpu_set = parse_cpu_list(affinity_cpus)
            if cpu_set:
                os.sched_setaffinity(0, cpu_set)
        except Exception as e:
            log(f"Warning: failed to set CPU affinity: {e}")

    # 2. Memory Cache & Transparent Hugepages Optimization
    flush_page_caches()
    set_transparent_hugepages("madvise")

    # 3. Sched-Ext switcher
    if shutil.which("scx_rusty"):
        log("Switching sched-ext to the scx_rusty gaming scheduler...")
        switch_sched_ext_profile("rusty")

    # 4. Launch Target Application
    log(f"Launching game workload: {' '.join(args)}")
    try:
        os.execvp(args[0], args)
    except Exception as e:
        print(f"[kyth-game-boost] Exec failed: {e}", file=sys.stderr)
        sys.exit(127)


if __name__ == "__main__":
    main()
