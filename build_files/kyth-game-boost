#!/usr/bin/env python3
"""KythOS Adaptive Game & Performance Governor."""
from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path



from kyth_shared.performance import (  # noqa: E402
    flush_page_caches,
    get_amd_ccd0_cpus,
    get_cpu_topology,
    get_intel_pcores,
    has_3d_vcache,
    set_transparent_hugepages,
    switch_sched_ext_profile,
)


def log(msg: str) -> None:
    print(f"[kyth-game-boost] {msg}")


def parse_cpu_list(cpu_str: str) -> set[int]:
    """Parse comma-separated or hyphenated CPU string into set of ints (e.g. '0-7,16-23')."""
    cpus = set()
    for part in cpu_str.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            try:
                start, end = part.split("-", 1)
                cpus.update(range(int(start), int(end) + 1))
            except ValueError:
                pass
        else:
            try:
                cpus.add(int(part))
            except ValueError:
                pass
    return cpus


def status_only() -> None:
    log("KythOS Performance Governor Status")
    log("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

    vendor, model = get_cpu_topology()
    log(f"CPU Vendor / Model: {vendor} ({model})")

    if vendor == "AuthenticAMD":
        if has_3d_vcache():
            log("AMD 3D V-Cache Detected: Cache CCD affinity optimization active")
        elif Path("/sys/devices/system/cpu/cpu0/topology").is_dir():
            num_nodes = len(list(Path("/sys/devices/system/node").glob("node*"))) or 1
            log(f"AMD Multi-CCD Topology: {num_nodes} NUMA node(s) / CCD(s)")
    elif vendor == "GenuineIntel":
        log("Intel Processor Topology: Hybrid P/E core auto-scheduling supported")

    if shutil.which("scx_rusty"):
        log("Sched-Ext (scx_rusty): Fedora-packaged gaming scheduler available")
    elif shutil.which("systemctl"):
        import subprocess
        res = subprocess.run(["systemctl", "is-active", "--quiet", "scx_loader.service"], check=False)
        if res.returncode == 0:
            log("Sched-Ext (scx_loader): Service active")
        else:
            log("Sched-Ext (scx): Default kernel scheduler fallback")
    else:
        log("Sched-Ext (scx): Default kernel scheduler fallback")

    print()
    log("To use in Steam: Set launch options to: kyth-game-boost %command%")


def main() -> None:
    args = sys.argv[1:]
    if not args:
        status_only()
        sys.exit(0)

    # Arbiter is single placement owner — delegate affinity via cgroup slice,
    # not os.sched_setaffinity (stripped by pressure-vessel/bwrap). Log topology
    # only; placement is via systemd-run --slice=gaming.slice when available.
    vendor, _ = get_cpu_topology()
    if vendor == "AuthenticAMD" and has_3d_vcache():
        ccd0 = get_amd_ccd0_cpus()
        if ccd0:
            log(f"Topology: 3D V-Cache CCD0 cpus {ccd0} (arbiter manages placement)")
    elif vendor == "GenuineIntel":
        pcores = get_intel_pcores()
        if pcores:
            log(f"Topology: Intel P-cores {pcores} (arbiter manages placement)")

    # Ensure arbiter flag is fresh (no privileged writes here)
    try:
        from kyth_shared.sched_arbiter import generate_arbiter

        generate_arbiter()
    except Exception:
        pass

    # 4. Launch Target Application — prefer cgroup slice so placement survives container
    log(f"Launching game workload: {' '.join(args)}")
    # Try systemd-run slice delegation first (survives pressure-vessel); fall back to direct exec
    if shutil.which("systemd-run"):
        try:
            # --user when not root and logind session exists; else system slice
            use_user = os.geteuid() != 0 and Path("/run/systemd/system").exists()
            base = ["systemd-run", "--user", "--scope", "--slice=gaming.slice"] if use_user else ["systemd-run", "--scope", "--slice=gaming.slice"]
            # Check if gaming.slice exists or can be created
            os.execvp(base[0], base + ["--"] + args)
        except Exception:
            pass
    try:
        os.execvp(args[0], args)
    except Exception as e:
        print(f"[kyth-game-boost] Exec failed: {e}", file=sys.stderr)
        sys.exit(127)


if __name__ == "__main__":
    main()
