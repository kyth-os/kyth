#!/usr/bin/env python3
"""Keep Chromium/Electron apps from opening KWallet on startup by configuring basic password stores."""
from __future__ import annotations

import getpass
import sys
from pathlib import Path


def _ensure_kyth_shared_path() -> None:
    """Add build_files/kyth_shared to sys.path when running from a repo checkout."""
    here = Path(__file__).resolve().parent
    for candidate_dir in (here, here.parent):
        candidate = candidate_dir / "kyth_shared"
        if (candidate / "kyth_shared").is_dir():
            path = str(candidate)
            if path not in sys.path:
                sys.path.insert(0, path)
            return


_ensure_kyth_shared_path()
from kyth_shared.session import disable_vscode_brave_wallet_prompts  # noqa: E402


def main() -> None:
    disable_vscode_brave_wallet_prompts(Path.home())
    user = getpass.getuser() or "this user"
    print(f"VS Code and Brave wallet prompts disabled for {user}.")


if __name__ == "__main__":
    main()
