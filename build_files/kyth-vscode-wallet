#!/usr/bin/env python3
"""Enable KWallet integration for Chromium/Electron apps (VS Code and Brave)."""
from __future__ import annotations

import getpass
from pathlib import Path

from kyth_shared.session import enable_vscode_brave_wallet_prompts  # noqa: E402


def main() -> None:
    enable_vscode_brave_wallet_prompts(Path.home())
    user = getpass.getuser() or "this user"
    print(f"VS Code and Brave KWallet integration enabled for {user}.")


if __name__ == "__main__":
    main()
