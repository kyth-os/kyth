#!/usr/bin/env python3
"""kyth-apply-display-hdr — apply display-hdr.toml via kscreen-doctor."""
from __future__ import annotations

import sys

from kyth_shared.display_hdr import apply_display_hdr


def main() -> int:
    notes = apply_display_hdr()
    print(f"kyth-apply-display-hdr: {'; '.join(notes) if notes else 'nothing to apply'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
