#!/usr/bin/env bash
# kyth-file-max — 2097152 gaming
set -euo pipefail
need_root(){ [[ $EUID -eq 0 ]] || exec sudo -A /usr/bin/kyth-file-max "$@"; }
case "${1:-status}" in
    status) python3 -c "from kyth_shared.file_max import load_file_max, file_max_status; c=load_file_max(); print(f\"profile={c['profile']} active={file_max_status()}\")" ;;
    gaming) need_root "$@"; python3 -c "from kyth_shared.file_max import load_file_max,save_file_max,generate_file_max; c=load_file_max(); c['profile']='gaming'; save_file_max(c); generate_file_max(c)"; sysctl --system >/dev/null 2>&1 || true; echo "file max gaming 2097152" ;;
    balanced) need_root "$@"; python3 -c "from kyth_shared.file_max import load_file_max,save_file_max,generate_file_max; c=load_file_max(); c['profile']='balanced'; save_file_max(c); generate_file_max(c)"; echo "file max balanced" ;;
    apply) need_root "$@"; python3 -c "from kyth_shared.file_max import load_file_max,generate_file_max; generate_file_max(load_file_max())" ;;
    *) echo "Usage: kyth-file-max [status|gaming|balanced|apply]" >&2; exit 1 ;;
esac
