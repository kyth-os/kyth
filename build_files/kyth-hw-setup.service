[Unit]
Description=KythOS declarative hardware policy
Documentation=https://github.com/mrtrick37/kyth
# Run after filesystems and PCI devices are enumerated, but don't block SDDM —
# akmods can take 5-15 min and we don't want to stall the first login screen.
After=sysinit.target local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-hw-setup
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
