#!/usr/bin/env python3
"""kyth-report-issue — generate prefilled GitHub issue URL & local Markdown draft."""

from __future__ import annotations

import argparse
import os
import sys

from kyth_shared.diagnostics import create_github_issue_draft


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Creates a prefilled GitHub issue URL for KythOS and writes a local draft."
    )
    parser.add_argument(
        "--title",
        default="KythOS issue report",
        help="Title for the GitHub issue",
    )
    parser.add_argument(
        "--body",
        default="",
        help="Body text for the issue description",
    )
    parser.add_argument(
        "--body-file",
        default=None,
        help="Path to file containing issue body text",
    )
    parser.add_argument(
        "--label",
        default=os.environ.get("KYTH_ISSUE_LABEL", "bug"),
        help="Label to apply on GitHub",
    )
    parser.add_argument(
        "--no-open",
        action="store_true",
        help="Do not open the URL in the default browser",
    )

    args = parser.parse_args()
    repo_url = os.environ.get(
        "KYTH_ISSUE_REPO_URL", "https://github.com/kyth-os/kyth"
    )

    try:
        draft_path, url = create_github_issue_draft(
            title=args.title,
            body=args.body,
            body_file=args.body_file,
            label=args.label,
            repo_url=repo_url,
            open_browser=not args.no_open,
        )
        print(f"Draft saved: {draft_path}")
        print(url)
    except Exception as err:
        print(f"kyth-report-issue error: {err}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
