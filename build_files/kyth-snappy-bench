#!/usr/bin/env bash
set -euo pipefail

print_kv() {
    printf '%-20s %s\n' "$1" "$2"
}

state_dir="${XDG_STATE_HOME:-${HOME}/.local/state}/kyth"
log_file="${state_dir}/snappy-bench.jsonl"

usage() {
    cat <<'EOF'
kyth-snappy-bench [record|report]

record (default)  Measure boot time and app-launch latency, print a
                   summary, and append a JSON line to the history log.
report             Show recent recorded runs from the history log.

History is stored at ~/.local/state/kyth/snappy-bench.jsonl so trends
can be tracked across builds/deployments over time.
EOF
}

cmd="${1:-record}"
case "${cmd}" in
    -h | --help)
        usage
        exit 0
        ;;
    record | report) ;;
    *)
        echo "kyth-snappy-bench: unknown subcommand '${cmd}'" >&2
        usage >&2
        exit 1
        ;;
esac

if [[ "${cmd}" == "report" ]]; then
    if [[ ! -s "${log_file}" ]]; then
        echo "No recorded runs yet. Run 'kyth-snappy-bench' first."
        exit 0
    fi
    printf '%-20s %-14s %10s  %s\n' "TIMESTAMP" "BOOT CLASS" "BOOT(s)" "SLOWEST UNIT"
    jq -r '[.timestamp, .boot_class, .boot_seconds, (.top_units[0].unit // "-")] | @tsv' "${log_file}" |
        tail -n 20 |
        while IFS=$'\t' read -r ts class secs unit; do
            printf '%-20s %-14s %10s  %s\n' "${ts}" "${class}" "${secs}" "${unit}"
        done
    exit 0
fi

mkdir -p "${state_dir}"

bootc_ref="unavailable"
if command -v bootc >/dev/null 2>&1; then
    bootc_ref=$(bootc status --json 2>/dev/null | jq -r '.spec.image.image // .status.booted.image.image.image // "unavailable"' 2>/dev/null || true)
    bootc_ref=${bootc_ref:-unavailable}
fi

analyze_time=$(systemd-analyze time 2>/dev/null || true)
total_str=$(grep -oP '= \K.*(?=\s*$)' <<<"${analyze_time}" | head -1 || true)
boot_seconds=0
if [[ -n "${total_str}" ]]; then
    boot_seconds=$(awk '{
        total = 0
        for (i = 1; i <= NF; i += 2) {
            val = $i + 0
            unit = $(i + 1)
            if (unit == "h") total += val * 3600
            else if (unit == "min") total += val * 60
            else if (unit == "s") total += val
            else if (unit == "ms") total += val / 1000
        }
        printf "%.3f", total
    }' <<<"$(sed -E 's/([0-9])([a-z])/\1 \2/g' <<<"${total_str}")")
fi

blame=$(systemd-analyze blame 2>/dev/null || true)

# kyth-selinux-relabel-home.service and kyth-boot-splash-initramfs.service
# only run once per new deployment (SELinux relabel, initramfs rebuild for
# the boot splash). Their presence in blame means this boot paid that
# one-time cost, so the total isn't comparable to a steady-state boot.
boot_class="steady-state"
if grep -qE 'kyth-selinux-relabel-home\.service|kyth-boot-splash-initramfs\.service' <<<"${blame}"; then
    boot_class="post-deploy"
fi

top_units_json="[]"
if [[ -n "${blame}" ]]; then
    top_units_json=$(head -5 <<<"${blame}" |
        sed -E 's/^\s*([0-9]+min\s+[0-9.]+m?s|[0-9.]+m?s)\s+(.*)$/\1\t\2/' |
        jq -Rn '[inputs | split("\t") | {duration: .[0], unit: .[1]}]')
fi

app_launch_json="null"
if command -v hyperfine >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]] && command -v konsole >/dev/null 2>&1; then
    hf_out="${state_dir}/.hyperfine-app-launch.json"
    if hyperfine --warmup 1 --min-runs 3 --export-json "${hf_out}" \
        'konsole -e true' >/dev/null 2>&1; then
        app_launch_json=$(jq -c '.results[0] | {mean, stddev, min, max}' "${hf_out}" 2>/dev/null || echo null)
    fi
    rm -f "${hf_out}"
fi

timestamp=$(date -Iseconds)

jq -nc \
    --arg timestamp "${timestamp}" \
    --arg bootc_ref "${bootc_ref}" \
    --arg boot_class "${boot_class}" \
    --arg boot_seconds "${boot_seconds}" \
    --argjson top_units "${top_units_json}" \
    --argjson app_launch "${app_launch_json}" \
    '{timestamp: $timestamp, bootc_ref: $bootc_ref, boot_class: $boot_class,
      boot_seconds: ($boot_seconds | tonumber), top_units: $top_units,
      app_launch: $app_launch}' >>"${log_file}"

echo "KythOS Snappy Benchmark"
echo
print_kv "Bootc Image" "${bootc_ref}"
print_kv "Boot Class" "${boot_class}"
print_kv "Boot Time" "${boot_seconds}s"
if [[ "${app_launch_json}" != "null" ]]; then
    print_kv "App Launch (mean)" "$(jq -r '.mean' <<<"${app_launch_json}")s"
else
    print_kv "App Launch" "skipped (hyperfine/konsole/session unavailable)"
fi
echo
echo "Slowest units this boot:"
head -5 <<<"${blame}"
echo
echo "Recorded to ${log_file}"
