[Unit]
Description=Kyth power arbiter (debounced EPP)
After=local-fs.target
# udev SYSTEMD_WANTS this on every power_supply change. RemainAfterExit
# must stay no so AC/BAT transitions re-run the oneshot; a high burst
# absorbs the boot-time sysfs storm without start-limit-hit.
StartLimitIntervalSec=30
StartLimitBurst=20

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-power-arbiter
RemainAfterExit=no
# Brief, debounced trigger (may fire often on power-state changes) —
# deprioritized so it never competes with the desktop session for cycles.
Nice=15
IOSchedulingClass=idle
MemoryMax=384M
PrivateTmp=yes
# PrivateUsers remaps root; future sysfs/EPP writes would then fail.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
UMask=0077