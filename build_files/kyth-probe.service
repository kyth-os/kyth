[Unit]
Description=KythOS system probe cache refresh (oneshot)
Documentation=https://github.com/mrtrick37/kyth
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-probe --system
CacheDirectory=kyth
CacheDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kyth-probe
# Read-only probes; keep impact low.
Nice=10
IOSchedulingClass=idle
CPUQuota=50%
MemoryHigh=384M
MemoryMax=512M
# bootc/flatpak can be slow on cold cache
TimeoutStartSec=120

MemoryMax=512M

[Install]
WantedBy=multi-user.target
