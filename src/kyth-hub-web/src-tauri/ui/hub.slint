import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export component HubWindow inherits Window {
    width: 1280px;
    height: 800px;
    title: "Kyth Hub";
    background: #1b1b1f;

    in-out property <string> selected-page: "Home";
    in-out property <string> status-text: "Reading system status…";
    in-out property <string> status-badge: "CHECKING";
    in-out property <string> page-summary: "Your system at a glance";
    in-out property <string> page-detail: "Native status, recovery, and performance information stays in one calm workspace.";
    in-out property <string> card-one-title: "Recovery";
    in-out property <string> card-one-value: "Ready";
    in-out property <string> card-one-detail: "Safe by default";
    in-out property <string> card-two-title: "Performance";
    in-out property <string> card-two-value: "Ready";
    in-out property <string> card-two-detail: "Ready when you are";
    in-out property <string> next-action-text: "Suggested next step · Reading local policy…";
    in-out property <string> selected-section: "Recovery";
    in-out property <string> section-status: "Reading section status…";
    in-out property <string> section-detail: "Native section status is read in the background.";
    in-out property <string> hardware-capabilities: "Capabilities · Reading hardware view…";
    in-out property <string> gaming-launchers: "Launchers · Reading gaming inventory…";
    in-out property <string> proton-query: "";
    in-out property <string> proton-results: "";
    in-out property <string> software-catalog: "Catalog · Reading software inventory…";
    in-out property <string> appstream-query: "";
    in-out property <string> appstream-results: "Search the Flatpak catalog from the native Apps surface.";
    in-out property <string> appstream-install-id: "";
    in-out property <string> appstream-install-label: "";
    in-out property <string> familiar-query: "";
    in-out property <string> familiar-results: "";
    in-out property <string> appimage-path: "";
    in-out property <string> flatpak-id: "";
    in-out property <string> feedback-title: "";
    in-out property <string> feedback-body: "";
    in-out property <string> bitlocker-device: "";
    in-out property <string> bitlocker-key: "";
    in-out property <string> smb-host: "";
    in-out property <string> smb-share: "";
    in-out property <string> guardian-status: "Guardian · Reading recommendations…";
    in-out property <string> recipes-text: "Recipes · Reading available actions…";
    in-out property <string> recovery-details: "";
    in-out property <string> recipe-name: "";
    in-out property <string> action-state: "idle";
    in-out property <string> action-id: "";
    in-out property <string> action-job-id: "";
    in-out property <string> section-one: "Recovery";
    in-out property <string> section-two: "Performance";
    in-out property <string> section-three: "Hardware";
    in-out property <string> section-four: "Diagnostics";
    in-out property <string> section-five: "";
    in-out property <string> section-six: "";
    in-out property <string> section-seven: "";
    in-out property <string> section-eight: "";
    in-out property <string> section-nine: "";
    in-out property <string> section-ten: "";
    in-out property <string> action-status: "";
    in-out property <string> section-action-id: "";
    in-out property <string> section-action-label: "";
    in-out property <bool> action-busy: false;
    callback navigate(string);
    callback refresh();
    callback select-section(string);
    callback page-action(string);
    callback section-action(string);
    callback appstream-search(string);
    callback appstream-install(string);
    callback familiar-search(string);
    callback appimage-action(string);
    callback flatpak-uninstall(string);
    callback open-feedback(string);
    callback bitlocker-unlock(string);
    callback smb-action(string);
    callback cloud-action(string);
    callback proton-lookup(string);
    callback recipe-run(string);

    Rectangle {
        background: #1b1b1f;
        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 232px;
                background: #242428;
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    Text {
                        text: "KythOS";
                        color: #f2f2f3;
                        font-size: 22px;
                        font-weight: 700;
                    }
                    Text {
                        text: "System Hub";
                        color: #a4a4aa;
                        font-size: 13px;
                    }
                    Rectangle { height: 18px; }

                    Button { text: "⌂   Home"; clicked => { selected-page = "Home"; navigate("Home"); } }
                    Button { text: "◈   Play"; clicked => { selected-page = "Play"; navigate("Play"); } }
                    Button { text: "▦   Apps"; clicked => { selected-page = "Apps"; navigate("Apps"); } }
                    Button { text: "▣   This PC"; clicked => { selected-page = "This PC"; navigate("This PC"); } }
                    Button { text: "⇄   Move In"; clicked => { selected-page = "Move In"; navigate("Move In"); } }
                    Rectangle { height: 1px; background: #3a3a40; }
                    Button { text: "↻   Updates"; clicked => { selected-page = "Updates"; navigate("Updates"); } }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "KythOS · System Hub"; color: #77777f; font-size: 11px; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                background: #1b1b1f;
                ScrollView {
                    viewport-width: self.width;
                    VerticalLayout {
                    min-width: 0px;
                    padding: 32px;
                    spacing: 16px;

                    HorizontalLayout {
                        height: 40px;
                        VerticalLayout { spacing: 2px; Text { text: selected-page; color: #f5f7ff; font-size: 28px; font-weight: 700; } Text { text: "KythOS system workspace"; color: #7183a3; font-size: 12px; } }
                        Rectangle { horizontal-stretch: 1; min-width: 0px; }
                        Button { text: "Refresh"; clicked => { refresh(); } }
                    }

                    Rectangle {
                        height: 132px;
                        min-width: 0px;
                        background: #2a2a30;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #3a3a42;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 7px;
                            HorizontalLayout { min-width: 0px; Text { text: page-summary; color: #b4b4bb; font-size: 13px; } Rectangle { horizontal-stretch: 1; min-width: 0px; } Rectangle { width: 92px; height: 22px; background: #315c51; border-radius: 11px; Text { text: status-badge; color: #d9f3eb; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } } }
                            Text { text: status-text; color: #f2f2f3; font-size: 21px; font-weight: 600; wrap: word-wrap; }
                            Text { text: page-detail; color: #a4a4aa; font-size: 12px; wrap: word-wrap; }
                        }
                    }

                    Rectangle {
                        height: 48px;
                        min-width: 0px;
                        background: #263b3a;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #385652;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;
                            Text { text: "●"; color: #55d6bd; font-size: 16px; vertical-alignment: center; }
                            Text { text: next-action-text; color: #d9f3eb; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                        }
                    }

                    HorizontalLayout {
                        visible: section-action-label != "";
                        spacing: 8px;
                        Text { text: "Suggested action"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: section-action-label; enabled: !action-busy; clicked => { section-action(section-action-id); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Updates";
                        spacing: 8px;
                        Button { text: "Refresh status"; enabled: !action-busy; clicked => { page-action("refresh-updates"); } }
                        Button { text: "Check for updates"; enabled: !action-busy; clicked => { page-action("check-updates"); } }
                        Button { text: "Download and stage"; enabled: !action-busy; clicked => { page-action("upgrade"); } }
                        Button { text: "Restart to apply"; enabled: !action-busy; clicked => { page-action("apply-staged"); } }
                        Button { text: "Roll back"; enabled: !action-busy; clicked => { page-action("rollback"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Guardian";
                        spacing: 8px;
                        Button { text: "Run pending safe repair"; enabled: !action-busy; clicked => { page-action("guardian"); } }
                        Button { text: "Health check"; enabled: !action-busy; clicked => { page-action("guardian-check"); } }
                        Button { text: "Investigate"; enabled: !action-busy; clicked => { page-action("guardian-investigate"); } }
                        Button { text: "Enable Guardian"; enabled: !action-busy; clicked => { page-action("guardian-enable"); } }
                        Button { text: "Disable Guardian"; enabled: !action-busy; clicked => { page-action("guardian-disable"); } }
                        Button { text: "Safe auto-fix on"; enabled: !action-busy; clicked => { page-action("guardian-autofix-on"); } }
                        Button { text: "Safe auto-fix off"; enabled: !action-busy; clicked => { page-action("guardian-autofix-off"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Play" && selected-section == "Gaming";
                        spacing: 8px;
                        Text { text: "Performance profile"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Gaming mode"; enabled: !action-busy; clicked => { page-action("gaming-mode"); } }
                        Button { text: "Balanced mode"; enabled: !action-busy; clicked => { page-action("balanced-mode"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Play" && selected-section == "Gaming";
                        spacing: 8px;
                        LineEdit { horizontal-stretch: 1; text <=> proton-query; placeholder-text: "Steam app IDs (e.g. 730, 570)"; }
                        Button { text: "ProtonDB lookup"; enabled: !action-busy; clicked => { proton-lookup(proton-query); } }
                        Text { text: proton-results; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Play" && selected-section == "Gaming";
                        spacing: 8px;
                        Text { text: "Launchers"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Steam"; enabled: !action-busy; clicked => { page-action("install-steam"); } }
                        Button { text: "Heroic"; enabled: !action-busy; clicked => { page-action("install-heroic"); } }
                        Button { text: "Lutris"; enabled: !action-busy; clicked => { page-action("install-lutris"); } }
                        Button { text: "Bottles"; enabled: !action-busy; clicked => { page-action("install-bottles"); } }
                        Button { text: "Prism Launcher"; enabled: !action-busy; clicked => { page-action("install-prismlauncher"); } }
                        Button { text: "Itch.io"; enabled: !action-busy; clicked => { page-action("install-itch"); } }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Play" && selected-section == "Gaming";
                        spacing: 8px;
                        Text { text: "Windows launchers"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Epic Games"; enabled: !action-busy; clicked => { page-action("install-epic-launcher"); } }
                        Button { text: "Battle.net"; enabled: !action-busy; clicked => { page-action("install-battlenet"); } }
                        Button { text: "EA App"; enabled: !action-busy; clicked => { page-action("install-ea-app"); } }
                        Button { text: "Ubisoft Connect"; enabled: !action-busy; clicked => { page-action("install-ubisoft-connect"); } }
                        Button { text: "Export Steam"; enabled: !action-busy; clicked => { page-action("export-steam-games"); } }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Play" && selected-section == "Gaming";
                        spacing: 8px;
                        Text { text: "Gaming tools"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Game boost"; enabled: !action-busy; clicked => { page-action("game-boost"); } }
                        Button { text: "Preheat shaders"; enabled: !action-busy; clicked => { page-action("preheat-shaders"); } }
                        Button { text: "OBS capture"; enabled: !action-busy; clicked => { page-action("enable-obs-capture"); } }
                        Button { text: "Install OBS"; enabled: !action-busy; clicked => { page-action("install-obs"); } }
                        Button { text: "GPU Recorder"; enabled: !action-busy; clicked => { page-action("install-gpu-screen-recorder"); } }
                        Button { text: "GOverlay"; enabled: !action-busy; clicked => { page-action("install-goverlay"); } }
                        Button { text: "MangoJuice"; enabled: !action-busy; clicked => { page-action("install-mangojuice"); } }
                        Button { text: "Install UMU"; enabled: !action-busy; clicked => { page-action("install-umu"); } }
                        Button { text: "LACT"; enabled: !action-busy; clicked => { page-action("install-lact"); } }
                        Button { text: "Piper"; enabled: !action-busy; clicked => { page-action("install-piper"); } }
                        Button { text: "Solaar"; enabled: !action-busy; clicked => { page-action("install-solaar"); } }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Play" && selected-section == "Performance";
                        spacing: 8px;
                        Text { text: "Audio profile"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Gaming audio"; enabled: !action-busy; clicked => { page-action("pipewire-gaming"); } }
                        Button { text: "Work audio"; enabled: !action-busy; clicked => { page-action("pipewire-work"); } }
                        Button { text: "Balanced audio"; enabled: !action-busy; clicked => { page-action("pipewire-balanced"); } }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Hardware";
                        spacing: 8px;
                        Text { text: "Device maintenance"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Apply firmware updates"; enabled: !action-busy; clicked => { page-action("firmware-update"); } }
                        Button { text: "Enroll Secure Boot key"; enabled: !action-busy; clicked => { page-action("enroll-secureboot"); } }
                        Button { text: "Device report"; enabled: !action-busy; clicked => { page-action("device-info"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "NVIDIA";
                        spacing: 8px;
                        Button { text: "Install NVIDIA driver"; enabled: !action-busy; clicked => { page-action("install-nvidia-driver"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Plasma Wayland";
                        spacing: 8px;
                        Button { text: "List display presets"; enabled: !action-busy; clicked => { page-action("list-presets"); } }
                        Button { text: "HDR"; enabled: !action-busy; clicked => { page-action("plasma-hdr"); } }
                        Button { text: "SDR"; enabled: !action-busy; clicked => { page-action("plasma-sdr"); } }
                        Button { text: "VRR"; enabled: !action-busy; clicked => { page-action("plasma-vrr"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Channels";
                        spacing: 8px;
                        Text { text: "Update channel"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Stable"; enabled: !action-busy; clicked => { page-action("switch-channel-stable"); } }
                        Button { text: "Testing"; enabled: !action-busy; clicked => { page-action("switch-channel-testing"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Kernel";
                        spacing: 8px;
                        Text { text: "Kernel flavor"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "CachyOS"; enabled: !action-busy; clicked => { page-action("switch-kernel-cachy"); } }
                        Button { text: "Fedora"; enabled: !action-busy; clicked => { page-action("switch-kernel-fedora"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Diagnostics";
                        spacing: 8px;
                        Button { text: "Gaming stack audit"; enabled: !action-busy; clicked => { page-action("gaming-audit"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "This PC" && selected-section == "Repair";
                        spacing: 8px;
                        Button { text: "Check suspend/resume"; enabled: !action-busy; clicked => { page-action("resume-check"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Apps" && selected-section == "Work Setup";
                        spacing: 8px;
                        Button { text: "Set up a printer"; enabled: !action-busy; clicked => { page-action("setup-printer"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Apps" && selected-section == "App Store";
                        spacing: 8px;
                        Text { text: "Developer tools"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "VS Code"; enabled: !action-busy; clicked => { page-action("install-vscode"); } }
                        Button { text: "BoxBuddy"; enabled: !action-busy; clicked => { page-action("install-boxbuddy"); } }
                        Button { text: "JetBrains Toolbox"; enabled: !action-busy; clicked => { page-action("install-jetbrains-toolbox"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Apps" && selected-section == "App Store";
                        spacing: 8px;
                        Text { text: "Starter packs"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Gaming"; enabled: !action-busy; clicked => { page-action("install-pack-gaming"); } }
                        Button { text: "Creator"; enabled: !action-busy; clicked => { page-action("install-pack-creator"); } }
                        Button { text: "Everyday"; enabled: !action-busy; clicked => { page-action("install-pack-everyday"); } }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Move In" && selected-section == "VPN";
                        spacing: 8px;
                        Text { text: "Private network"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Set up Tailscale"; enabled: !action-busy; clicked => { page-action("setup-tailscale"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        visible: selected-page == "Move In" && selected-section == "Move Files";
                        spacing: 8px;
                        Text { text: "Game saves"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                        Button { text: "Install save migration"; enabled: !action-busy; clicked => { page-action("install-ludusavi"); } }
                        Button { text: "Fix dual-boot clock"; enabled: !action-busy; clicked => { page-action("fix-dualboot-clock"); } }
                        Button { text: "Prepare Windows + Steam"; enabled: !action-busy; clicked => { page-action("setup-boot-windows-steam"); } }
                        Button { text: "Reclaim Windows space"; enabled: !action-busy; clicked => { page-action("reclaim-windows"); } }
                        Text { text: action-status; color: #9fb1d1; font-size: 12px; vertical-alignment: center; wrap: word-wrap; }
                    }

                    HorizontalLayout {
                        spacing: 14px;
                        min-width: 0px;
                        Rectangle { horizontal-stretch: 1; min-width: 0px; height: 140px; background: #26262b; border-radius: 12px; border-width: 1px; border-color: #39393f; VerticalLayout { padding: 18px; spacing: 7px; Text { text: card-one-title; color: #b4b4bb; font-size: 13px; } Text { text: card-one-value; color: #f2f2f3; font-size: 24px; font-weight: 700; wrap: word-wrap; } Text { text: card-one-detail; color: #b0b0b7; font-size: 12px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; } Text { text: "Live from the local system state"; color: #77777f; font-size: 11px; } } }
                        Rectangle { horizontal-stretch: 1; min-width: 0px; height: 140px; background: #26262b; border-radius: 12px; border-width: 1px; border-color: #39393f; VerticalLayout { padding: 18px; spacing: 7px; Text { text: card-two-title; color: #b4b4bb; font-size: 13px; } Text { text: card-two-value; color: #f2f2f3; font-size: 24px; font-weight: 700; wrap: word-wrap; } Text { text: card-two-detail; color: #b0b0b7; font-size: 12px; wrap: word-wrap; } Rectangle { vertical-stretch: 1; } Text { text: "Open the section for details and actions"; color: #77777f; font-size: 11px; } } }
                    }
                    Rectangle {
                        height: 238px;
                        min-width: 0px;
                        background: #2a2a30;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: #3a3a42;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 9px;
                            HorizontalLayout { min-width: 0px; Text { text: "Explore this workspace"; color: #f2f2f3; font-size: 15px; font-weight: 600; } Rectangle { horizontal-stretch: 1; min-width: 0px; } Text { text: selected-section; color: #74d1b8; font-size: 12px; vertical-alignment: center; } }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { horizontal-stretch: 1; text: section-one; clicked => { selected-section = section-one; select-section(section-one); } }
                                Button { horizontal-stretch: 1; text: section-two; clicked => { selected-section = section-two; select-section(section-two); } }
                                Button { horizontal-stretch: 1; text: section-three; clicked => { selected-section = section-three; select-section(section-three); } }
                                Button { horizontal-stretch: 1; text: section-four; clicked => { selected-section = section-four; select-section(section-four); } }
                                Button { horizontal-stretch: 1; text: section-five; enabled: section-five != ""; clicked => { selected-section = section-five; select-section(section-five); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button { horizontal-stretch: 1; text: section-six; enabled: section-six != ""; clicked => { selected-section = section-six; select-section(section-six); } }
                                Button { horizontal-stretch: 1; text: section-seven; enabled: section-seven != ""; clicked => { selected-section = section-seven; select-section(section-seven); } }
                                Button { horizontal-stretch: 1; text: section-eight; enabled: section-eight != ""; clicked => { selected-section = section-eight; select-section(section-eight); } }
                                Button { horizontal-stretch: 1; text: section-nine; enabled: section-nine != ""; clicked => { selected-section = section-nine; select-section(section-nine); } }
                                Button { horizontal-stretch: 1; text: section-ten; enabled: section-ten != ""; clicked => { selected-section = section-ten; select-section(section-ten); } }
                            }
                            Text { text: section-status; color: #f5f7ff; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                            Text { text: section-detail; color: #9fb1d1; font-size: 12px; wrap: word-wrap; }
                            Text { visible: selected-page == "This PC" && (selected-section == "Repair" || selected-section == "Recovery"); text: recovery-details; color: #9fb1d1; font-size: 12px; wrap: word-wrap; }
                            Text { visible: selected-page == "This PC" && selected-section == "Hardware"; text: hardware-capabilities; color: #55d6bd; font-size: 12px; wrap: word-wrap; }
                            Text { visible: selected-page == "Play" && selected-section == "Gaming"; text: gaming-launchers; color: #55d6bd; font-size: 12px; wrap: word-wrap; }
                            Text { visible: selected-page == "Apps" && selected-section == "App Store"; text: software-catalog; color: #55d6bd; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout { visible: selected-page == "Apps" && selected-section == "App Store"; spacing: 8px; LineEdit { horizontal-stretch: 1; text <=> appstream-query; placeholder-text: "Search Flatpak catalog"; } Button { text: "Search"; clicked => { appstream-search(appstream-query); } } }
                            Text { visible: selected-page == "Apps" && selected-section == "App Store"; text: appstream-results; color: #9fb1d1; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout { visible: selected-page == "Apps" && selected-section == "App Store" && appstream-install-id != ""; spacing: 8px; Button { text: appstream-install-label; enabled: !action-busy; clicked => { appstream-install(appstream-install-id); } } Text { text: "Installs for this user"; color: #60718f; font-size: 11px; vertical-alignment: center; } }
                            HorizontalLayout { visible: selected-page == "Apps" && selected-section == "App Store"; spacing: 8px; LineEdit { horizontal-stretch: 1; text <=> familiar-query; placeholder-text: "What did you use on Windows?"; } Button { text: "Find familiar app"; enabled: !action-busy; clicked => { familiar-search(familiar-query); } } }
                            Text { visible: selected-page == "Apps" && selected-section == "App Store"; text: familiar-results; color: #9fb1d1; font-size: 12px; wrap: word-wrap; }
                            Text { visible: selected-page == "This PC" && selected-section == "Guardian"; text: guardian-status; color: #55d6bd; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout { visible: selected-page == "This PC" && selected-section == "Recipes"; spacing: 8px; Button { text: "System audit"; enabled: !action-busy; clicked => { page-action("system-audit"); } } Button { text: "Update health"; enabled: !action-busy; clicked => { page-action("update-health"); } } Button { text: "Device report"; enabled: !action-busy; clicked => { page-action("device-info"); } } Button { text: "Resume check"; enabled: !action-busy; clicked => { page-action("resume-check"); } } }
                            HorizontalLayout { visible: selected-page == "This PC" && selected-section == "Recipes"; spacing: 8px; LineEdit { horizontal-stretch: 1; text <=> recipe-name; placeholder-text: "Approved parameterless recipe name"; } Button { text: "Run approved recipe"; enabled: !action-busy; clicked => { recipe-run(recipe-name); } } }
                            HorizontalLayout { visible: selected-page == "Apps" && selected-section == "App Images"; spacing: 8px; LineEdit { horizontal-stretch: 1; text <=> appimage-path; placeholder-text: "Path under Applications, .local/bin, or Downloads"; } Button { text: "Import"; enabled: !action-busy; clicked => { appimage-action("import:" + appimage-path); } } Button { text: "Make executable"; enabled: !action-busy; clicked => { appimage-action("executable:" + appimage-path); } } Button { text: "Launch"; enabled: !action-busy; clicked => { appimage-action("launch:" + appimage-path); } } }
                            HorizontalLayout { visible: selected-page == "Apps" && selected-section == "Installed apps"; spacing: 8px; LineEdit { horizontal-stretch: 1; text <=> flatpak-id; placeholder-text: "Flatpak application ID"; } Button { text: "Uninstall user app"; enabled: !action-busy; clicked => { flatpak-uninstall(flatpak-id); } } }
                            HorizontalLayout { visible: selected-page == "Move In" && selected-section == "Move Files"; spacing: 8px; LineEdit { text <=> bitlocker-device; placeholder-text: "/dev/nvme0n1p3"; } LineEdit { text <=> bitlocker-key; input-type: InputType.password; placeholder-text: "BitLocker recovery key"; } Button { text: "Unlock volume"; enabled: !action-busy; clicked => { bitlocker-unlock(bitlocker-device + "\n" + bitlocker-key); } } }
                            HorizontalLayout { visible: selected-page == "Move In" && selected-section == "Network Shares"; spacing: 8px; LineEdit { text <=> smb-host; placeholder-text: "Server (blank = discover)"; } Button { text: "Browse shares"; enabled: !action-busy; clicked => { smb-action("browse:" + smb-host); } } LineEdit { text <=> smb-share; placeholder-text: "smb://server/share"; } Button { text: "Mount share"; enabled: !action-busy; clicked => { smb-action("mount:" + smb-share); } } }
                            HorizontalLayout { visible: selected-page == "Move In" && selected-section == "Cloud Storage"; spacing: 8px; Button { text: "OneDrive OAuth"; enabled: !action-busy; clicked => { cloud-action("onedrive"); } } Button { text: "Google Drive OAuth"; enabled: !action-busy; clicked => { cloud-action("drive"); } } Button { text: "Dropbox OAuth"; enabled: !action-busy; clicked => { cloud-action("dropbox"); } } }
                            VerticalLayout { visible: selected-page == "This PC" && selected-section == "Feedback"; spacing: 8px; LineEdit { text <=> feedback-title; placeholder-text: "Report title"; } LineEdit { text <=> feedback-body; placeholder-text: "Describe what happened (logs are scrubbed before opening)"; } Button { text: "Open prefilled report"; enabled: !action-busy; clicked => { open-feedback(feedback-title + "\n" + feedback-body); } } }
                            Text { visible: selected-page == "This PC" && selected-section == "Recipes"; text: recipes-text; color: #9fb1d1; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Kyth Hub · system tools and protection checks"; color: #77777f; font-size: 12px; }
                    }
                }
            }
        }
    }
}
