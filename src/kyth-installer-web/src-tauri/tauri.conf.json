{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KythOS Installer",
  "version": "0.1.0",
  "identifier": "com.kythos.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KythOS Installer",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:7777 http://localhost:7777 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
